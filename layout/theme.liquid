    <script>
      function getCookie(cname) {
        let name = cname + '=';
        let decodedCookie = decodeURIComponent(document.cookie);
        let ca = decodedCookie.split(';');
        for (let i = 0; i < ca.length; i++) {
          let c = ca[i];
          while (c.charAt(0) == ' ') {
            c = c.substring(1);
          }
          if (c.indexOf(name) == 0) {
            return c.substring(name.length, c.length);
          }
        }
        return '';
      }

      document.addEventListener('GRFQ:Popup_Form_rendered', function () {
        const _gcl_awCookie = getCookie('_gcl_aw').split('.')
        document.querySelector('input[name="_gcl_aw"]').value = _gcl_awCookie[_gcl_awCookie.length-1];
        try{
          const contriesMap = {
            "UK":"United Kingdom",
            "DE":"Germany",
            "FR":"France",
            "IT":"Italy",
            "ES":"Spain",
            "PT":"Portugal",
            "UA":"Ukraine",
            "RO":"Romania",
            "PL":"Poland",
            "NL":"Netherlands",
            "BE":"Belgium",
            "SE":"Sweden",
            "GR":"Greece",
            "CH":"Switzerland",
            "AT":"Austria",
            "RS":"Serbia",
            "NO":"Norway",
            "US":"United States",
            "CA":"Canada",
            Other:"Other"
          }
          const country = contriesMap[{{ localization.country.iso_code | json }}];
          let countriesSelectInput =  document.querySelector('.grfq__popupForm__formInput [name="Country"]')
          if(countriesSelectInput){
            countriesSelectInput.value=country
          }
        }catch(e){
          console.error(e)
        }
      });
    </script>
