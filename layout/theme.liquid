    {%- comment -%}
      Performance optimization: Load third-party tracking scripts on user interaction
      This defers Claydar, LinkedIn, and Leadfeeder to improve LCP and TBT
    {%- endcomment -%}
    <script>
      (function() {
        var thirdPartyLoaded = false;
        function loadThirdPartyScripts() {
          if (thirdPartyLoaded) return;
          thirdPartyLoaded = true;

          // Claydar - defer load
          var claydar = document.createElement('script');
          claydar.src = 'https://static.claydar.com/init.v1.js?id=cLZFz2Xi0D';
          claydar.async = true;
          document.body.appendChild(claydar);

          // LinkedIn Insights Tag - defer load
          window._linkedin_partner_id = "5305010";
          window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
          window._linkedin_data_partner_ids.push("5305010");
          var linkedin = document.createElement('script');
          linkedin.src = 'https://snap.licdn.com/li.lms-analytics/insight.min.js';
          linkedin.async = true;
          document.body.appendChild(linkedin);

          // Leadfeeder - defer load
          window.ldfdr = window.ldfdr || function() {
            (ldfdr._q = ldfdr._q || []).push([].slice.call(arguments));
          };
          var leadfeeder = document.createElement('script');
          leadfeeder.src = 'https://sc.lfeeder.com/lftracker_v1_bElvO73QlzEaZMqj.js';
          leadfeeder.async = true;
          document.body.appendChild(leadfeeder);
        }

        // Load on user interaction or after 5 seconds
        var events = ['scroll', 'click', 'touchstart', 'mousemove', 'keydown'];
        events.forEach(function(e) {
          document.addEventListener(e, loadThirdPartyScripts, { once: true, passive: true });
        });
        setTimeout(loadThirdPartyScripts, 5000);
      })();
    </script>
