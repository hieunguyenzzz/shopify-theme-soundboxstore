    <!-- jQuery queue to prevent errors before jQuery loads -->
    <script>
      (function() {
        var queue = [];
        var jQueryReady = false;
        window.$ = window.jQuery = function(fn) {
          if (jQueryReady) return window.jQuery.apply(this, arguments);
          if (typeof fn === 'function') queue.push(fn);
          return { ready: function(f) { queue.push(f); }, on: function() {}, each: function() {}, slick: function() {} };
        };
        window.$.fn = window.jQuery.fn = {};
        document.addEventListener('DOMContentLoaded', function() {
          var checkjQuery = setInterval(function() {
            if (window.jQuery && window.jQuery.fn && window.jQuery.fn.jquery) {
              jQueryReady = true;
              clearInterval(checkjQuery);
              queue.forEach(function(fn) { try { fn(); } catch(e) {} });
            }
          }, 50);
        });
      })();
    </script>
