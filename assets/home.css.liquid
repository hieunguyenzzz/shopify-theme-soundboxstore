  -ms-transform:
    translate3d(0, 0, 0);
  -o-transform: translate3d(0, 0, 0);
  transform:
    translate3d(0, 0, 0);
  box-shadow: none !important
}

.slick-track {
  position: relative;
  top: 0;
  left: 0;
  display: block;
  margin-left: auto;
  margin-right: auto
}

.slick-track:after,
.slick-track:before {
  display: table;
  content: ""
}

