.flickity-enabled {
  position: relative
}

.flickity-enabled:focus {
  outline: 0
}

.flickity-viewport {
  overflow: hidden;
  position: relative;
  transition: height .6s;
  height: 100%
}

.flickity-slider {
  position: absolute;
  width: 100%;
  height: 100%
}

.flickity-enabled.is-draggable {
  -webkit-user-select: none;
  user-select: none
}

.flickity-enabled.is-draggable .flickity-viewport {
  cursor: move;
  cursor: grab
}

.flickity-enabled.is-fade .flickity-slider>* {
  pointer-events: none;
  z-index:
    0
}

.flickity-enabled.is-fade .flickity-slider>.is-selected {
  pointer-events:
    auto;
  z-index: 1
}

