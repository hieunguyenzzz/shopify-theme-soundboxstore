/**
 * Strict Geo-Targeting Script - Debug Mode
 * Testing AJAX geo-detection with logging only (no redirects)
 */

(function() {
  'use strict';

  console.log('[GEO] ========== Geo-Targeting Debug Started ==========');

  // Get visitor's country from Shopify's geo-location
  const visitorCountry = '{{ localization.country.iso_code }}';
  const currentLocale = '{{ request.locale.iso_code }}';
  const currentPath = window.location.pathname;
  const currentRootUrl = '{{ request.locale.root_url }}';

  console.log('[GEO-SHOPIFY] Shopify Localization Data:', {
    visitorCountry: visitorCountry,
    currentLocale: currentLocale,
    currentPath: currentPath,
    currentRootUrl: currentRootUrl,
    isEmpty: !visitorCountry || !currentLocale
  });

  // FALLBACK: If Shopify locale is empty, detect from URL
  let detectedLocale = currentLocale;
  let localeSource = 'shopify';

  if (!detectedLocale || detectedLocale === '') {
    // Try to extract from URL path
    // Match patterns: /de-de/... or /de-de
    const pathMatchWithSlash = currentPath.match(/^\/([a-z]{2}-[a-z]{2})\//);
    const pathMatchExact = currentPath.match(/^\/([a-z]{2}-[a-z]{2})$/);

    if (pathMatchWithSlash) {
      detectedLocale = pathMatchWithSlash[1];
      localeSource = 'url-path';
    } else if (pathMatchExact) {
      detectedLocale = currentPath.substring(1);
      localeSource = 'url-exact';
    } else if (currentPath === '/') {
      detectedLocale = 'en-gb';
      localeSource = 'default-root';
    } else {
      detectedLocale = 'en-gb';
      localeSource = 'default-fallback';
    }

    console.log('[GEO-FALLBACK] Shopify locale empty - detected from URL:', {
      detectedLocale: detectedLocale,
      source: localeSource,
      currentPath: currentPath
    });
  } else {
    console.log('[GEO-FALLBACK] Using Shopify locale (not empty)');
  }

  // Country to locale root URL mapping
  const countryToLocaleMap = {
    'GB': { locale: 'en-GB', rootUrl: '' },
    'IE': { locale: 'en-IE', rootUrl: '/en-ie' },
    'AE': { locale: 'en-AE', rootUrl: '/en-ae' },
    'US': { locale: 'en-US', rootUrl: '/en-us' },
    'DK': { locale: 'da-DK', rootUrl: '/da-dk' },
    'SE': { locale: 'sv-SE', rootUrl: '/sv-se' },
    'DE': { locale: 'de-DE', rootUrl: '/de-de' },
    'NO': { locale: 'no-NO', rootUrl: '/no-no' },
    'FR': { locale: 'fr-FR', rootUrl: '/fr-fr' },
    'NL': { locale: 'nl-NL', rootUrl: '/nl-nl' },
    'BE': { locale: 'nl-BE', rootUrl: '/nl-be' },
    'AT': { locale: 'de-AT', rootUrl: '/de-at' },
    'CH': { locale: 'de-CH', rootUrl: '/de-ch' },
    'ES': { locale: 'es-ES', rootUrl: '/es-es' },
    'FI': { locale: 'fi-FI', rootUrl: '/fi-fi' },
    'PL': { locale: 'pl-PL', rootUrl: '/pl-pl' },
    'IT': { locale: 'it-IT', rootUrl: '/it-it' }
  };

  // Fetch from AJAX API
  console.log('[GEO-AJAX] Fetching geo-location from API...');
  fetch('https://test.hieunguyenel2686.workers.dev/')
    .then(response => response.json())
    .then(data => {
      console.log('[GEO-AJAX] API Response:', {
        country: data.country,
        city: data.city,
        fullResponse: data
      });

      const apiCountry = data.country;

      // Compare Shopify vs API
      console.log('[GEO-COMPARE] Shopify vs API Comparison:', {
        shopifyCountry: visitorCountry,
        apiCountry: apiCountry,
        countriesMatch: visitorCountry === apiCountry,
        shopifyIsEmpty: !visitorCountry,
        apiIsReliable: !!apiCountry
      });

      // Get expected locale for API detected country
      const targetConfig = countryToLocaleMap[apiCountry] || { locale: 'en-GB', rootUrl: '' };

      console.log('[GEO-DECISION] Locale Analysis:', {
        apiCountry: apiCountry,
        shopifyLocale: currentLocale,
        detectedLocale: detectedLocale,
        localeSource: localeSource,
        expectedLocale: targetConfig.locale,
        expectedRootUrl: targetConfig.rootUrl
      });

      // Normalize for comparison (use detected locale instead of Shopify's empty one)
      const normalizedCurrent = detectedLocale.toLowerCase();
      const normalizedTarget = targetConfig.locale.toLowerCase();
      const currentLangCode = normalizedCurrent.split('-')[0];
      const targetLangCode = normalizedTarget.split('-')[0];

      console.log('[GEO-DECISION] Comparison Details:', {
        normalizedCurrent: normalizedCurrent,
        normalizedTarget: normalizedTarget,
        currentLangCode: currentLangCode,
        targetLangCode: targetLangCode,
        fullMatch: normalizedCurrent === normalizedTarget,
        langMatch: currentLangCode === targetLangCode,
        isCorrectStore: normalizedCurrent === normalizedTarget || currentLangCode === targetLangCode
      });

      // Calculate what redirect URL would be
      let pathWithoutLocale = currentPath;
      if (currentRootUrl && currentRootUrl !== '/' && currentPath.startsWith(currentRootUrl)) {
        pathWithoutLocale = currentPath.substring(currentRootUrl.length);
      }
      if (!pathWithoutLocale.startsWith('/')) {
        pathWithoutLocale = '/' + pathWithoutLocale;
      }
      const redirectUrl = (targetConfig.rootUrl + pathWithoutLocale + window.location.search).replace('//', '/');

      console.log('[GEO-SIMULATION] Redirect Simulation:', {
        wouldRedirect: !(normalizedCurrent === normalizedTarget || currentLangCode === targetLangCode),
        fromPath: currentPath,
        toPath: redirectUrl,
        pathCalculation: {
          currentPath: currentPath,
          currentRootUrl: currentRootUrl,
          pathWithoutLocale: pathWithoutLocale,
          targetRootUrl: targetConfig.rootUrl
        }
      });

      if (normalizedCurrent === normalizedTarget || currentLangCode === targetLangCode) {
        console.log('[GEO-SIMULATION] ✓ Visitor is on correct store - NO REDIRECT NEEDED');
      } else {
        console.log('[GEO-SIMULATION] ✗ Visitor is on WRONG store - WOULD REDIRECT TO:', redirectUrl);
        console.log('[GEO-SIMULATION] Reason: Visitor from', apiCountry, 'should use', targetConfig.locale, 'store');
      }

      console.log('[GEO] ========== Debug Complete (NO REDIRECTS PERFORMED) ==========');
    })
    .catch(error => {
      console.error('[GEO-AJAX] API Error:', error);
      console.log('[GEO-AJAX] Geo-targeting would be disabled due to API failure');
    });

})();
