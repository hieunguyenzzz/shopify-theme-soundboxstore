/**
 * Strict Geo-Targeting Script
 * Automatically redirects visitors to their correct regional store based on location
 */

(function() {
  'use strict';

  // Skip geo-targeting on localhost/development
  const hostname = window.location.hostname;
  if (hostname === 'localhost' || hostname === '127.0.0.1' || hostname.endsWith('.ngrok.io') || hostname.endsWith('.ngrok-free.app')) {
    console.log('[GEO] Development environment detected - geo-targeting disabled');
    return;
  }

  // Check if US visitor was already identified (prevents redirects on navigation)
  const savedCountry = sessionStorage.getItem('geo_visitor_country');
  if (savedCountry === 'US') {
    console.log('[GEO] US visitor from session - allowing free navigation to:', window.location.pathname);
    return; // Exit entire script - no redirects
  }

  // Get visitor's country from Shopify's geo-location
  const visitorCountry = '{{ localization.country.iso_code }}';
  const currentLocale = '{{ request.locale.iso_code }}';
  const currentPath = window.location.pathname;
  const currentRootUrl = '{{ request.locale.root_url }}';

  console.log('[GEO] Starting geo-targeting check for:', currentPath);

  // FALLBACK: If Shopify locale is empty, detect from URL
  let detectedLocale = currentLocale;
  let localeSource = 'shopify';

  if (!detectedLocale || detectedLocale === '') {
    // Try to extract from URL path
    // Match patterns: /de-de/... or /de-de
    const pathMatchWithSlash = currentPath.match(/^\/([a-z]{2}-[a-z]{2})\//);
    const pathMatchExact = currentPath.match(/^\/([a-z]{2}-[a-z]{2})$/);

    if (pathMatchWithSlash) {
      detectedLocale = pathMatchWithSlash[1];
      localeSource = 'url-path';
    } else if (pathMatchExact) {
      detectedLocale = currentPath.substring(1);
      localeSource = 'url-exact';
    } else if (currentPath === '/') {
      detectedLocale = 'en-gb';
      localeSource = 'default-root';
    } else {
      detectedLocale = 'en-gb';
      localeSource = 'default-fallback';
    }

  }

  // Country to locale root URL mapping
  const countryToLocaleMap = {
    'GB': { locale: 'en-GB', rootUrl: '' },
    'IE': { locale: 'en-IE', rootUrl: '/en-ie' },
    'AE': { locale: 'en-AE', rootUrl: '/en-ae' },
    'US': { locale: 'en-US', rootUrl: '/en-us' },
    'DK': { locale: 'da-DK', rootUrl: '/da-dk' },
    'SE': { locale: 'sv-SE', rootUrl: '/sv-se' },
    'DE': { locale: 'de-DE', rootUrl: '/de-de' },
    'NO': { locale: 'no-NO', rootUrl: '/no-no' },
    'FR': { locale: 'fr-FR', rootUrl: '/fr-fr' },
    'NL': { locale: 'nl-NL', rootUrl: '/nl-nl' },
    'BE': { locale: 'nl-BE', rootUrl: '/nl-be' },
    'AT': { locale: 'de-AT', rootUrl: '/de-at' },
    'CH': { locale: 'de-CH', rootUrl: '/de-ch' },
    'ES': { locale: 'es-ES', rootUrl: '/es-es' },
    'FI': { locale: 'fi-FI', rootUrl: '/fi-fi' },
    'PL': { locale: 'pl-PL', rootUrl: '/pl-pl' },
    'IT': { locale: 'it-IT', rootUrl: '/it-it' }
  };

  // Fetch from AJAX API
  fetch('https://test.hieunguyenel2686.workers.dev/')
    .then(response => response.json())
    .then(data => {
      const apiCountry = data.country;

      // Skip geo-targeting for US visitors - let them browse freely
      if (apiCountry === 'US') {
        console.log('[GEO] Skipping geo-targeting for US visitor - free navigation enabled');
        sessionStorage.setItem('geo_visitor_country', apiCountry);
        return;
      }

      // Get expected locale for API detected country
      const targetConfig = countryToLocaleMap[apiCountry] || { locale: 'en-GB', rootUrl: '' };

      // Normalize for comparison (use detected locale instead of Shopify's empty one)
      const normalizedCurrent = detectedLocale.toLowerCase();
      const normalizedTarget = targetConfig.locale.toLowerCase();
      const currentLangCode = normalizedCurrent.split('-')[0];
      const targetLangCode = normalizedTarget.split('-')[0];

      // Calculate what redirect URL would be
      // First, remove any existing locale prefix from the path
      let pathWithoutLocale = currentPath;

      // Match and remove locale patterns like /de-de or /fr-fr from start of path
      const localePattern = /^\/([a-z]{2}-[a-z]{2})(\/|$)/;
      const localeMatch = pathWithoutLocale.match(localePattern);

      if (localeMatch) {
        // Remove the locale part: /fr-fr/products → /products, or /fr-fr → /
        if (localeMatch[2] === '') {
          // Exact match like /fr-fr with no trailing content
          pathWithoutLocale = '/';
        } else {
          // Has trailing content like /fr-fr/products
          pathWithoutLocale = pathWithoutLocale.substring(localeMatch[1].length + 1);
        }
      }

      // Ensure path starts with /
      if (!pathWithoutLocale || pathWithoutLocale === '') {
        pathWithoutLocale = '/';
      } else if (!pathWithoutLocale.startsWith('/')) {
        pathWithoutLocale = '/' + pathWithoutLocale;
      }

      // Build redirect URL
      const redirectUrl = (targetConfig.rootUrl + pathWithoutLocale + window.location.search).replace('//', '/');

      if (normalizedCurrent === normalizedTarget || currentLangCode === targetLangCode) {
        console.log('[GEO] ✓ Visitor is on correct store');
        // Store the country to track if they travel
        sessionStorage.setItem('geo_visitor_country', apiCountry);
      } else {
        console.log('[GEO] ✗ Redirecting to correct store:', redirectUrl);
        // Perform the redirect
        window.location.replace(redirectUrl);
      }
    })
    .catch(error => {
      console.error('[GEO] API Error - geo-targeting disabled:', error);
    });

})();
