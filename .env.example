# Docker `theme dev` harness — copy the two keys below into .env and fill in.
# .env is git-ignored — never commit the real token.

# Store domain (no https://, no trailing slash). Example: thankyou-485.myshopify.com
SHOPIFY_STORE=thankyou-485.myshopify.com

# Theme Access app password — starts with shptka_
# Generate in Shopify admin: Apps > Theme Access > add user > copy the password.
SHOPIFY_THEME_ACCESS=shptka_xxxxxxxxxxxxxxxxxxxxxxxx
