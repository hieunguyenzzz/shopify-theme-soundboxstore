{%- comment -%}
  Cluster FAQ Schema - Dynamic FAQPage schema for topic cluster content
  Usage: {% render 'cluster-faq-schema', faqs: faq_items %}

  Parameters:
  - faqs: Array of FAQ objects with 'question' and 'answer' properties
         Can be passed as a comma-separated string or from metafields

  Example usage in article content or section:
  {% assign faq_data = article.metafields.custom.faqs.value %}
  {% render 'cluster-faq-schema', faqs: faq_data %}

  Or with inline data:
  {% assign my_faqs = '[{"question":"Q1?","answer":"A1"},{"question":"Q2?","answer":"A2"}]' %}
  {% render 'cluster-faq-schema', faqs_json: my_faqs %}
{%- endcomment -%}

{%- liquid
  assign has_faqs = false

  if faqs != blank and faqs.size > 0
    assign has_faqs = true
  elsif faqs_json != blank
    assign has_faqs = true
  endif
-%}

{%- if has_faqs -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- if faqs != blank and faqs.size > 0 -%}
      {%- for faq in faqs -%}
        {
          "@type": "Question",
          "name": {{ faq.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq.answer | strip_html | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- elsif faqs_json != blank -%}
      {{ faqs_json }}
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{%- comment -%}
  Pre-defined FAQ schema for pillar page
  This can be used when no dynamic data is provided
{%- endcomment -%}
{%- if include_pillar_faqs -%}
<script type="application/ld+json">
{
