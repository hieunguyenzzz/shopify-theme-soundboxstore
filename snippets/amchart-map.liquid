{% assign showroom_1 = metaobjects.showroom['clerkenwell-london-showroom-uk'] %}
{% assign showroom_2 = metaobjects.showroom['oliveti-group-uk'] %}
{% assign showroom_3 = metaobjects.showroom['pst-transports-services'] %}

<!-- Styles -->
<style>
  #chartdiv {
    width: 100%;
    height:100%;
    min-height:500px;
    {% comment %} aspect-ratio: 876 / 550; {% endcomment %}
    max-height: calc(100vh - 200px)
  }
</style>

<!-- HTML -->
<div class="bg-[#f8f8f8]" id="amchart-map">
  <div
    class="page-width  lg:flex "
    style="padding:0"
  >
    <div class="flex-1 relative">
      <div id="chartdiv" class="flex-1"></div>
    </div>
    <style>
      input.peer:checked + .peerchecked {
        display:flex
      }
      .peerchecked{
        animation: fade-in 1s cubic-bezier(.26, .54, .32, 1) 0s forwards;
      }
    </style>
    <div class="lg:w-2/5 text-[14px] max-w-[62ch]  lg:flex flex items-center min-h-full py-6 m-[2em] bg-white shadow relative">
      <input class="peer hidden" hidden type="radio" name="map-detail" value="map-detail-1" id="map-detail-1" checked>
      <div class="flex-1 hidden peerchecked ">
        <div
          style="
            position: absolute;
            right: 1em;
            top: 1em;
            font-size: 0.9em;
            color: white;
            padding: 0.2em 1em;
            border-radius: 99em;
            line-height: 1.5em;
            background: #fb4646;
          "
        >
          FLAGSHIP
        </div>
        <div class="mx-auto max-w-[700px] p-4 pb-8 md:flex-1 md:px-[var(--pageWidthPadding)]">
          <h3 class="text-xl font-semibold  md:text-2xl 2xl:text-3xl">{{ showroom_1.title }}</h3>
          <div class="my-4 lg:my-8 prose text-sm">
            {{ showroom_1.description | metafield_tag }}
          </div>
          <a
            class="btn bg-[var(--colorBtnPrimary)]"
            href="{{ showroom_1.system.url }}"
          >
            {{- 'strings.others.explore_now' | t -}}
          </a>
        </div>
      </div>
      <input class="peer hidden" hidden type="radio" name="map-detail" value="map-detail-2" id="map-detail-2">
      <div class="flex-1 hidden peerchecked">
        <div class="mx-auto max-w-[700px] p-4 pb-8 md:flex-1 md:px-[var(--pageWidthPadding)]">
          <h3 class="text-xl font-semibold md:text-2xl 2xl:text-3xl">{{ showroom_2.title }}</h3>
          <div class="my-4 lg:my-8 prose text-sm">
            {{ showroom_2.description | metafield_tag }}
          </div>
          <a
            class="btn  bg-[var(--colorBtnPrimary)]"
            href="{{ showroom_2.system.url }}"
            >Explore Showroom</a
          >
        </div>
      </div>
      <input class="peer hidden" hidden type="radio" name="map-detail" value="map-detail-3" id="map-detail-3">
      <div class="flex-1 hidden peerchecked">
        <div class="mx-auto max-w-[700px] p-4 pb-8 md:flex-1 md:px-[var(--pageWidthPadding)]">
          <h3 class="text-xl font-semibold  md:text-2xl 2xl:text-3xl">{{ showroom_3.title }}</h3>
          <div class="my-4 lg:my-8 prose text-sm">
            {{ showroom_3.description | metafield_tag }}
          </div>
          <a
            class="btn bg-[var(--colorBtnPrimary)]"
            href="{{ showroom_3.system.url }}"
          >
            {{- 'strings.others.explore_now' | t -}}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Resources -->
<script src="https://cdn.amcharts.com/lib/5/index.js" defer></script>
<script src="https://cdn.amcharts.com/lib/5/map.js" defer></script>
<script src="https://cdn.amcharts.com/lib/5/geodata/worldLow.js" defer></script>
<script src="https://cdn.amcharts.com/lib/5/themes/Animated.js" defer></script>

<!-- Chart code -->
<script>
  (()=>{
    let isIntersected = false
    let createMap = ()=>{
      am5.ready(function () {
         isIntersected = true
        // Create root element
        // https://www.amcharts.com/docs/v5/getting-started/#Root_element
        var root = am5.Root.new('chartdiv');

        // Set themes
        // https://www.amcharts.com/docs/v5/concepts/themes/
        root.setThemes([am5themes_Animated.new(root)]);

        // Create the map chart
        // https://www.amcharts.com/docs/v5/charts/map-chart/
        var chart = root.container.children.push(
          am5map.MapChart.new(root, {
            panX: 'rotateX',
            panY: 'translateY',
            projection: am5map.geoNaturalEarth1(),
            wheelY: 'none',
          })
        );
        chart.events.on('wheel', function (ev) {
          if (ev.originalEvent.ctrlKey) {
            ev.originalEvent.preventDefault();
            chart.set('wheelY', 'zoom');
          } else {
            chart.set('wheelY', 'none');
          }
        });
        {% comment %} var graticuleSeries = chart.series.unshift(
          am5map.GraticuleSeries.new(root, {
            step: 10
          })
        );

        graticuleSeries.mapLines.template.set("strokeOpacity", 0.05) {% endcomment %}

        var zoomControl = chart.set('zoomControl', am5map.ZoomControl.new(root, {}));
        zoomControl.homeButton.set('visible', true);

        // Create main polygon series for countries
        // https://www.amcharts.com/docs/v5/charts/map-chart/map-polygon-series/
        var polygonSeries = chart.series.push(
          am5map.MapPolygonSeries.new(root, {
            geoJSON: am5geodata_worldLow,
            exclude: ['AQ'],
          })
        );

        polygonSeries.mapPolygons.template.setAll({
          fill: am5.color(0xdadada),
          tooltipText: "{name}",
          interactive: true
        });
        (()=>{
          let pointSeries = chart.series.push(
            am5map.MapPointSeries.new(root, {})
          );

          pointSeries.pushDataItem({ polygonId: "GB", name: "United Kingdom" });
          pointSeries.pushDataItem({ polygonId: "CH", name: "Switzerland" });

          pointSeries.bullets.push(function() {
            return am5.Bullet.new(root, {
              sprite: am5.Label.new(root, {
                centerX: am5.p50,
                centerY: am5.p50,
                fontSize: 12,
                text: "{name}",
                populateText: true,
              })
            });
          });
        })()
        polygonSeries.mapPolygons.template.states.create("hover", {
          fill: am5.color(0x677935)
        });
        // Create point series for markers
        // https://www.amcharts.com/docs/v5/charts/map-chart/map-point-series/
        var pointSeries = chart.series.push(am5map.ClusteredPointSeries.new(root, {}));

        // Set clustered bullet
        // https://www.amcharts.com/docs/v5/charts/map-chart/clustered-point-series/#Group_bullet
        pointSeries.set('clusteredBullet', function (root) {
          var container = am5.Container.new(root, {
            cursorOverStyle: 'pointer',
          });

          var circle1 = container.children.push(
            am5.Circle.new(root, {
              radius: 8,
              tooltipY: 0,
              fill: am5.color(0xff8c00),
            })
          );

          var circle2 = container.children.push(
            am5.Circle.new(root, {
              radius: 12,
              fillOpacity: 0.3,
              tooltipY: 0,
              fill: am5.color(0xff8c00),
            })
          );

          var circle3 = container.children.push(
            am5.Circle.new(root, {
              radius: 16,
              fillOpacity: 0.3,
              tooltipY: 0,
              fill: am5.color(0xff8c00),
            })
          );

          var label = container.children.push(
            am5.Label.new(root, {
              centerX: am5.p50,
              centerY: am5.p50,
              fill: am5.color(0xffffff),
              populateText: true,
              fontSize: '8',
              text: '{value}',
            })
          );

          container.events.on('click', function (e) {
            pointSeries.zoomToCluster(e.target.dataItem);
          });

          return am5.Bullet.new(root, {
            sprite: container,
          });
        });

        // Set data
        var cities = [


          {% comment %} {
            title: 'Clerkenwell London Showroom, UK',
            latitude: 51.64542451964828,
            longitude: -0.09462726204477846,
            elementId: '#map-detail-1',
          },
          {
            title: 'Oliveti Group Showroom, UK',
            latitude: 52.601822994043786,
            longitude: -1.1902068539683572,
            elementId: '#map-detail-2',
          },
          {
            title: 'PST Transports & Services, Switzerland',
            latitude: 46.54455125907011,
            longitude: 6.564024839917957,
            elementId: '#map-detail-3',
          }, {% endcomment %}
        ];

        {% if showroom_1.m_latitude %}
          cities.push( {
            title: {{showroom_1.title | json}},
            latitude: Number({{showroom_1.m_latitude | json}}),
            longitude:  Number({{showroom_1.m_longitude | json}}),
            elementId: '#map-detail-1',
          })
        {% endif %}
          {% if showroom_2.m_latitude %}
          cities.push( {
            title: {{showroom_2.title | json}},
            latitude: Number({{showroom_2.m_latitude | json}}),
            longitude:  Number({{showroom_2.m_longitude | json}}),
            elementId: '#map-detail-2',
          })
        {% endif %}
          {% if showroom_3.m_latitude %}
          cities.push( {
            title: {{showroom_3.title | json}},
            latitude: Number({{showroom_3.m_latitude | json}}),
            longitude:  Number({{showroom_3.m_longitude | json}}),
            elementId: '#map-detail-3',
          })
        {% endif %}
        // Create regular bullets
        pointSeries.bullets.push(function () {
          var circle = am5.Circle.new(root, {
            cursorOverStyle: 'pointer',
            radius: 6,
            tooltipY: 0,
            fill: am5.color(0xff8c00),
            tooltipText: '{title}',
          });
          circle.events.on('click', function (ev) {

            let item = cities.find((c) => c.title === ev.target.dataItem.dataContext.title);
            if (item.elementId) {
              {% comment %} document.querySelector(item.elementId).scrollIntoView(); {% endcomment %}
              if(document.startViewTransition){
                const transition = document.startViewTransition(()=> {
                    document.querySelector(item.elementId).checked = true;
                  });
              }else{
                document.querySelector(item.elementId).checked = true;
              }

            }
          });
          return am5.Bullet.new(root, {
            sprite: circle,
          });
        });
        for (var i = 0; i < cities.length; i++) {
          var city = cities[i];
          addCity(city.longitude, city.latitude, city.title);
        }

        function addCity(longitude, latitude, title) {
          pointSeries.data.push({
            geometry: { type: 'Point', coordinates: [longitude, latitude] },
            title: title,
          });
        }

        // Make stuff animate on load
        chart.appear(1000, 100);

        polygonSeries.events.on('datavalidated', function (ev) {
          var zoomTargets = ['GB', 'CH'];
          var zoomDataItems = [];
          zoomTargets.forEach(function (id) {
            zoomDataItems.push(polygonSeries.getDataItemById(id));
          });
          polygonSeries.zoomToDataItems(zoomDataItems);
        });

      }); // end am5.ready()
    }
    const options = {
      root: document ,
      rootMargin: "0px",
      scrollMargin: "0px",
      threshold: 1.0,
    };
    const intersectionCallback = (entries) => {
      if(isIntersected) return
      entries.forEach((entry) => {
        if (entry.isIntersecting) {

          createMap()
        }
      });
    };
    const observer = new IntersectionObserver(intersectionCallback, options);
    observer.observe(document.querySelector("#amchart-map"))
  })()
</script>
