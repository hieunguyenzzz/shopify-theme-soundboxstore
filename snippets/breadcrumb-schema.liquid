{%- comment -%}
  BreadcrumbList JSON-LD schema
  Renders structured breadcrumb data for search engines and AI
{%- endcomment -%}

{%- if template.name == 'product' and product -%}
  {%- assign crumb_collection = product.metafields.custom.collections | default: product.collections.first -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ shop.url }}"
      }
      {%- if crumb_collection -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ crumb_collection.title | json }},
        "item": "{{ shop.url }}/collections/{{ crumb_collection.handle }}"
      }
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }}
      }
      {%- else -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }}
      }
      {%- endif -%}
    ]
  }
  </script>
{%- elsif template.name == 'collection' and collection -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ shop.url }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }}
      }
    ]
  }
  </script>
{%- elsif template.name == 'article' and article -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ shop.url }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ article.blog.title | json }},
        "item": "{{ shop.url }}/blogs/{{ article.blog.handle }}"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }}
      }
    ]
  }
  </script>
{%- endif -%}