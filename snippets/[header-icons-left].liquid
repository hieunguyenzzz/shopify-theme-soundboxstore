<div class=" site-nav site-nav-left">
  <div class="site-nav__icons">
    <button
      type="button"
      aria-controls="MobileNav"
      class="site-nav__link site-nav__link--icon medium-up--hide mobile-nav-trigger"
      id="mobile-nav-trigger"
    >
      
      <span class="icon__fallback-text">{{ 'general.drawers.navigation' | t }}</span>
    </button>
  </div>

  <div class="site-nav__close-cart">
    <button type="button" class="site-nav__link site-nav__link--icon js-close-header-cart">
      <span>{{ 'general.accessibility.close' | t }}</span>
      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64">
        <defs><style>.cls-1{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path class="cls-1" d="M19 17.61l27.12 27.13m0-27.13L19 44.74"/>
      </svg>
    </button>
  </div>
</div>
<script>
  var buttonMenu = document.getElementById('mobile-nav-trigger');
  var menuMobile = document.getElementById('MobileNav');
  buttonMenu.addEventListener('click', function() {
    buttonMenu.classList.toggle('is-active');
    menuMobile.classList.toggle('is-active');
    document.documentElement.classList.toggle('mobile-nav-open');
  });
</script>
