{% comment %}
  Form Tracking - Umami Implementation
  Tracks form interactions for analytics

  Events:
  - page_view: Page load with context (page_type, product/collection info)
  - checkout_start: Checkout button click with cart data
  - request_quote: Quote button click (header, cart, product page)
  - form_start: First field focus in a form
  - form_submit: Form submission with customer data
  - add_to_cart: Product added to cart

  Forms tracked:
  - Header quote form (#quote-form)
  - Cart quote form (#cart-quote-form)
  - Product page quote button (MerakiQuote popup)
  - Newsletter/subscribe forms
  - Contact forms
  - Get specs forms

  Note: MerakiQuote popup form interactions are excluded (tracked by plugin-quote)
  Only the button click (request_quote) is tracked here.

  QUOTE_SUBMIT INTERCEPTOR:
  This file includes an umami.track interceptor that:
  1. Blocks empty quote_submit events (no email = no tracking)
  2. Normalizes data schema (customer.* prefix -> flat keys)
  3. Prevents duplicate events via sessionStorage flag
  4. Injects missing attribution data (gclid, UTM params, quote_session_id)

  Umami: umami.mobelaris.com
{% endcomment %}

{% comment %} Inject page context for tracking {% endcomment %}
<script id="tracking-page-context" type="application/json">
{
  "page_type": "{% if template.name == 'product' %}product{% elsif template.name == 'collection' %}collection{% elsif template.name == 'cart' %}cart{% elsif template.name == 'index' %}homepage{% elsif template.name == 'search' %}search{% elsif template.name == 'page' %}page{% elsif template.name == 'blog' %}blog{% elsif template.name == 'article' %}article{% else %}other{% endif %}",
  {% if product %}
  "product_id": "{{ product.id }}",
  "product_handle": "{{ product.handle }}",
  "product_title": {{ product.title | json }},
  "product_type": {{ product.type | json }},
  "product_vendor": {{ product.vendor | json }},
  "product_price": {{ product.price | money_without_currency | remove: ',' }},
  {% endif %}
  {% if collection %}
  "collection_id": "{{ collection.id }}",
  "collection_handle": "{{ collection.handle }}",
  "collection_title": {{ collection.title | json }},
  {% endif %}
  "template": "{{ template.name }}"
}
</script>
<script>
(function() {
  'use strict';

  // ============================================
  // CONFIGURATION
  // ============================================

  const TRACKED_FORMS = {
    'quote-form': 'header-quote-form',
    'cart-quote-form': 'cart-quote-form',
    'contact-form': 'contact-form',
    'newsletter-form': 'newsletter-form',
    'get-specs-form': 'get-specs-form'
  };

  // Forms to exclude (MerakiQuote popup)
  function isExcludedForm(element) {
    return element.closest('[role="dialog"]') ||
           element.closest('.meraki-popup-wrapper') ||
           element.closest('[class*="meraki"]');
  }

  // Quote form IDs that should trigger generate_lead
  const QUOTE_FORM_IDS = ['header-quote-form', 'cart-quote-form', 'quote-form', 'cart-quote-form'];

  // ============================================
  // DATALAYER - Push generate_lead for GTM
  // ============================================

  function pushGenerateLead(formId, customer) {
    // Only push for quote forms
    if (!QUOTE_FORM_IDS.includes(formId) && !formId.includes('quote')) {
      return;
    }

    if (typeof window === 'undefined' || !window.dataLayer) {
      console.log('[QuoteTracking] dataLayer not available');
      return;
    }

    const attr = getAttribution();
    const formTitles = {
      'header-quote-form': 'Header Quote Form',
      'quote-form': 'Header Quote Form',
      'cart-quote-form': 'Cart Quote Form'
    };

    window.dataLayer.push({
      'event': 'generate_lead',
      'customer_email': customer.email || '',
      'customer_phone': customer.phone || '',
      'customer_country': customer.country || '',
      'customer_company': customer.company || '',
      'customer_name': [customer.first_name, customer.last_name].filter(Boolean).join(' '),
      'form_id': formId,
      'form_title': formTitles[formId] || formId,
      // Attribution data
      'gclid': attr.gclid || '',
      'utm_source': attr.utm_source || '',
      'utm_medium': attr.utm_medium || '',
      'utm_campaign': attr.utm_campaign || '',
      // Enhanced Conversions user_data
      'user_data': {
        'email': customer.email || '',
        'phone_number': customer.phone || '',
        'address': {
          'country': customer.country || '',
          'city': customer.city || ''
        }
      }
    });

    console.log('[QuoteTracking] dataLayer.push generate_lead:', formId);
  }

  // ============================================
  // UMAMI INTERCEPTION - Prevent empty quote_submit events
  // ============================================
  // Intercepts umami.track calls to ensure all quote_submit events have proper data
  // Blocks empty events and normalizes data schema

  (function interceptUmami() {
    const SUBMIT_FLAG = 'qt_quote_submit_fired';

    function waitForUmami() {
      if (typeof umami !== 'undefined' && umami.track) {
        installInterceptor();
      } else {
        setTimeout(waitForUmami, 100);
      }
    }

    function installInterceptor() {
      const originalTrack = umami.track.bind(umami);

      umami.track = function(eventName, data) {
        // Only intercept quote_submit events
        if (eventName !== 'quote_submit') {
          return originalTrack(eventName, data);
        }

        // Check deduplication flag
        try {
          if (sessionStorage.getItem(SUBMIT_FLAG) === 'true') {
            console.log('[QuoteTracking] Blocked duplicate quote_submit');
            return;
          }
        } catch (e) {}

        // Normalize data - convert customer.* prefix to flat keys
        const normalizedData = {};
        if (data && typeof data === 'object') {
          Object.keys(data).forEach(function(key) {
            const normalizedKey = key.replace(/^customer\./, '');
            normalizedData[normalizedKey] = data[key];
          });
        }

        // Ensure form_id exists
        if (!normalizedData.form_id) {
          normalizedData.form_id = 'unknown';
        }

        // Check if we have email
        const hasEmail = normalizedData.email && normalizedData.email.trim().length > 0;

        if (!hasEmail) {
          // Try to extract email from visible forms
          const emailField = document.querySelector([
            '[role="dialog"] input[type="email"]',
            '[role="dialog"] input[name*="email"]',
            '.meraki-popup-wrapper input[type="email"]',
            '#quote-form input[type="email"]',
            '#cart-quote-form input[type="email"]'
          ].join(', '));

          if (emailField && emailField.value) {
            normalizedData.email = emailField.value.trim();
          }
        }

        // Block events without email
        if (!normalizedData.email || normalizedData.email.trim().length === 0) {
          console.log('[QuoteTracking] Blocked quote_submit - no email:', normalizedData);
          return;
        }

        // Inject missing attribution data
        try {
          const attribution = JSON.parse(localStorage.getItem('qt_attribution') || '{}');
          const gclid = localStorage.getItem('_gcl_aw') || attribution.gclid || '';

          if (!normalizedData.gclid && gclid) normalizedData.gclid = gclid;
          if (!normalizedData.utm_source && attribution.utm_source) normalizedData.utm_source = attribution.utm_source;
          if (!normalizedData.utm_medium && attribution.utm_medium) normalizedData.utm_medium = attribution.utm_medium;
          if (!normalizedData.utm_campaign && attribution.utm_campaign) normalizedData.utm_campaign = attribution.utm_campaign;
          if (!normalizedData.landing_page && attribution.landing_page) normalizedData.landing_page = attribution.landing_page;
          if (!normalizedData.page_path) normalizedData.page_path = window.location.pathname;
          if (!normalizedData.quote_session_id) {
            normalizedData.quote_session_id = sessionStorage.getItem('qt_quote_session_id') || '';
          }
        } catch (e) {}

        // Mark as fired to prevent duplicates
        try {
          sessionStorage.setItem(SUBMIT_FLAG, 'true');
        } catch (e) {}

        console.log('[QuoteTracking] quote_submit passed validation:', normalizedData);

        // Send to Supabase Edge Function for lead capture
        try {
          fetch('https://nvaaqxwcjwjknpqhuahc.supabase.co/functions/v1/quote-lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              timestamp: new Date().toISOString(),
              website: 'soundboxstore',
              email: normalizedData.email || '',
              first_name: normalizedData.first_name || '',
              last_name: normalizedData.last_name || '',
              company: normalizedData.company || '',
              phone: normalizedData.phone || '',
              country: normalizedData.country || '',
              city: normalizedData.city || '',
              postcode: normalizedData.postcode || '',
              form_id: normalizedData.form_id || '',
              gclid: normalizedData.gclid || '',
              utm_source: normalizedData.utm_source || '',
              utm_medium: normalizedData.utm_medium || '',
              utm_campaign: normalizedData.utm_campaign || '',
              landing_page: normalizedData.landing_page || '',
              page_path: normalizedData.page_path || window.location.pathname,
              referrer: document.referrer || '',
              products: (Array.isArray(normalizedData.products) ? normalizedData.products : []).map(function(p) {
                return {
                  product_name: p.product_name || p.title || p.name || '',
                  sku: p.sku || '',
                  variant: p.variant || p.variant_name || p.options || '',
                  quantity: p.quantity || p.qty || 1,
                  price: p.price || ''
                };
              }),
              quote_session_id: normalizedData.quote_session_id || ''
            }),
            keepalive: true
          }).catch(function() {});
        } catch (e) {}

        return originalTrack(eventName, normalizedData);
      };

      console.log('[QuoteTracking] Umami interceptor installed');
    }

    // Start checking for umami
    waitForUmami();
  })();

  // ============================================
  // STORAGE HELPERS
  // ============================================

  const fired = {
    get: (key) => {
      try { return sessionStorage.getItem(key) === 'true'; } catch (e) { return false; }
    },
    set: (key) => {
      try { sessionStorage.setItem(key, 'true'); } catch (e) {}
    },
    clear: (key) => {
      try { sessionStorage.removeItem(key); } catch (e) {}
    }
  };

  // ============================================
  // ATTRIBUTION CAPTURE
  // ============================================

  const UTM_PARAMS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];

  function captureAttribution() {
    try {
      const params = new URLSearchParams(window.location.search);
      const gclid = params.get('gclid');
      const hasUtm = UTM_PARAMS.some(p => params.get(p));

      if (gclid || hasUtm) {
        const data = {
          gclid: gclid || '',
          utm_source: params.get('utm_source') || '',
          utm_medium: params.get('utm_medium') || '',
          utm_campaign: params.get('utm_campaign') || '',
          landing_page: window.location.pathname,
          timestamp: Date.now()
        };
        localStorage.setItem('qt_attribution', JSON.stringify(data));
      }
    } catch (e) {}
  }

  function getAttribution() {
    try {
      const stored = localStorage.getItem('qt_attribution');
      if (stored) {
        const data = JSON.parse(stored);
        // Valid for 30 days
        if (Date.now() - data.timestamp < 30 * 24 * 60 * 60 * 1000) {
          return data;
        }
      }
    } catch (e) {}
    return {};
  }

  // Capture on page load
  captureAttribution();

  // ============================================
  // PAGE CONTEXT
  // ============================================

  function getPageContext() {
    try {
      const el = document.getElementById('tracking-page-context');
      if (el) {
        return JSON.parse(el.textContent);
      }
    } catch (e) {}
    return { page_type: 'unknown', template: '' };
  }

  // ============================================
  // UMAMI TRACKING
  // ============================================

  function track(eventName, props = {}) {
    if (typeof umami === 'undefined') return;

    const attr = getAttribution();
    const data = {
      ...props,
      page_path: window.location.pathname,
      gclid: attr.gclid || '',
      utm_source: attr.utm_source || '',
      utm_medium: attr.utm_medium || '',
      utm_campaign: attr.utm_campaign || '',
      landing_page: attr.landing_page || ''
    };

    try {
      umami.track(eventName, data);
      console.log('[Tracking]', eventName, data);
    } catch (e) {}
  }

  // ============================================
  // FORM DETECTION
  // ============================================

  function getFormId(element) {
    // Check by ID first
    const form = element.closest('form');
    if (form && TRACKED_FORMS[form.id]) {
      return TRACKED_FORMS[form.id];
    }

    // Check by class/content patterns
    if (element.closest('.newsletter-form, [class*="newsletter"], [class*="subscribe"]')) {
      return 'newsletter-form';
    }
    if (element.closest('.contact-form, [class*="contact"]')) {
      return 'contact-form';
    }
    if (element.closest('[class*="get-specs"], [class*="spec"]')) {
      return 'get-specs-form';
    }

    // Check for quote forms by ID pattern
    if (form?.id?.includes('quote')) {
      return form.id;
    }

    return null;
  }

  function extractCustomerData(form) {
    const get = (selectors) => {
      for (const sel of selectors) {
        const el = form.querySelector(sel);
        if (el?.value?.trim()) return el.value.trim();
      }
      return '';
    };

    return {
      email: get(['input[type="email"]', 'input[name*="email" i]']),
      first_name: get(['input[name*="first" i]', 'input[placeholder*="First" i]']),
      last_name: get(['input[name*="last" i]', 'input[placeholder*="Last" i]']),
      company: get(['input[name*="company" i]', 'input[placeholder*="Company" i]']),
      phone: get(['input[type="tel"]', 'input[name*="phone" i]', 'input[placeholder*="Phone" i]']),
      city: get(['input[name*="city" i]', 'input[placeholder*="City" i]']),
      country: get(['select[name*="country" i]', 'input[name*="country" i]'])
    };
  }

  // ============================================
  // EVENT LISTENERS
  // ============================================

  // 1. form_start - First field focus
  document.addEventListener('focusin', function(e) {
    if (!e.target.matches('input, textarea, select')) return;
    if (isExcludedForm(e.target)) return;

    const formId = getFormId(e.target);
    if (!formId) return;

    const key = `form_start_${formId}`;
    if (fired.get(key)) return;

    fired.set(key);
    track('form_start', { form_id: formId });
  }, { capture: true });

  // 2. form_submit - Form submission (native submit event)
  document.addEventListener('submit', function(e) {
    const form = e.target;
    if (isExcludedForm(form)) return;

    const formId = getFormId(form) || form.id || 'unknown-form';
    const key = `form_submit_${formId}`;
    if (fired.get(key)) return;

    fired.set(key);
    const customer = extractCustomerData(form);

    track('form_submit', {
      form_id: formId,
      email: customer.email,
      first_name: customer.first_name,
      last_name: customer.last_name,
      company: customer.company,
      phone: customer.phone,
      city: customer.city,
      country: customer.country
    });

    // Push to dataLayer for GTM (quote forms only)
    pushGenerateLead(formId, customer);
  }, { capture: true });

  // 2b. form_submit - AJAX form submission (click on submit button)
  // Handles forms that use JavaScript/AJAX instead of native form submit
  document.addEventListener('click', function(e) {
    const btn = e.target.closest([
      '.cart-quote-btn-primary',                 // Cart quote modal submit button
      '#btn-next',                               // Cart quote next/submit button
      '.quote-form-submit',                      // Generic submit class
      'button[data-submit-quote]',               // Data attribute pattern
      '.cpb-submit-button'                       // Cart page builder submit
    ].join(', '));

    if (!btn) return;

    // Check if this looks like a final submit button (not navigation)
    const btnText = btn.textContent?.toLowerCase() || '';
    const isSubmitBtn = btnText.includes('submit') ||
                        btnText.includes('send') ||
                        btnText.includes('request quote');
    if (!isSubmitBtn) return;

    // For cart quote modal, button is outside form - find form by ID
    let form = btn.closest('form');
    if (!form && btn.closest('.cart-quote-modal, [class*="cart-quote"]')) {
      form = document.getElementById('cart-quote-form');
    }
    if (!form) return;
    if (isExcludedForm(form)) return;

    const formId = getFormId(form) || form.id || 'unknown-form';
    const key = `form_submit_${formId}`;
    if (fired.get(key)) return;

    fired.set(key);
    const customer = extractCustomerData(form);

    track('form_submit', {
      form_id: formId,
      email: customer.email,
      first_name: customer.first_name,
      last_name: customer.last_name,
      company: customer.company,
      phone: customer.phone,
      city: customer.city,
      country: customer.country
    });

    // Push to dataLayer for GTM (quote forms only)
    pushGenerateLead(formId, customer);
  }, { capture: true });

  // 3. add_to_cart - Add to cart button click (with debounce to prevent duplicates)
  let lastAddToCart = { variantId: null, timestamp: 0 };
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('button.add-to-cart, button[name="add"], [data-add-to-cart], .cpb-add-to-cart-button');
    if (!btn) return;

    const form = btn.closest('form[action*="/cart/add"]');
    const title = document.querySelector('h1.product-single__title, h1')?.textContent?.trim() || '';
    const variantId = form?.querySelector('[name="id"]')?.value || '';

    // Debounce: prevent duplicate fires within 5 seconds for same variant
    const now = Date.now();
    if (lastAddToCart.variantId === variantId && now - lastAddToCart.timestamp < 5000) {
      return;
    }
    lastAddToCart = { variantId, timestamp: now };

    track('add_to_cart', {
      item_name: title,
      item_id: variantId
    });
  }, { capture: true });

  // 4. request_quote - Quote button click (opens modal) with debounce
  let lastRequestQuote = { formId: null, timestamp: 0 };
  document.addEventListener('click', function(e) {
    const btn = e.target.closest([
      'label[for="quote-form-modal"]',
      'label[for="quote-form-modal-cart"]',
      '.cart__request-quote',
      '[data-quote-button]',
      '[id^="ProductQuoteButton-"]',
      '.product-qoute-button'
    ].join(', '));

    if (!btn) return;

    // Skip exclusion check for product page buttons (they open MerakiQuote popup)
    const isProductPageBtn = btn.matches('[id^="ProductQuoteButton-"], .product-qoute-button');
    if (!isProductPageBtn && isExcludedForm(btn)) return;

    const formId = btn.matches('[for="quote-form-modal-cart"], .cart__request-quote')
      ? 'cart-quote-form'
      : isProductPageBtn
        ? 'product-quote-form'
        : 'header-quote-form';

    // Debounce: prevent duplicate fires within 5 seconds for same form
    const now = Date.now();
    if (lastRequestQuote.formId === formId && now - lastRequestQuote.timestamp < 5000) {
      return;
    }
    lastRequestQuote = { formId, timestamp: now };

    const key = `request_quote_${formId}`;
    if (fired.get(key)) return;

    fired.set(key);
    track('request_quote', { form_id: formId });
  }, { capture: true });

  // Reset flags when modal closes
  document.addEventListener('click', function(e) {
    const closeBtn = e.target.closest('[aria-label="Close"], .close-button, label[for="quote-form-modal"], label[for="quote-form-modal-cart"]');
    if (closeBtn && e.target.closest('.quote-form-modal, .cart-quote-modal, #quote-form, #cart-quote-form')) {
      // Clear form-specific flags
      Object.values(TRACKED_FORMS).forEach(id => {
        fired.clear(`form_start_${id}`);
        fired.clear(`form_submit_${id}`);
        fired.clear(`request_quote_${id}`);
      });
    }
  });

  // 5. checkout_start - Checkout button click
  document.addEventListener('click', function(e) {
    const btn = e.target.closest([
      'button[name="checkout"]',
      'input[name="checkout"]',
      '[data-checkout-button]',
      'a[href*="/checkout"]',
      '.cart__checkout-button',
      '.cart__checkout',
      '#checkout',
      '.shopify-payment-button button'
    ].join(', '));

    if (!btn) return;

    const key = 'checkout_start';
    if (fired.get(key)) return;
    fired.set(key);

    // Get cart data from Shopify cart object or DOM
    const cartData = {
      cart_total: '',
      cart_item_count: '',
      product_ids: ''
    };

    try {
      // Try to get cart data from page
      const cartCountEl = document.querySelector('.cart-count, [data-cart-count], .cart__count');
      if (cartCountEl) {
        cartData.cart_item_count = cartCountEl.textContent.trim();
      }

      const cartTotalEl = document.querySelector('.cart__total-price, [data-cart-total], .cart-total');
      if (cartTotalEl) {
        cartData.cart_total = cartTotalEl.textContent.trim();
      }

      // Try to get product IDs from cart items
      const cartItems = document.querySelectorAll('[data-product-id], [data-variant-id]');
      const productIds = [];
      cartItems.forEach(item => {
        const id = item.dataset.productId || item.dataset.variantId;
        if (id && !productIds.includes(id)) productIds.push(id);
      });
      cartData.product_ids = productIds.join(',');
    } catch (e) {}

    track('checkout_start', cartData);
  }, { capture: true });

  // 6. page_view - Track page view with context (fires once per page)
  (function trackPageView() {
    const key = 'page_view_' + window.location.pathname;
    if (fired.get(key)) return;
    fired.set(key);

    const ctx = getPageContext();
    const props = {
      page_type: ctx.page_type || 'unknown',
      template: ctx.template || ''
    };

    // Add product context if on product page
    if (ctx.product_id) {
      props.product_id = ctx.product_id;
      props.product_handle = ctx.product_handle || '';
      props.product_title = ctx.product_title || '';
      props.product_type = ctx.product_type || '';
      props.product_vendor = ctx.product_vendor || '';
      props.product_price = ctx.product_price || '';
    }

    // Add collection context if on collection page
    if (ctx.collection_id) {
      props.collection_id = ctx.collection_id;
      props.collection_handle = ctx.collection_handle || '';
      props.collection_title = ctx.collection_title || '';
    }

    track('page_view', props);
  })();

})();
</script>
