{% comment %}
  Simple Cookie Banner
  Usage: {% render 'cookie-banner' %}
{% endcomment %}

<style>
  #simple-cookie-banner {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    z-index: 10000;
    padding: 24px 32px;
    border-radius: 4px;
    margin-bottom: 20px;
    max-width: 850px;
    width: calc(100% - 40px);
    display: none;
  }

  .cookie-banner-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    flex-wrap: wrap;
    gap: 15px;
  }

  .cookie-text {
    flex: 1;
    margin-right: 20px;
    color: #333;
  }

  .cookie-text a {
    color: #333;
    text-decoration: underline;
  }

  .cookie-buttons {
    display: flex;
    gap: 10px;
  }

  .cookie-btn {
    padding: 8px 20px;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    border-radius: 4px;
    transition: opacity 0.2s;
  }

  .cookie-btn:hover {
    opacity: 0.8;
  }

  /* Image style: Preferences (Grey), Reject (Black), Accept (Black) */
  .btn-preferences {
    background-color: #999;
    color: #000;
    border: 1px solid #777;
    background: transparent;
    border: 1px solid #000000;
    color: #000000;
  }

  .btn-reject {
    background-color: #000;
    color: #fff;
  }

  .btn-accept {
     background-color: #000;
     color: #fff;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .cookie-banner-content {
      flex-direction: column;
      align-items: flex-start;
    }
    .cookie-buttons {
      width: 100%;
      justify-content: flex-end;
    }
    .cookie-text {
      margin-right: 0;
    }
  }
</style>

<div id="simple-cookie-banner">
  <div class="cookie-banner-content">
    <div class="cookie-text">
      {{ 'general.cookie_banner.message' | t | default: "This website uses cookies to ensure you get the best experience on our website." }}
      <a href="/policies/privacy-policy">{{ 'general.cookie_banner.privacy_policy' | t | default: "Privacy Policy" }}</a>
    </div>
    <div class="cookie-buttons">
      <button id="cookie-preferences" class="cookie-btn btn-preferences">
        {{ 'general.cookie_banner.preferences' | t | default: "Preferences" }}
      </button>
      <button id="cookie-reject" class="cookie-btn btn-reject">
        {{ 'general.cookie_banner.reject' | t | default: "Reject" }}
      </button>
      <button id="cookie-accept" class="cookie-btn btn-accept">
        {{ 'general.cookie_banner.accept' | t | default: "Accept" }}
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var banner = document.getElementById('simple-cookie-banner');
    var acceptBtn = document.getElementById('cookie-accept');
    var rejectBtn = document.getElementById('cookie-reject');
    var prefBtn = document.getElementById('cookie-preferences');

    var COOKIE_NAME = 'simple_cookie_consent';
    
    function getConsent() {
      var stored = localStorage.getItem(COOKIE_NAME);
      if (stored) return stored;

      var nameEQ = COOKIE_NAME + "=";
      var ca = document.cookie.split(';');
      for(var i=0;i < ca.length;i++) {
        var c = ca[i];
        while (c.charAt(0)==' ') c = c.substring(1,c.length);
        if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
      }
      
      return null;
    }

    function setConsent(status) {
      localStorage.setItem(COOKIE_NAME, status);
      var d = new Date();
      d.setTime(d.getTime() + (365*24*60*60*1000)); 
      document.cookie = COOKIE_NAME + "=" + status + ";expires=" + d.toUTCString() + ";path=/";
      
      if(window.Shopify && window.Shopify.customerPrivacy) {
         var userCanBeTracked = (status === 'accepted');
         window.Shopify.customerPrivacy.setTrackingConsent(userCanBeTracked, function() {
            console.log('Shopify tracking consent set to: ' + userCanBeTracked);
         });
      }
    }

    if (!getConsent()) {
      if(banner) banner.style.display = 'block';
    }

    if(acceptBtn) {
      acceptBtn.addEventListener('click', function() {
        setConsent('accepted');
        if(banner) banner.style.display = 'none';
      });
    }

    if(rejectBtn) {
      rejectBtn.addEventListener('click', function() {
        setConsent('rejected');
        if(banner) banner.style.display = 'none';
      });
    }

    if(prefBtn) {
      prefBtn.addEventListener('click', function() {
         var msg = "{{ 'general.cookie_banner.preferences_coming_soon' | t | default: 'Preferences feature coming soon. For now, you can Accept or Reject all.' }}";
         alert(msg);
      });
    }

  });
</script>
