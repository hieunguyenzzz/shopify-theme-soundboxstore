{% comment %}
  Simple Cookie Banner
  Usage: {% render 'cookie-banner' %}
{% endcomment %}

<style>
  #simple-cookie-banner {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    z-index: 10000;
    padding: 24px 32px;
    border-radius: 4px;
    margin-bottom: 20px;
    max-width: 850px;
    width: calc(100% - 40px);
    display: none; /* Ẩn mặc định */
  }

  .cookie-banner-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    flex-wrap: wrap;
    gap: 15px;
  }

  .cookie-text {
    flex: 1;
    margin-right: 20px;
    color: #333;
  }

  .cookie-text a {
    color: #333;
    text-decoration: underline;
  }

  .cookie-buttons {
    display: flex;
    gap: 10px;
  }

  .cookie-btn {
    padding: 8px 20px;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    border-radius: 4px;
    transition: opacity 0.2s;
  }

  .cookie-btn:hover {
    opacity: 0.8;
  }

  /* Image style: Preferences (Grey), Reject (Black), Accept (Black) */
  .btn-preferences {
    background-color: #999;
    color: #000;
    border: 1px solid #777;
    background: transparent;
    border: 1px solid #000000;
    color: #000000;
  }

  .btn-reject {
    background-color: #000;
    color: #fff;
  }

  .btn-accept {
     background-color: #000;
     color: #fff;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .cookie-banner-content {
      flex-direction: column;
      align-items: flex-start;
    }
    .cookie-buttons {
      width: 100%;
      justify-content: flex-end;
    }
    .cookie-text {
      margin-right: 0;
    }
  }
</style>

<div id="simple-cookie-banner">
  <div class="cookie-banner-content">
    <div class="cookie-text">
      {{ 'general.cookie_banner.message' | t | default: "This website uses cookies to ensure you get the best experience on our website." }}
      <a href="/policies/privacy-policy">{{ 'general.cookie_banner.privacy_policy' | t | default: "Privacy Policy" }}</a>
    </div>
    <div class="cookie-buttons">
      <button id="cookie-preferences" class="cookie-btn btn-preferences" data-preferences-message="{{ 'general.cookie_banner.preferences_coming_soon' | t | default: 'Preferences feature coming soon. For now, you can Accept or Reject all.' }}">
        {{ 'general.cookie_banner.preferences' | t | default: "Preferences" }}
      </button>
      <button id="cookie-reject" class="cookie-btn btn-reject">
        {{ 'general.cookie_banner.reject' | t | default: "Reject" }}
      </button>
      <button id="cookie-accept" class="cookie-btn btn-accept">
        {{ 'general.cookie_banner.accept' | t | default: "Accept" }}
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    var banner = document.getElementById('simple-cookie-banner');
    var acceptBtn = document.getElementById('cookie-accept');
    var rejectBtn = document.getElementById('cookie-reject');
    var prefBtn = document.getElementById('cookie-preferences');

    // Key to store consent
    var COOKIE_NAME = 'simple_cookie_consent';
    
    // Check if user has already chosen
    function getConsent() {
      // Check localStorage first, then fallback to cookie
      var consent = localStorage.getItem(COOKIE_NAME);
      if (!consent) {
        // Fallback to cookie if localStorage is empty
        var cookies = document.cookie.split(';');
        for (var i = 0; i < cookies.length; i++) {
          var cookie = cookies[i].trim();
          if (cookie.indexOf(COOKIE_NAME + '=') === 0) {
            consent = cookie.substring(COOKIE_NAME.length + 1);
            break;
          }
        }
      }
      return consent;
    }

    function setConsent(status) {
      // Set both localStorage and cookie for maximum compatibility
      localStorage.setItem(COOKIE_NAME, status);

      // Also set a real cookie for server-side compatibility and cross-tab persistence
      var d = new Date();
      d.setTime(d.getTime() + (365*24*60*60*1000)); // 365 days
      document.cookie = COOKIE_NAME + "=" + status + ";expires=" + d.toUTCString() + ";path=/;SameSite=Lax";

      // Integrate with Shopify Customer Privacy API if needed
      if(window.Shopify && window.Shopify.customerPrivacy) {
         var userCanBeTracked = (status === 'accepted');
         window.Shopify.customerPrivacy.setTrackingConsent(userCanBeTracked, function() {
            console.log('Shopify tracking consent set to: ' + userCanBeTracked);
         });
      }

      // Hide banner immediately
      banner.style.display = 'none';
    }

    // Show banner if no consent
    var currentConsent = getConsent();

    if (!currentConsent) {
      banner.style.display = 'block';
    } else {
      banner.style.display = 'none'; // Đảm bảo ẩn nếu đã có consent
    }

    // Event Listeners
    acceptBtn.addEventListener('click', function() {
      setConsent('accepted');
      // Reload mainly to fire pixels immediately if needed
      // location.reload();
    });

    rejectBtn.addEventListener('click', function() {
      setConsent('rejected');
    });

    prefBtn.addEventListener('click', function() {
       // For simple version, treat preference as accept or just alert
       // Or you can expand this to show a modal
       var message = prefBtn.getAttribute('data-preferences-message');
       alert(message);
    });

  })();
</script>
