{% assign title = title | default: collection.title %}
{% assign description = description | default: collection.description %}
{% assign products = products | default: collection.products %}
{% assign products_count = products_count | default: collection.products_count %}
{% assign image = image | default: collection.image %}
{% style %}
  /* Mobile-first: title above image, image full-width */
  .collection-main-header-wrap .collection-main-title.mobile-only {
    display: block;
  }
  .collection-main-header-wrap .collection-main-title.desktop-only {
    display: none;
  }
  /* Mobile/tablet: image fills container width, keeps natural 3:2 ratio from CDN */
  .collection-main-header-wrap .collection-main-media {
    width: 100%;
  }
  .collection-main-header-wrap .collection-main-content .image {
    display: block;
    width: 100%;
    height: auto;
  }
  @media screen and (min-width: 1200px) {
    .collection-main-header-wrap .collection-main-content {
      margin-right: calc(50% - 50vw);
    }
    .collection-main-header-wrap .collection-main-title.mobile-only {
      display: none;
    }
    .collection-main-header-wrap .collection-main-title.desktop-only {
      display: block;
    }
    /* Desktop: image in a fixed-ratio frame with absolute positioning (original pattern) */
    .collection-main-header-wrap .collection-main-media {
      flex: 1;
      min-width: 0;
      aspect-ratio: 1.75 / 1;
      align-self: stretch;
      position: relative;
    }
    .collection-main-header-wrap .collection-main-media > div {
      position: absolute;
      inset: 0;
    }
    .collection-main-header-wrap .collection-main-media > div > div {
      height: 100%;
    }
    .collection-main-header-wrap .collection-main-content .image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
  }
{% endstyle %}
<div class="collection-main-header-wrap">
  <div class="page-width">
    <div class="collection-main-title mobile-only">{{ title | strip_html }}</div>
    <div class="collection-main-content">
      <div class="collection-main-media">
        {% render '[callout-image]', image: image, blocks: blocks %}
      </div>
      <div
        style="
               display: flex;
          align-self: stretch;
          flex-direction: column;
          justify-content: center;
        "
        class="collection-main-description"
      >
        <h1 class="collection-main-title desktop-only">{{ title | strip_html }}</h1>
        {% if description != blank %}
          <div class="[&_ul]:list-disc [&_ul]:ml-[30px]">
            {{ description | replace: '<h1>', '<h2>' | replace: '</h1>', '</h2>' | replace: '<h1 ', '<h2 ' }}
          </div>
        {% else %}
          {{ collection.description | replace: '<h1>', '<h2>' | replace: '</h1>', '</h2>' | replace: '<h1 ', '<h2 ' }}
        {% endif %}
        <div
          style="
            margin-top: 0.5em;
            margin-bottom: 0.5em;
            display: flex;
            align-items: center;
          "
          class="hero__link"
        >
          {% assign remote_tour_page = pages[settings.page_remote_tour] %}
          {% assign textR = 'strings.others.Remote_Tour' | t %}
          <a
            data-onlycity="other"
            href="{{ remote_tour_page.url }}"
            class="btn"
          >
            {{ textR }}
          </a>

          {% assign showroom_page = pages[settings.page_showroom] %}
          {% assign textF = 'call_actions.showroom_visit' | t %}
          <a
            href="{{ showroom_page.url }}"
            data-onlycity="London"
            class="btn "
          >
            {{ textF }}
          </a>

          {% assign consultancy_page = pages[settings.page_consultancy] %}
          <a
            href="{{ consultancy_page.url }}"
            class="btn"
          >
            {{ 'strings.others.Schedule_Design_Survey' | t }}
          </a>
        </div>
        <div>
          <p style="font-size:0.8em; opacity: 1;" class="delivery-message">
            {{ 'header.header_delivery_message.title' | t }}
          </p>
          <div
            class="site-nav__dropdown-menu_left-icons"
            style="display: flex; margin-top:0.5em;gap: 1em;flex-wrap: wrap;"
          >
            {% render 'iso-images' %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
