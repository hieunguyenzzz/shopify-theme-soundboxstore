{%- assign optionNameHandlized = option.name | handleize -%}
{%- assign swatch_file_extension = 'png' -%}
{% assign product_available = true %}
{%- for value in option.values -%}
  {% if optionNameHandlized != 'color' or optionNameHandlized != 'colour' or optionNameHandlized != 'Couleur' or optionNameHandlized != 'farve' or optionNameHandlized != 'Farbe' or optionNameHandlized != 'väri' or optionNameHandlized != 'dath' or optionNameHandlized != 'colore' or optionNameHandlized != 'kleur' or optionNameHandlized != 'farge' or optionNameHandlized != 'kolor' or optionNameHandlized != 'färg' %}
    {% if value.swatch %}
      {% assign isColorSwatch = true %}
      {% assign is_color = true %}
    {% endif %}
  {% endif %}
{% endfor %}

{%- assign finish_grouped = false -%}
{%- assign active_finish = 'upholstered' -%}
{%- if is_color -%}
  {%- assign has_ral = false -%}
  {%- assign has_uph = false -%}
  {%- for value in option.values -%}
    {%- if value contains 'RAL' -%}{%- assign has_ral = true -%}{%- else -%}{%- assign has_uph = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if has_ral and has_uph -%}
    {%- assign finish_grouped = true -%}
    {%- if option.selected_value contains 'RAL' -%}{%- assign active_finish = 'powder' -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}

<div
  class="variant-wrapper js {{ option.name | downcase }}-variant {% unless is_color %}option-variant {% else %} color-variant{% endunless %}{% if finish_grouped %} finish-grouped{% endif %}"
  {% if finish_grouped %}data-active-finish="{{ active_finish }}"{% endif %}
  {%- for value in option.values -%}
    {% unless value.swatch %}
      {% if option.values.size == 1 %}
        style="display:none"
        {% break %}
      {% endif %}
    {% endunless %}
  {% endfor %}
  data-type="button"
>
  <label
    class="variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}"
    for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}"
  >
    {%- assign option_label = option.name -%}
    {%- if option_label == 'External Colour' -%}{%- assign option_label = 'Colour' -%}{%- endif -%}
    {% if isColorSwatch %}
      {{ option_label }}
    {% else %}
      {%- assign tranOptionName = 'strings.option_name.' | append: optionNameHandlized | t -%}
      {%- if tranOptionName contains 'Translation missing' -%}
        {{ option_label }}
      {%- else -%}
        {{ tranOptionName }}
      {%- endif -%}
    {% endif %}

    {% comment %}
      {%- if is_color -%}
        <span class="variant__label-info">
          &mdash;
          <span data-variant-color-label data-index="{{ forloop.index0 }}" data-option-index="{{ color_option_index }}">{{ option.selected_value }}</span>
        </span>
      {%- endif -%}
    {% endcomment %}
  </label>
  {%- if finish_grouped -%}
    <div class="finish-toggle" data-finish-toggle role="tablist" aria-label="{{ option.name }} finish">
      <button type="button" class="finish-btn{% if active_finish == 'powder' %} active{% endif %}" data-finish="powder">Powder-coated</button>
      <button type="button" class="finish-btn{% if active_finish == 'upholstered' %} active{% endif %}" data-finish="upholstered">Upholstered</button>
    </div>
  {%- endif -%}
  {%- assign option_index = forloop.index -%}
  <div
    class="variant-input-wrap"
    name="{{ option.name }}"

    data-index="option{{ option_index }}"
    data-handle="{{ option.name | handleize }}"
    id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}"
  >
    {% comment %}<legend class="hide">{{ option.name }}</legend>{% endcomment %}
    {%- for value in option.values -%}
      {% if value.swatch %}
        {%- assign value_finish = '' -%}
        {%- if finish_grouped -%}
          {%- if value contains 'RAL' -%}{%- assign value_finish = 'powder' -%}{%- else -%}{%- assign value_finish = 'upholstered' -%}{%- endif -%}
        {%- endif -%}
        {% render 'swatch',
          swatch: value.swatch,
          value: value,
          option: option,
          product_available: product_available,
          section_id: section_id,
          form_id: form_id,
          option_index: option_index,
          finish: value_finish
        %}
        {% continue %}
      {% endif %}
      {% if value.swatch.image -%}
        {% assign color_image = value.swatch.image | image_url: '50x50' %}
      {% endif %}
      {% assign color_swatch_fallback = value.swatch.color | default: value %}
      {% unless color_image %}
        {% for variant in product.variants -%}
          {% if variant.option1 == value %}
            {% if variant.metafields.custom.color_image %}
              {% assign color_image = variant.metafields.custom.color_image | img_url: '50x50' %}
            {% endif %}
          {% endif %}
        {%- endfor %}
      {% endunless %}
      {%- liquid
        assign product_available = true
        if product.options.size == 1
          assign product_available = product.variants[forloop.index0].available
        endif
      -%}
      {%- assign optionValueHandlized = value | handleize -%}
      {%- assign tranValue = 'strings.option_value.' | append: optionValueHandlized | t -%}
      {% unless value == 'Upgraded Device Shelf' %}
        {% if tranValue contains 'missing' %}
          {%- assign tranValue = value -%}
        {% endif %}
      {% endunless %}
      {%- assign omni_swatch_bg = '' -%}
      {%- if value contains '#' -%}
        {%- capture omni_internal_name -%}{%- render 'omni-internal-colour-name', value: value -%}{%- endcapture -%}
        {%- assign omni_internal_name = omni_internal_name | strip -%}
        {%- if omni_internal_name != blank -%}
          {%- assign tranValue = omni_internal_name -%}
        {%- endif -%}
        {%- capture omni_swatch_bg -%}{%- render 'omni-internal-swatch-bg', value: value -%}{%- endcapture -%}
        {%- assign omni_swatch_bg = omni_swatch_bg | strip -%}
      {%- endif -%}

      <div
        class="variant-input {% unless product_available %} disabled{% endunless %}"
        data-index="option{{ option_index }}"
        data-value="{{ value | escape }}"
        data-trvalue="{{tranValue | escape}}"
      >
        <input
          type="radio"
          form="{{ form_id }}"
          {% if option.selected_value == value %}
            checked="checked"
          {% endif %}
          value="{{ value | escape }}"
          data-index="option{{ option_index }}"
          name="{{ option.name }}"
          data-variant-input
          class="{% unless product_available %} disabled{% endunless %}{% if is_color %} variant__input--color-swatch{% endif %}"
          {% if is_color %}
            data-color-name="{{ value | escape }}"
          {% endif %}
          {% if is_color %}
            data-color-index="{{ color_option_index }}"
          {% endif %}
          id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
        >
        {%- if is_color -%}
          {%- comment -%}
            Any Anja Booth product (anja-m, anja-s, anja-xl, …) loads its own
            fabric swatch images uploaded to Files as anja-<colour-handle>.png,
            so swatches stay product-specific and never affect other products.
            Matches any "anja-" handle, so new Anja sizes work with no code
            change (the dash avoids substring false positives like "banjara").
          {%- endcomment -%}
          {%- if product.handle contains 'anja-' -%}
            {%- capture en_color_handle -%}{%- render 'color-en-handle', value: value -%}{%- endcapture -%}
            {%- liquid
              assign color_file_name = 'anja-' | append: en_color_handle | append: '.' | append: swatch_file_extension
              assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
            -%}
          {%- endif -%}
          {% unless color_image %}
            {%- capture en_color_handle -%}{%- render 'color-en-handle', value: value -%}{%- endcapture -%}
            {%- liquid
              if value contains '#'
                assign color_image = null
              else
                assign color_file_name = en_color_handle | append: '.' | append: swatch_file_extension
                assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
                assign color_swatch_fallback = color_swatch_fallback | split: ' ' | last | handle
              endif
            -%}
          {% endunless %}

          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
            style="{% if omni_swatch_bg != blank %}background: {{ omni_swatch_bg }};{% else %}background-color: {{ color_swatch_fallback }};background-image: url({{ color_image }});{% if images[color_file_name] != blank %}  background-image: url({{ color_image }});{% endif %}{% endif %}"
          >
            {{ tranValue | escape }}
          </label>
          {% assign color_image = null %}

        {% elsif option.name contains 'Furniture' %}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label{% unless product_available %} disabled{% endunless %}"
          >
            {%- assign optionValueHandlized = value | handleize -%}
            {% assign labelValue = 'strings.option_value.' | append: optionValueHandlized | t | escape %}
            {% if labelValue contains 'Translation missing:' %}
              {{ value }}
            {% else %}
              {{ labelValue }}
            {% endif %}
            {%- if value == 'No Furniture' and product.metafields.my_fields.standard_suite != blank %}
              <span>{{ product.metafields.my_fields.standard_suite }}</span>
            {%- endif -%}
            {%- if value == 'With Furniture' and product.metafields.my_fields.dulux_suite != blank %}
              <span>{{ product.metafields.my_fields.dulux_suite }}</span>
            {%- endif -%}
            {%- if value == 'Furniture Set 1' and product.metafields.my_fields.furniture_set_1 != blank -%}
              <span>{{ product.metafields.my_fields.furniture_set_1 }}</span>
            {%- endif -%}
            {%- if value == 'Furniture Set 2' and product.metafields.my_fields.furniture_set_2 != blank %}
              <span>{{ product.metafields.my_fields.furniture_set_2 }}</span>
            {%- endif -%}
            {%- if value == 'Furniture Set 3' and product.metafields.my_fields.furniture_set_3 != blank %}
              <span>{{ product.metafields.my_fields.furniture_set_3 }}</span>
            {%- endif -%}
            {%- if value == 'Furniture Set 4' and product.metafields.my_fields.furniture_set_4 != blank %}
              <span>{{ product.metafields.my_fields.furniture_set_4 }}</span>
            {%- endif -%}
            {%- if value == 'Furniture Set 5' and product.metafields.my_fields.furniture_set_5 != blank %}
              <span>{{ product.metafields.my_fields.furniture_set_5 }}</span>
            {%- endif -%}
            {%- if value == 'Furniture Set 6' and product.metafields.my_fields.furniture_set_6 != blank %}
              <span>{{ product.metafields.my_fields.furniture_set_6 }}</span>
            {%- endif -%}
          </label>
        {%- else -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label{% unless product_available %} disabled{% endunless %}"
          >
            <span>{{ value }}</span>
          </label>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- if finish_grouped -%}
  <style>
    .variant-wrapper.finish-grouped { margin-bottom: 1.5rem; }
    .variant-wrapper.finish-grouped .variant-input-wrap { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .variant-wrapper.finish-grouped .finish-toggle { display: flex; gap: 0.5rem; margin: 0.2rem 0 0.8rem; }
    .variant-wrapper.finish-grouped .finish-btn {
      border: 1px solid #d9d9d2; background: #fff; padding: 8px 16px; border-radius: 8px;
      font-size: 14px; line-height: 1; cursor: pointer; font-family: inherit; color: #303a44;
    }
    .variant-wrapper.finish-grouped .finish-btn.active { background: #dfe1c4; border-color: #c9cba6; }
    .variant-wrapper.finish-grouped .variant-input[data-finish] { display: none; }
    .variant-wrapper.finish-grouped[data-active-finish="powder"] .variant-input[data-finish="powder"] { display: inline-flex; }
    .variant-wrapper.finish-grouped[data-active-finish="upholstered"] .variant-input[data-finish="upholstered"] { display: inline-flex; }
  </style>
  <script>
    (function () {
      document.querySelectorAll('.variant-wrapper.finish-grouped').forEach(function (wrap) {
        if (wrap.dataset.finishInit) return;
        wrap.dataset.finishInit = '1';
        var toggle = wrap.querySelector('[data-finish-toggle]');
        if (!toggle) return;
        toggle.addEventListener('click', function (e) {
          var btn = e.target.closest('.finish-btn');
          if (!btn) return;
          var finish = btn.getAttribute('data-finish');
          wrap.setAttribute('data-active-finish', finish);
          toggle.querySelectorAll('.finish-btn').forEach(function (b) {
            b.classList.toggle('active', b === btn);
          });
          // select the first colour in the chosen finish so the variant stays valid
          var group = wrap.querySelectorAll('.variant-input[data-finish="' + finish + '"]');
          var already = false;
          group.forEach(function (gi) { if (gi.querySelector('input:checked')) already = true; });
          if (!already && group.length) {
            var lbl = group[0].querySelector('label');
            if (lbl) lbl.click();
          }
        });
      });
    })();
  </script>
{%- endif -%}
