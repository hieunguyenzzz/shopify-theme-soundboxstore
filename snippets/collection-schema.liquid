{%- comment -%}
  Collection ItemList + BreadcrumbList JSON-LD.
  ItemList lists up to 20 products for rich-result eligibility.
  BreadcrumbList adds sitelinks breadcrumb signal independently of Yoast.

  Usage: {%- render 'collection-schema', collection: collection -%}
{%- endcomment -%}
{%- if collection != blank -%}
  {%- assign coll_url = shop.url | append: collection.url -%}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"ItemList",
  "@id":{{ coll_url | append: '#/schema/ItemList' | json }},
  "name":{{ collection.title | json }},
  "url":{{ coll_url | json }},
  "numberOfItems":{{ collection.products_count }},
  "itemListElement":[
    {%- for p in collection.products limit: 20 -%}
    {"@type":"ListItem","position":{{ forloop.index }},"url":{{ shop.url | append: p.url | json }},"name":{{ p.title | json }}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},
    {"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ coll_url | json }}}
  ]
}
</script>
{%- endif -%}
