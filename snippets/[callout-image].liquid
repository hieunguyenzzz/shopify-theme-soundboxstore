<style>
    .callout-image-point{
      font-size:min(0.8em,3vw);
      position:relative;
      cursor:pointer;transform:scale(1.4)
    }
  .callout-image-point-wrap .callout-image-point-detail{
    display:none;position:absolute;
           width:240px;
              background:white;
                    border: 1px solid #cccccc;
                  max-width:min(320px,40vw);
                border-radius:0.3em;
  }
  .callout-image-point-wrap:focus .callout-image-point-detail,  .callout-image-point-wrap:focus-within .callout-image-point-detail{
     display:block
  }
  .callout-image-point:focus+div{
    display:block
  }

    .callout-image-point:after,
    .callout-image-point:before {
      width: 1em;
      height:1em;
      background: #54c63a;
      border-radius: 99em;
      position: absolute;
      left: 0;
      top: 0;
      content: "";
    }

    .callout-image-point:before {

      animation: inventory-pulse 2s linear infinite;
      display: block;
      position: relative;
    }
</style>
{% capture image %}
  {% if image %}
      {{ image | image_url: width: 980, height: 653 | image_tag: class: 'image', preload: true }}
    {% else %}
    {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}
{% endcapture %}
<div>
  <div style="position:relative;width:100%">
    {{ image }}
    <div style="position:absolute; inset:0; width:100%;height:100%;">
      <ul>
        {% for point in blocks %}
          <li
            class="callout-image-point-wrap"
            style="position:absolute;left:{{ point.settings.horizontal }}%;top:{{ point.settings.vertical }}%;transform: translate(-50%, -50%);"
          >
            <button
              style="anchor-name: --anchor_{{ forloop.index }};"
              id="anchor_{{ forloop.index }}"
              popovertarget="popover_{{ forloop.index }}"
              class="callout-image-point"
            >
              <div
                style="
                  position: absolute;
                  inset: 0;
                  width: 100%;
                  height: 100%;
                  font-size:0.8em;
                  z-index: 1;
                  display: flex;
                  justify-content: center;
                  align-items: center;
                  font-weight: 600;
                  color: white;
                "
              >
                <!-- {{- forloop.index -}} -->
              </div>
            </button>
            <div
              class="callout-image-point-detail"
              tabindex="0"
              style="
                position-anchor: --anchor_{{ forloop.index }};
                {% if  point.settings.horizontal >50  %}
                 {% if point.settings.vertical > 50 %}
                       position-area: top left;
                     {% else %}
                      position-area: bottom left;

                 {% endif %}
                  {% else %}
                   {% if point.settings.vertical > 50 %}
                      position-area: top right;
                     {% else %}
                      position-area: bottom right;
                 {% endif %}
                {% endif %}
                 margin:0
              "
              id="popover_{{ forloop.index }}"

              {% assign product = point.settings.product %}
            >
              <a
                href="{{ product.url }}"
                style="
                  display: flex;
                  align-items: center;
                "
              >
                {% assign img = product.selected_or_first_available_variant.image | default: product.featured_image %}
                {{ img | image_url: width: 100 | image_tag: preload: true, style: 'width:33%' }}
                <div style="font-size: min(16px,3.4vw);padding:1em">
                  {{ product.title }}
                </div>
              </a>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>
