{% assign title = title | default: collection.title %}
{% assign description = description | default: collection.description %}
{% assign products = products | default: collection.products %}
{% assign products_count = products_count | default: collection.products_count %}
{% assign image = image | default: collection.image %}
<div class="collection-main-header-wrap">
  <header class="page-width">  
    <div class="collection-main-title mobile-only">{{ title | strip_html }}</div>
    <div class="collection-main-content">
      {{ image | image_url: width: 980, height: 653 | image_tag: class: 'image', preload: true }}
      <div
        style="
               display: flex;
          align-self: stretch;
          flex-direction: column;
          justify-content: center;
        "
        class="collection-main-description"
      >
        <h1 class="collection-main-title desktop-only">{{ title | strip_html }}</h1>
        {% if description != blank %}
          <div class="[&_ul]:list-disc [&_ul]:ml-[30px]">
            {{ description }}
          </div>
        {% else %}
          {{ collection.description }}
        {% endif %}
        <div
          style="
            margin-top: 0.5em;
            margin-bottom: 0.5em;
            display: flex;
            align-items: center;
          "
          class="hero__link"
        >
          {% assign remote_tour_page = pages[settings.page_remote_tour] %}
          <a
            data-onlycity="other"
            href="{{ remote_tour_page.url }}"
            class="btn"
          >
            {{ remote_tour_page.title }}
          </a>
          
          {% assign showroom_page = pages[settings.page_showroom] %}
          <a
            href="{{ showroom_page.url }}"
            data-onlycity="London"
            class="btn "
          >
            {{ 'call_actions.showroom_visit' | t }}
          </a>
          
          {% assign consultancy_page = pages[settings.page_consultancy] %}
          <a
            href="{{ consultancy_page.url }}"
            class="btn"
          >
            {{ 'strings.others.Schedule_Design_Survey' | t }}
          </a>
        </div>
        <div>
          <p style="font-size:0.8em" class="delivery-message">{{ settings.header_delivery_message }}</p>
          <div
            class="site-nav__dropdown-menu_left-icons"
            style="display: flex; margin-top:0.5em;gap: 1em;flex-wrap: wrap;"
          >
            {% render 'iso-images' %}
          </div>
        </div>
      </div>
    </div>
  </header>
</div>
