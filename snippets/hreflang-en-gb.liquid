{%- liquid
  assign _seo_noindex = false
  if request.page_type == 'cart' or request.page_type == 'search'
    assign _seo_noindex = true
  elsif request.page_type contains 'customers/'
    assign _seo_noindex = true
  elsif template.name == 'collection'
    if current_tags
      assign _seo_noindex = true
    else
      assign _noindex_handles = 'reseller-only,redesign-test-collection,menu-booths-redesign,menu-booths,accessories-test-only,all-for-reseller,globofilter-best-selling-products-index' | split: ','
      if _noindex_handles contains collection.handle
        assign _seo_noindex = true
      endif
    endif
  endif
-%}
{%- if _seo_noindex -%}
<meta name="robots" content="noindex, nofollow">
{%- endif -%}
{%- comment -%}
  Inject en-GB hreflang on ALL pages.
  Yoast SEO outputs 39 locale alternates (x-default, en, and all market locales) but
  omits en-GB because the UK is the default market (no URL prefix). Without this tag on
  every locale page the hreflang mesh is non-reciprocal.
  Uses routes.root_url (blank = primary/en-GB, non-blank = secondary market) so new
  markets are handled automatically without updating a hardcoded list.
  Suppressed on ?variant= URLs and 404 pages.
{%- endcomment -%}
{%- unless request.query_string contains 'variant' -%}
  {%- unless template.name == '404' -%}
    {%- assign _hf_root = routes.root_url | rstrip: '/' -%}
    {%- if _hf_root == blank -%}
      {%- comment -%}Primary locale (en-GB): use canonical URL directly{%- endcomment -%}
      {%- assign _hf_en_gb_url = canonical_url | split: '?' | first -%}
    {%- else -%}
      {%- comment -%}Secondary locale: strip market prefix to get primary-locale path{%- endcomment -%}
      {%- assign _hf_canon_path = canonical_url | split: '?' | first | remove: shop.url -%}
      {%- assign _hf_en_gb_path = _hf_canon_path | remove_first: _hf_root -%}
      {%- if _hf_en_gb_path == blank -%}
        {%- assign _hf_en_gb_path = '/' -%}
      {%- endif -%}
      {%- assign _hf_en_gb_url = shop.url | append: _hf_en_gb_path -%}
    {%- endif -%}
    <link rel="alternate" hreflang="en-GB" href="{{ _hf_en_gb_url }}">
  {%- endunless -%}
{%- endunless -%}
