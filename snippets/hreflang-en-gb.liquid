{%- comment -%}
  Inject en-GB hreflang for UK market on ALL pages (default and secondary locales).
  Shopify does not auto-emit en-GB because the UK is served by the default market
  (no URL prefix). Without this tag on every locale page, the hreflang mesh is
  non-reciprocal: secondary locale pages never link back to the en-GB URL.
  Suppressed on ?variant= URLs to avoid conflicts with Shopify's native hreflang output.
{%- endcomment -%}
{%- unless request.query_string contains 'variant' -%}
  {%- assign _hf_secondary = 'en-us,en-ae,en-at,en-be,en-ch,en-de,en-dk,en-es,en-fr,en-ie,en-it,en-nl,en-no,en-pl,en-se,de-de,de-at,de-ch,de-ae,es-es,es-ae,fr-fr,fr-be,fr-ae,it-it,it-ae,nl-nl,nl-be,nl-ae,no-no,no-ae,fi-fi,fi-ae,pl-pl,pl-ae' -%}
  {%- assign _hf_path = request.path -%}
  {%- assign _hf_prefix = _hf_path | remove_first: '/' | split: '/' | first | downcase -%}
  {%- assign _hf_check = ',' | append: _hf_secondary | append: ',' -%}
  {%- assign _hf_needle = ',' | append: _hf_prefix | append: ',' -%}
  {%- if _hf_check contains _hf_needle -%}
    {%- assign _hf_parts = _hf_path | remove_first: '/' | split: '/' -%}
    {%- assign _hf_en_gb_path = '' -%}
    {%- for _part in _hf_parts -%}
      {%- unless forloop.first -%}
        {%- assign _hf_en_gb_path = _hf_en_gb_path | append: '/' | append: _part -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if _hf_en_gb_path == blank -%}{%- assign _hf_en_gb_path = '/' -%}{%- endif -%}
    {%- assign _hf_en_gb_url = shop.url | append: _hf_en_gb_path -%}
  {%- else -%}
    {%- assign _hf_en_gb_url = canonical_url | split: '?' | first -%}
  {%- endif -%}
  <link rel="alternate" hreflang="en-GB" href="{{ _hf_en_gb_url }}">
{%- endunless -%}
