{%- assign rounded_price = price | divided_by: 100.0 | round | times: 100 -%}
{%- assign formatted_price = rounded_price | money_without_trailing_zeros -%}

<span aria-hidden="true" class="price-text"
  ><span class="text-total hide">Total</span><span>{{ formatted_price | replace: 'Dhs', 'AED' }}</span></span
>
<span class="visually-hidden">{{ rounded_price | money }}</span>
