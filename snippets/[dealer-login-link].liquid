{%- assign isResserllerOrTradeAccount = false -%}
{%- if customer -%}
  {%- if customer.metafields['custom-register'].trade_account_type == 'credit' -%}
    {%- if customer.metafields['custom-register'].trade_account_status == '1' -%}
      {%- assign isResserllerOrTradeAccount = true -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- if customer.tags contains 'trader' -%}
  {%- assign isResserllerOrTradeAccount = true -%}
{%- endif -%}
{%- if isResserllerOrTradeAccount -%}
  <a href="{{ pages['reseller-home'].url }}">{{ 'strings.announcement.the_vault' | t }}</a>
{%- else -%}
  {%- liquid
  if routes.root_url == '/'
    assign sbs_reseller_url = '/pages/reseller-login'
  else
    assign sbs_reseller_url = routes.root_url | append: '/pages/reseller-login'
  endif
-%}
<a href="{{ sbs_reseller_url }}">{{ 'strings.announcement.dealer_login' | t }}</a>
{%- endif -%}
