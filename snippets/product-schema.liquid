{%- comment -%}
  Product JSON-LD — emits Product + BreadcrumbList on every product page.
  Runs independently of Yoast SEO so rich-result eligibility is not gated
  on Yoast settings. Renders once regardless of how many sections are on
  the page.

  Usage: {%- render 'product-schema', product: product -%}
{%- endcomment -%}
{%- liquid
  assign prod_url   = shop.url | append: product.url
  assign variant    = product.selected_or_first_available_variant
  assign prod_price = variant.price | divided_by: 100.0
  assign prod_curr  = shop.currency
  assign prod_avail = 'https://schema.org/InStock'
  unless product.available
    assign prod_avail = 'https://schema.org/OutOfStock'
  endunless
  assign offer_year  = 'now' | date: '%Y'
  assign offer_valid = offer_year | append: '-12-31'
-%}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Product",
  "@id":{{ prod_url | append: '/#/schema/Product' | json }},
  "name":{{ product.title | json }},
  "description":{{ product.description | strip_html | truncate: 500 | json }},
  "image":[
    {%- for img in product.images limit: 5 -%}
      {{ img | image_url: width: 800 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "sku":{{ variant.sku | default: product.id | json }},
  "brand":{"@type":"Brand","name":"SoundBoxStore"},
  "offers":{
    "@type":"Offer",
    "price":{{ prod_price }},
    "priceCurrency":{{ prod_curr | json }},
    "availability":{{ prod_avail | json }},
    "itemCondition":"https://schema.org/NewCondition",
    "priceValidUntil":{{ offer_valid | json }},
    "url":{{ prod_url | json }},
    "seller":{"@type":"Organization","name":"SoundBoxStore","url":{{ shop.url | json }}}
  }
  {%- if product.metafields.reviews.rating != blank and product.metafields.reviews.rating_count != blank -%}
  ,"aggregateRating":{
    "@type":"AggregateRating",
    "ratingValue":{{ product.metafields.reviews.rating | json }},
    "reviewCount":{{ product.metafields.reviews.rating_count | json }},
    "bestRating":"5",
    "worstRating":"1"
  }
  {%- endif -%}
}
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}}
    {%- if collection != blank -%}
    ,{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ shop.url | append: collection.url | json }}}
    ,{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ prod_url | json }}}
    {%- else -%}
    ,{"@type":"ListItem","position":2,"name":{{ product.title | json }},"item":{{ prod_url | json }}}
    {%- endif -%}
  ]
}
</script>
