{%- comment -%}
  Product JSON-LD — single source of truth for Product structured data.
  Emits the Product node on every product page. Runs independently of Yoast
  SEO so rich-result eligibility is not gated on Yoast settings.
  Renders once regardless of how many sections are on the page.

  BreadcrumbList is emitted separately by snippets/breadcrumb-schema.liquid
  (rendered globally from layout/theme.liquid) to avoid duplicate breadcrumb
  nodes on the page (SBS-296).

  Consolidated here in SBS-292 (previously duplicated by the Yoast-managed
  snippets/product-template-variables.liquid).

  Usage: {%- render 'product-schema', product: product -%}
{%- endcomment -%}
{%- liquid
  assign prod_url    = shop.url | append: product.url
  assign variant     = product.selected_or_first_available_variant
  assign prod_curr   = cart.currency.iso_code | default: shop.currency
  assign prod_brand  = product.vendor | default: 'SoundBoxStore'
  assign offer_year  = 'now' | date: '%Y'
  assign offer_valid = offer_year | append: '-12-31'
  comment
    Shipping + returns mirror the published storefront terms in
    sections/toolbar.liquid ("FREE UK / EUROPEAN DELIVERY" and
    "30-day postage paid returns"). Country follows the shopper's
    market via localization; GB is the fallback (primary market).
    Change these three values here if the published policy changes.
  endcomment
  assign ship_country = localization.country.iso_code | default: 'GB'
  assign ship_rate    = 0
  assign return_days  = 30
  assign gtin_key    = 'gtin'
  assign has_barcode = false
  assign valid_gtin  = false
  if variant.barcode != blank
    assign has_barcode = true
    assign barcode_len = variant.barcode | size
    if barcode_len == 8 or barcode_len == 12 or barcode_len == 13 or barcode_len == 14
      assign valid_gtin = true
      assign gtin_key = gtin_key | append: barcode_len
    endif
  endif
-%}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Product",
  "@id":{{ prod_url | append: '/#/schema/Product' | json }},
  "name":{{ product.title | json }},
  {%- comment -%} US market: adapt allowlisted Folio schema description to US electrical/compliance wording. {%- endcomment -%}
  {%- capture _schema_desc -%}
    {%- render 'us-product-copy', content: product.description, product: product -%}
  {%- endcapture -%}
  "description":{{ _schema_desc | strip_html | truncate: 500 | json }},
  "image":[
    {%- for img in product.images limit: 5 -%}
      {{ img | image_url: width: 800 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "sku":{{ variant.sku | default: product.id | json }},
  {%- if has_barcode and valid_gtin -%}
  "{{ gtin_key }}":{{ variant.barcode | json }},
  {%- elsif has_barcode -%}
  "mpn":{{ variant.barcode | json }},
  {%- elsif variant.sku != blank -%}
  "mpn":{{ variant.sku | json }},
  {%- endif -%}
  "brand":{"@type":"Brand","name":{{ prod_brand | json }}},
  "offers":[
    {%- for v in product.variants -%}
    {
      "@type":"Offer",
      {%- if v.sku != blank -%}"sku":{{ v.sku | json }},{%- endif -%}
      "price":{{ v.price | divided_by: 100.0 }},
      "priceCurrency":{{ prod_curr | json }},
      "availability":"https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition":"https://schema.org/NewCondition",
      "priceValidUntil":{{ offer_valid | json }},
      "url":{{ shop.url | append: v.url | json }},
      "seller":{"@type":"Organization","name":"SoundBoxStore","url":{{ shop.url | json }}},
      "shippingDetails":{
        "@type":"OfferShippingDetails",
        "shippingRate":{"@type":"MonetaryAmount","value":{{ ship_rate }},"currency":{{ prod_curr | json }}},
        "shippingDestination":{"@type":"DefinedRegion","addressCountry":{{ ship_country | json }}}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  ,"hasMerchantReturnPolicy":{
    "@type":"MerchantReturnPolicy",
    "applicableCountry":{{ ship_country | json }},
    "returnPolicyCategory":"https://schema.org/MerchantReturnFiniteReturnWindow",
    "merchantReturnDays":{{ return_days }},
    "returnMethod":"https://schema.org/ReturnByMail",
    "returnFees":"https://schema.org/FreeReturn"
  }
  {%- assign product_rating_number = product.metafields.reviews.rating.value.rating | plus: 0 -%}
  {%- assign product_rating_count  = product.metafields.reviews.rating_count.value -%}
  {%- if product_rating_number > 0 and product_rating_number <= 5 and product_rating_count != blank -%}
  ,"aggregateRating":{
    "@type":"AggregateRating",
    "ratingValue":{{ product_rating_number }},
    "reviewCount":{{ product_rating_count | times: 1 }},
    "bestRating":{{ product.metafields.reviews.rating.value.scale_max | default: 5 }},
    "worstRating":{{ product.metafields.reviews.rating.value.scale_min | default: 1 }}
  }
  {%- endif -%}
}
</script>
