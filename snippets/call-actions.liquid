<script>
    $(window).on('load', function() {
      $("#shopify-section-{{section.id}} .flexbox").slick({
    slidesToShow: 1,
    slidesToScroll: 1,
    mobileFirst: true,
    arrows: false,
    autoplay: true,
    dots: false,
    responsive: [
      {
        breakpoint: 862,
        settings: "unslick",
      },

    ],
  });
  })
</script>
