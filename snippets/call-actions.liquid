{% unless sectionid %}
  {% assign sectionid = section.id %}
{% endunless %}
<style>
   #shopify-section-{{sectionid}}{
     margin-top:0;
   }
     #shopify-section-{{sectionid}} p{
     margin:0;
   }
  #shopify-section-{{sectionid}}  .product-icon-text-section .flexbox .shopify-block{
    flex:1;
  }
   #shopify-section-{{sectionid}}  .slick-track{
    width:100%
  }
  #shopify-section-{{sectionid}}  .product-icon-text-section .flexbox .col .icon-text-block .icon-wrap {
    max-width: 70px;
    height: 70px;    margin-right: 1em;
  }
   #shopify-section-{{sectionid}} .product-icon-text-section .page-width{
    max-width:1024px;
  }
  .product-icon-text-section .text-block{
    white-space:nowrap
  }
  .product-icon-text-section .flexbox{
    justify-content:center;

  }
  .product-icon-text-section .icon-text-block {
     gap:12px
    }
     .product-icon-text-section .icon-text-block .col{
      flex:unset
    }
    .product-icon-text-section .flexbox >.col{
       max-width: 350px;
    }
  @media screen and (max-width: 860px) {
      .product-icon-text-section-{{sectionid}} .col:not(:first-child){
    display:none
  }
   .product-icon-text-section-{{sectionid}} .slick-initialized.slick-slider .col{
    display:unset
  }
  }
    @media screen and (min-width: 1440) {
      .product-icon-text-section .page-width{
    max-width:unset;
    display:flex;
    overflow:auto;
  }
  .product-icon-text-section .text-block{
    white-space:nowrap
  }
  .product-icon-text-section .flexbox{
    justify-content:center;flex-shrink: 0;min-width:100%

  }
  }
</style>
<section class="product-icon-text-section product-icon-text-section-{{sectionid}}" id="shopify-section-{{sectionid}}">
  <div class="page-width">
    <div class="flexbox">
      <div class="shopify-block block-showroom-london">
        <div class="col">
          <a href="/pages/showroom-london" class="col-wrap">
            <div class="icon-text-block">
              <div class="icon-block">
                <div class="icon-wrap">
                  <img
                    loading="lazy"
                    src="//soundboxstore.com/cdn/shop/files/image_55b1406b-fd1e-4d6a-93cd-f490a35c4e3c.png?v=1737104385&amp;width=100"
                    width="80"
                    height="80"
                    alt=""
                  >
                </div>
              </div>

              <div>
                <div class="" style="position:relative">
                  <p>{{ 'call_actions.showroom_visit' | t }}</p>
                  <span
                    style="
                        margin-right: 0;
                      position: absolute;
                      top: -0.03em;
                      left: -1.4em;
                    "
                    class="icon icon--inventory"
                  ></span>
                </div>
                <div style="font-size:0.8em ;  text-underline-offset:0.3em;    text-decoration: underline;  opacity: 0.7;">
                  {{ 'call_actions.Speak_to_Eva' | t }}
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
      <div class="shopify-block block-consultancy">
        <div class="col">
          <a href="/pages/consultancy" class="col-wrap">
            <div class="icon-text-block">
              <div class="icon-block">
                <div class="icon-wrap">
                  <img
                    loading="lazy"
                    src="//soundboxstore.com/cdn/shop/files/image_1.png?v=1737104618&amp;width=100"
                    width="80"
                    height="80"
                    alt=""
                  >
                </div>
              </div>

              <div>
                <div class="" style="position:relative">
                  <p>{{ 'call_actions.site_survey' | t }}</p>
                  <span
                    style="
                        margin-right: 0;
                       position: absolute;
                       top: -0.03em;
                      left: -1.4em;
                    "
                    class="icon icon--inventory"
                  ></span>
                </div>
                <div style="font-size:0.8em ;  text-underline-offset:0.3em;    text-decoration: underline;  opacity: 0.7;">
                  {{ 'call_actions.Speak_to_Katy' | t }}
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
      <div class="shopify-block block-remote-tours">
        <div class="col">
          <a href="/pages/remote-tours" class="col-wrap">
            <div class="icon-text-block">
              <div class="icon-block">
                <div class="icon-wrap">
                  <img
                    loading="lazy"
                    src="//soundboxstore.com/cdn/shop/files/IMMIE.png?v=1737100919&amp;width=100"
                    width="80"
                    height="80"
                    alt=""
                  >
                </div>
              </div>

              <div>
                <div class="" style="position:relative">
                  <p>{{ 'call_actions.REMOTE_TOUR' | t }}</p>
                  <span
                    style="
                       margin-right: 0;
                       position: absolute;
                       top: -0.03em;
                      left: -1.4em;
                    "
                    class="icon icon--inventory"
                  ></span>
                </div>
                <div style="font-size:0.8em ;  text-underline-offset:0.3em;    text-decoration: underline;  opacity: 0.7;">
                  {{ 'call_actions.Speak_to_Immie' | t }}
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
    $(window).on('load', function() {
      $("#shopify-section-{{sectionid}} .flexbox").slick({
    slidesToShow: 1,
    slidesToScroll: 1,
    mobileFirst: true,
    arrows: false,
    autoplay: true,
    dots: false,
    responsive: [
            {
        breakpoint: 862,
        settings: "unslick",
      },

    ],
  });
  })
</script>
