<style>
   #shopify-section-{{section.id}}{
     margin-top: 2em !important
   }
     #shopify-section-{{section.id}} p{
     margin:0;
   }
  #shopify-section-{{section.id}}  .product-icon-text-section .flexbox .shopify-block{
    flex:1;
  }
   #shopify-section-{{section.id}}  .slick-track{
    width:100%
  }
  #shopify-section-{{section.id}}  .product-icon-text-section .flexbox .col .icon-text-block .icon-wrap {
    max-width: 80px;
    height: 80px;    margin-right: 1em;
  }
   #shopify-section-{{section.id}} .product-icon-text-section .page-width{
    max-width:1024px;
  }
  .product-icon-text-section .text-block{
    white-space:nowrap
  }
  .product-icon-text-section .flexbox{
    justify-content:center;

  }
     .product-icon-text-section .icon-text-block .col{
      flex:unset
    }
    .product-icon-text-section .flexbox >.col{
       max-width: 350px;
    }
  @media screen and (max-width: 860px) {
      .product-icon-text-section-{{section.id}} .col:not(:first-child){
    display:none
  }
   .product-icon-text-section-{{section.id}} .slick-initialized.slick-slider .col{
    display:unset
  }
  }
    @media screen and (min-width: 1440) {
      .product-icon-text-section .page-width{
    max-width:unset;
    display:flex;
    overflow:auto;
  }
  .product-icon-text-section .text-block{
    white-space:nowrap
  }
  .product-icon-text-section .flexbox{
    justify-content:center;flex-shrink: 0;min-width:100%

  }
  }
</style>
