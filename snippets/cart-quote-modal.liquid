{% comment %}
  Cart Quote Modal - 3-Step Wizard (MerakiQuote-style - IDENTICAL)
  Triggered by: <label for="quote-form-modal-cart">
{% endcomment %}

<style>
  /* Cart Quote Modal - Exact MerakiQuote Clone */
  .cart-quote-modal {
    display: none;
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 10001;
    opacity: 0;
    animation: cart-quote-fade-in 0.3s ease forwards;
  }

  .cart-quote-modal-toggle:checked + .cart-quote-modal {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @keyframes cart-quote-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .cart-quote-modal-wrapper {
    position: relative;
    width: 94%;
    max-width: 600px;
  }

  .cart-quote-modal-inner {
    background: #FFFFFF;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .cart-quote-modal-close {
    position: absolute;
    top: -8px;
    right: -8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #1a1a1a;
    border: none;
    border-radius: 50%;
    font-size: 18px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    color: #FFFFFF;
    z-index: 10;
    transition: background-color 0.2s ease;
  }

  .cart-quote-modal-close:hover {
    background: #333;
  }

  /* Step Indicators - Exact MerakiQuote style */
  .cart-quote-steps {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 32px;
    background: #fff;
    border-radius: 12px 12px 0 0;
  }

  .cart-quote-step {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #999;
    font-size: 14px;
    font-weight: 400;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-step.active {
    color: #1a1a1a;
    font-weight: 400;
  }

  .cart-quote-step.completed {
    color: #1a1a1a;
  }

  .cart-quote-step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: #999;
    font-size: 14px;
    font-weight: 400;
  }

  .cart-quote-step.active .cart-quote-step-number {
    background: #1a1a1a;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
  }

  .cart-quote-step.completed .cart-quote-step-number {
    background: #1a1a1a;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
  }

  .cart-quote-step-divider {
    display: none;
  }

  /* Modal Body */
  .cart-quote-modal-body {
    padding: 0;
    background: #FFFFFF;
  }

  /* Step Content */
  .cart-quote-step-content {
    display: none;
    padding: 20px 24px;
  }

  .cart-quote-step-content.active {
    display: block;
  }

  .cart-quote-step-title {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 4px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-step-subtitle {
    font-size: 13px;
    color: #666;
    margin-bottom: 16px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Products List (Step 1) - Exact MerakiQuote style */
  .cart-quote-product {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    margin-bottom: 8px;
    background: #fff;
    transition: border-color 0.2s;
  }

  /* All products have same styling - no special first-child */

  .cart-quote-product:last-child {
    margin-bottom: 0;
  }

  .cart-quote-product img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: 4px;
    background: transparent;
    margin-right: 16px;
  }

  .cart-quote-product-info {
    flex: 1;
    min-width: 0;
  }

  .cart-quote-product-title {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 2px;
    line-height: 1.3;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-product-variant {
    font-size: 13px;
    color: #666;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-product-qty {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    margin-left: 12px;
  }

  .cart-quote-product-qty label {
    font-size: 12px;
    color: #666;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-product-qty input {
    width: 70px;
    padding: 8px 4px 8px 12px;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    text-align: left;
    font-size: 14px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #fff;
  }

  .cart-quote-product-qty input::-webkit-outer-spin-button,
  .cart-quote-product-qty input::-webkit-inner-spin-button {
    -webkit-appearance: inner-spin-button;
    opacity: 1;
    height: auto;
    margin: 0 2px 0 0;
    cursor: pointer;
  }

  .cart-quote-product-qty input:focus {
    outline: none;
    border-color: #1a1a1a;
  }

  /* Contact Form (Step 2) - Exact MerakiQuote style */
  .cart-quote-form .form-group {
    margin-bottom: 16px;
  }

  .cart-quote-form label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
    font-size: 13px;
    color: #1a1a1a;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-form input[type="text"],
  .cart-quote-form input[type="email"],
  .cart-quote-form input[type="tel"],
  .cart-quote-form textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 14px;
    line-height: 1.5;
    box-sizing: border-box;
    background: #fff;
    color: #1a1a1a;
    transition: border-color 0.2s ease;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-form input:focus,
  .cart-quote-form textarea:focus {
    outline: none;
    border-color: #1a1a1a;
  }

  .cart-quote-form input::placeholder,
  .cart-quote-form textarea::placeholder {
    color: #999;
  }

  .cart-quote-form .required::after {
    content: ' *';
    color: #e74c3c;
  }

  .cart-quote-form .form-group {
    position: relative;
  }

  .cart-quote-form .error-message {
    display: none;
    color: #e74c3c;
    font-size: 12px;
    margin-top: 4px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-form .form-group.has-error .error-message {
    display: block;
  }

  .cart-quote-form .form-group.has-error input,
  .cart-quote-form .form-group.has-error textarea {
    border-color: #e74c3c;
  }

  .cart-quote-form .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media (max-width: 540px) {
    .cart-quote-modal-wrapper {
      width: 100%;
      height: 100%;
      max-width: none;
    }

    .cart-quote-modal-inner {
      height: 100%;
      max-height: 100%;
      border-radius: 0;
      display: flex;
      flex-direction: column;
    }

    .cart-quote-modal-close {
      top: 16px;
      right: 16px;
      width: 28px;
      height: 28px;
      font-size: 16px;
    }

    .cart-quote-steps {
      padding: 16px;
      justify-content: space-around;
      flex-shrink: 0;
    }

    .cart-quote-step {
      font-size: 12px;
      gap: 6px;
    }

    .cart-quote-step-number {
      width: 18px;
      height: 18px;
      font-size: 11px;
    }

    .cart-quote-step.active .cart-quote-step-number {
      font-size: 10px;
    }

    .cart-quote-modal-body {
      flex: 1;
      overflow-y: auto;
    }

    .cart-quote-step-content {
      padding: 16px;
    }

    .cart-quote-step-title {
      font-size: 15px;
    }

    .cart-quote-step-subtitle {
      font-size: 12px;
    }

    .cart-quote-product {
      padding: 10px 12px;
    }

    .cart-quote-product img {
      width: 52px;
      height: 52px;
      margin-right: 12px;
    }

    .cart-quote-product-title {
      font-size: 13px;
    }

    .cart-quote-product-variant {
      font-size: 12px;
    }

    .cart-quote-product-qty {
      margin-left: 8px;
    }

    .cart-quote-product-qty label {
      font-size: 11px;
    }

    .cart-quote-product-qty input {
      width: 56px;
      padding: 6px 8px;
      font-size: 13px;
    }

    .cart-quote-form .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .cart-quote-buttons {
      padding: 12px 16px 20px;
      flex-shrink: 0;
      gap: 8px;
    }

    .cart-quote-btn {
      padding: 10px 12px;
      font-size: 12px;
      white-space: nowrap;
      min-height: 40px;
    }

    .cart-quote-btn-secondary {
      flex: 1;
    }

    .cart-quote-btn-primary {
      flex: 1;
    }
  }

  /* Review Section (Step 3) - Exact MerakiQuote style */
  .cart-quote-review-section {
    background: #f9f9f9;
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 16px;
  }

  .cart-quote-review-section:last-child {
    margin-bottom: 0;
  }

  .cart-quote-review-title {
    font-size: 12px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-review-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 6px 0;
    border-bottom: 1px solid #eee;
  }

  .cart-quote-review-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cart-quote-review-label {
    font-size: 13px;
    color: #666;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-review-value {
    font-size: 13px;
    color: #1a1a1a;
    font-weight: 500;
    text-align: right;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Buttons - Exact MerakiQuote style */
  .cart-quote-buttons {
    display: flex;
    gap: 12px;
    padding: 16px 24px 24px;
    background: #fff;
    border-radius: 0 0 12px 12px;
  }

  .cart-quote-btn {
    flex: 1;
    height: 46px;
    padding: 0 20px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    box-sizing: border-box;
    line-height: 46px;
    display: block;
  }

  .cart-quote-btn-secondary {
    background: #fff;
    color: #1a1a1a;
    border: 1px solid #ddd;
  }

  .cart-quote-btn-secondary:hover {
    background: #f5f5f5;
    border-color: #ccc;
  }

  .cart-quote-btn-primary {
    background: #1a1a1a;
    color: #fff;
    border: 1px solid #1a1a1a;
  }

  .cart-quote-btn-primary:hover {
    background: #333;
    border-color: #333;
  }

  .cart-quote-btn-primary:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  /* Thank you message - Exact MerakiQuote style */
  .cart-quote-thank-you {
    display: none;
    text-align: center;
    padding: 48px 24px;
    background: #FFFFFF;
  }

  .cart-quote-thank-you.show {
    display: block;
  }

  .cart-quote-thank-you-icon {
    width: 56px;
    height: 56px;
    background: #1a1a1a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .cart-quote-thank-you-icon svg {
    width: 28px;
    height: 28px;
    fill: #fff;
  }

  .cart-quote-thank-you h4 {
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 8px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cart-quote-thank-you p {
    color: #666;
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 20px;
    max-width: 320px;
    margin-left: auto;
    margin-right: auto;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Hide steps when showing thank you */
  .cart-quote-modal-inner.show-thank-you .cart-quote-steps,
  .cart-quote-modal-inner.show-thank-you .cart-quote-modal-body .cart-quote-step-content,
  .cart-quote-modal-inner.show-thank-you .cart-quote-buttons {
    display: none;
  }

  .cart-quote-modal-inner.show-thank-you .cart-quote-thank-you {
    display: block;
  }
</style>

<input hidden type="checkbox" id="quote-form-modal-cart" class="cart-quote-modal-toggle">
<div class="cart-quote-modal">
  <div class="cart-quote-modal-wrapper">
    <label for="quote-form-modal-cart" class="cart-quote-modal-close" aria-label="Close">&times;</label>
    <div class="cart-quote-modal-inner" id="cart-quote-modal-inner">
      <!-- Step Indicators -->
      <div class="cart-quote-steps">
        <div class="cart-quote-step active" data-step="1">
          <span class="cart-quote-step-number">1</span>
          <span>{{ 'cart.quote.step_products' | t | default: 'Products selection' }}</span>
        </div>
        <div class="cart-quote-step-divider"></div>
        <div class="cart-quote-step" data-step="2">
          <span class="cart-quote-step-number">2</span>
          <span>{{ 'cart.quote.step_contact' | t | default: 'Contact information' }}</span>
        </div>
        <div class="cart-quote-step-divider"></div>
        <div class="cart-quote-step" data-step="3">
          <span class="cart-quote-step-number">3</span>
          <span>{{ 'cart.quote.step_review' | t | default: 'Review information' }}</span>
        </div>
      </div>

      <div class="cart-quote-modal-body">
        <!-- Thank You Message -->
        <div class="cart-quote-thank-you" id="cart-quote-thank-you">
          <div class="cart-quote-thank-you-icon">
            <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
          </div>
          <h4>{{ 'cart.general.quote_thank_you_title' | t | default: 'Thank You!' }}</h4>
          <p>{{ 'cart.general.quote_thank_you_message' | t | default: 'Your quote request has been submitted successfully. Our team will review your requirements and get back to you within 24 hours.' }}</p>
          <label for="quote-form-modal-cart" class="cart-quote-btn cart-quote-btn-primary" style="display: inline-block; max-width: 160px;">{{ 'cart.general.close' | t | default: 'Close' }}</label>
        </div>

        <!-- Step 1: Products Selection -->
        <div class="cart-quote-step-content active" data-step="1">
          <div class="cart-quote-step-title">{{ 'cart.quote.products_title' | t | default: 'Product' }}</div>
          <div class="cart-quote-step-subtitle">{{ 'cart.quote.products_subtitle' | t | default: 'The following products will be added to your quote request.' }}</div>

          <div class="cart-quote-products" id="cart-quote-products">
            {% for item in cart.items %}
              <div class="cart-quote-product" data-variant-id="{{ item.variant.id }}">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}">
                {% else %}
                  <img src="{{ 'no-image.svg' | asset_url }}" alt="{{ item.title | escape }}">
                {% endif %}
                <div class="cart-quote-product-info">
                  <div class="cart-quote-product-title">{{ item.product.title }}</div>
                  {% if item.variant.title != 'Default Title' %}
                    <div class="cart-quote-product-variant">{{ item.variant.title }}</div>
                  {% endif %}
                </div>
                <div class="cart-quote-product-qty">
                  <label>{{ 'cart.label.quantity' | t | default: 'Quantity' }}</label>
                  <input type="number" min="1" value="{{ item.quantity }}" data-item-key="{{ item.key }}" class="quote-qty-input">
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <!-- Step 2: Contact Information -->
        <div class="cart-quote-step-content" data-step="2">
          <div class="cart-quote-step-title">{{ 'cart.quote.contact_title' | t | default: 'Contact Information' }}</div>
          <div class="cart-quote-step-subtitle">{{ 'cart.quote.contact_subtitle' | t | default: 'Please provide your contact details so we can send you the quote.' }}</div>

          <form id="cart-quote-form" class="cart-quote-form">
            <input type="hidden" name="contact[subject]" value="Cart Quote Request">
            <input type="hidden" name="contact[tags]" value="quote-request,cart-quote">
            <input type="hidden" name="contact[cart_items]" id="cart-quote-items-hidden" value="">
            <input type="hidden" name="contact[gclid]" id="cart-quote-gclid" value="">

            <div class="form-row">
              <div class="form-group">
                <label for="cart-quote-name" class="required">{{ 'contact.form.name' | t | default: 'Full Name' }}</label>
                <input type="text" id="cart-quote-name" name="contact[Full name]">
                <span class="error-message">This field is required</span>
              </div>
              <div class="form-group">
                <label for="cart-quote-email" class="required">{{ 'contact.form.email' | t | default: 'Email' }}</label>
                <input type="email" id="cart-quote-email" name="contact[email]">
                <span class="error-message" id="email-error">This field is required</span>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="cart-quote-company" class="required">{{ 'customer.addresses.company' | t | default: 'Company Name' }}</label>
                <input type="text" id="cart-quote-company" name="contact[Company name]">
                <span class="error-message">This field is required</span>
              </div>
              <div class="form-group">
                <label for="cart-quote-phone" class="required">{{ 'customer.addresses.phone' | t | default: 'Phone Number' }}</label>
                <input type="tel" id="cart-quote-phone" name="contact[Phone]">
                <span class="error-message">This field is required</span>
              </div>
            </div>

            <div class="form-group">
              <label for="cart-quote-message">{{ 'contact.form.message' | t | default: 'Additional Notes' }}</label>
              <textarea id="cart-quote-message" name="contact[body]" rows="3" placeholder="{{ 'cart.general.quote_message_placeholder' | t | default: 'Any special requirements? (delivery to upper floors, multiple locations, etc.)' }}"></textarea>
            </div>
          </form>
        </div>

        <!-- Step 3: Review -->
        <div class="cart-quote-step-content" data-step="3">
          <div class="cart-quote-step-title">{{ 'cart.quote.review_title' | t | default: 'Review Your Request' }}</div>
          <div class="cart-quote-step-subtitle">{{ 'cart.quote.review_subtitle' | t | default: 'Please review your information before submitting.' }}</div>

          <div class="cart-quote-review-section">
            <div class="cart-quote-review-title">{{ 'cart.quote.products_title' | t | default: 'Products' }}</div>
            <div id="review-products"></div>
          </div>

          <div class="cart-quote-review-section">
            <div class="cart-quote-review-title">{{ 'cart.quote.contact_title' | t | default: 'Contact Information' }}</div>
            <div class="cart-quote-review-item">
              <span class="cart-quote-review-label">{{ 'contact.form.name' | t | default: 'Name' }}</span>
              <span class="cart-quote-review-value" id="review-name"></span>
            </div>
            <div class="cart-quote-review-item">
              <span class="cart-quote-review-label">{{ 'contact.form.email' | t | default: 'Email' }}</span>
              <span class="cart-quote-review-value" id="review-email"></span>
            </div>
            <div class="cart-quote-review-item">
              <span class="cart-quote-review-label">{{ 'customer.addresses.company' | t | default: 'Company' }}</span>
              <span class="cart-quote-review-value" id="review-company"></span>
            </div>
            <div class="cart-quote-review-item">
              <span class="cart-quote-review-label">{{ 'customer.addresses.phone' | t | default: 'Phone' }}</span>
              <span class="cart-quote-review-value" id="review-phone"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation Buttons -->
      <div class="cart-quote-buttons">
        <button type="button" class="cart-quote-btn cart-quote-btn-secondary" id="btn-back">
          Continue Shopping
        </button>
        <button type="button" class="cart-quote-btn cart-quote-btn-primary" id="btn-next">
          {{ 'cart.quote.next_step' | t | default: 'Next step' }}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    let currentStep = 1;
    const totalSteps = 3;

    // Cart items data
    const cartItems = [];
    {% for item in cart.items %}
      cartItems.push({
        key: {{ item.key | json }},
        title: {{ item.product.title | json }},
        variant: {{ item.variant.title | json }},
        variantId: {{ item.variant.id }},
        sku: {{ item.sku | json }},
        quantity: {{ item.quantity }},
        price: {{ item.price | money | json }},
        image: {{ item.image | image_url: width: 100 | json }}
      });
    {% endfor %}

    // Get gclid for attribution
    function getGclid() {
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const fromUrl = urlParams.get('gclid') || urlParams.get('_gcl_aw');
        if (fromUrl) return fromUrl;
        const fromStorage = localStorage.getItem('_gcl_aw');
        if (fromStorage) return fromStorage;
      } catch (e) {}
      return '';
    }

    // Set gclid
    const gclidField = document.getElementById('cart-quote-gclid');
    if (gclidField) gclidField.value = getGclid();

    // Step navigation
    function updateSteps() {
      // Update step indicators
      document.querySelectorAll('.cart-quote-step').forEach(step => {
        const stepNum = parseInt(step.dataset.step);
        step.classList.remove('active', 'completed');
        if (stepNum === currentStep) {
          step.classList.add('active');
        } else if (stepNum < currentStep) {
          step.classList.add('completed');
        }
      });

      // Update step content
      document.querySelectorAll('.cart-quote-step-content').forEach(content => {
        content.classList.remove('active');
        if (parseInt(content.dataset.step) === currentStep) {
          content.classList.add('active');
        }
      });

      // Update buttons
      const btnBack = document.getElementById('btn-back');
      const btnNext = document.getElementById('btn-next');

      if (currentStep === 1) {
        btnBack.textContent = 'Continue Shopping';
        btnBack.setAttribute('for', 'quote-form-modal-cart');
        btnNext.textContent = 'Next step';
      } else if (currentStep === 2) {
        btnBack.textContent = 'Previous';
        btnBack.removeAttribute('for');
        btnNext.textContent = 'Next step';
      } else if (currentStep === 3) {
        btnBack.textContent = 'Previous';
        btnBack.removeAttribute('for');
        btnNext.textContent = 'Submit Quote Request';
        updateReviewSection();
      }
    }

    function updateReviewSection() {
      // Update contact info review
      document.getElementById('review-name').textContent = document.getElementById('cart-quote-name').value;
      document.getElementById('review-email').textContent = document.getElementById('cart-quote-email').value;
      document.getElementById('review-company').textContent = document.getElementById('cart-quote-company').value;
      document.getElementById('review-phone').textContent = document.getElementById('cart-quote-phone').value;

      // Update products review
      const reviewProducts = document.getElementById('review-products');
      reviewProducts.innerHTML = '';

      document.querySelectorAll('.cart-quote-product').forEach((product, index) => {
        const qty = product.querySelector('.quote-qty-input').value;
        const title = cartItems[index]?.title || '';
        const variant = cartItems[index]?.variant || '';

        const item = document.createElement('div');
        item.className = 'cart-quote-review-item';
        item.innerHTML = `
          <span class="cart-quote-review-label">${title}${variant && variant !== 'Default Title' ? ' - ' + variant : ''}</span>
          <span class="cart-quote-review-value">Qty: ${qty}</span>
        `;
        reviewProducts.appendChild(item);
      });
    }

    function validateStep2() {
      const fields = [
        { id: 'cart-quote-name', value: document.getElementById('cart-quote-name').value.trim() },
        { id: 'cart-quote-email', value: document.getElementById('cart-quote-email').value.trim() },
        { id: 'cart-quote-company', value: document.getElementById('cart-quote-company').value.trim() },
        { id: 'cart-quote-phone', value: document.getElementById('cart-quote-phone').value.trim() }
      ];

      let isValid = true;

      // Clear all previous errors
      document.querySelectorAll('.cart-quote-form .form-group').forEach(group => {
        group.classList.remove('has-error');
      });

      // Check each required field
      fields.forEach(field => {
        const input = document.getElementById(field.id);
        const formGroup = input.closest('.form-group');

        if (!field.value) {
          formGroup.classList.add('has-error');
          isValid = false;
        }
      });

      // Special email validation
      const emailField = document.getElementById('cart-quote-email');
      const emailValue = emailField.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (emailValue && !emailRegex.test(emailValue)) {
        const formGroup = emailField.closest('.form-group');
        formGroup.classList.add('has-error');
        document.getElementById('email-error').textContent = 'Please enter a valid email address';
        isValid = false;
      } else if (emailValue) {
        document.getElementById('email-error').textContent = 'This field is required';
      }

      return isValid;
    }

    function submitQuote() {
      const form = document.getElementById('cart-quote-form');
      const formData = new FormData(form);

      // Get updated quantities
      const updatedItems = [];
      document.querySelectorAll('.cart-quote-product').forEach((product, index) => {
        const qty = parseInt(product.querySelector('.quote-qty-input').value) || 1;
        if (cartItems[index]) {
          updatedItems.push({
            ...cartItems[index],
            quantity: qty
          });
        }
      });

      const data = {
        created_at: new Date().toISOString(),
        source: 'cart-quote-modal-wizard',
        cart_items: updatedItems,
        gclid: getGclid()
      };

      formData.forEach((value, key) => {
        data[key] = value;
      });

      // Update hidden field
      const hiddenField = document.getElementById('cart-quote-items-hidden');
      if (hiddenField) hiddenField.value = JSON.stringify(updatedItems);

      // Send to n8n webhook
      fetch('https://n8n.soundboxstore.com/webhook/form-to-zoho', {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).catch(console.error);

      // Send to Cloud Run for Zoho CRM sync
      const zohoData = {
        Full_Name: formData.get('contact[Full name]'),
        Email: formData.get('contact[email]'),
        Company: formData.get('contact[Company name]'),
        Phone: formData.get('contact[Phone]'),
        Message: formData.get('contact[body]'),
        Lead_Source: 'WebSite Visit',
        Description: 'Cart Quote Request: ' + JSON.stringify(updatedItems),
        source: 'cart-quote-modal-wizard',
        gclid: getGclid()
      };
      fetch('https://soundboxstore-zoho-webhook-1008501784095.europe-west1.run.app/webhook/cart-quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(zohoData)
      }).catch(console.error);

      // Track event with customer data for attribution
      // Use global deduplication flag shared with quote-tracking.liquid
      const SUBMIT_FLAG = 'qt_lead_submitted';
      const alreadyFired = sessionStorage.getItem(SUBMIT_FLAG) === 'true';

      if (typeof umami !== 'undefined' && !alreadyFired) {
        // Get attribution data from localStorage (captured by quote-tracking.liquid)
        let gclid = '';
        let utmSource = '';
        let utmMedium = '';
        let utmCampaign = '';
        let landingPage = '';
        try {
          const attribution = JSON.parse(localStorage.getItem('qt_attribution') || '{}');
          gclid = localStorage.getItem('_gcl_aw') || attribution.gclid || '';
          utmSource = attribution.utm_source || (gclid ? 'google' : '');
          utmMedium = attribution.utm_medium || (gclid ? 'cpc' : '');
          utmCampaign = attribution.utm_campaign || '';
          landingPage = attribution.landing_page || '';
        } catch (e) {}

        const customerData = {
          quote_session_id: sessionStorage.getItem('qt_quote_session_id') || '',
          form_id: 'cart-quote-modal',
          email: formData.get('contact[email]') || '',
          name: formData.get('contact[Full name]') || '',
          first_name: (formData.get('contact[Full name]') || '').split(' ')[0] || '',
          last_name: (formData.get('contact[Full name]') || '').split(' ').slice(1).join(' ') || '',
          company: formData.get('contact[Company name]') || '',
          phone: formData.get('contact[Phone]') || formData.get('contact[Mobile number]') || '',
          postcode: formData.get('contact[postcode]') || '',
          city: formData.get('contact[city]') || '',
          country: formData.get('contact[Country/Region]') || '',
          gclid: gclid,
          utm_source: utmSource,
          utm_medium: utmMedium,
          utm_campaign: utmCampaign,
          landing_page: landingPage,
          page_path: window.location.pathname,
          products: updatedItems.map(item => ({
            product_name: item.title || '',
            sku: item.sku || '',
            variant: item.variant || '',
            quantity: item.quantity || 1,
            price: item.price || ''
          }))
        };
        umami.track('generate_lead', customerData);
        // Mark as fired AFTER umami.track to avoid interceptor blocking our own event
        sessionStorage.setItem(SUBMIT_FLAG, 'true');
        console.log('[CartQuoteModal] generate_lead fired with customer data:', customerData);

        // GA4 tracking
        try {
          if (typeof gtag !== 'undefined') {
            gtag('event', 'quote_submit', {
              form_id: 'cart-quote-modal',
              customer: {
                name: customerData.name,
                email: customerData.email,
                phone: customerData.phone,
                company: customerData.company,
                address: {
                  city: customerData.city,
                  zip: customerData.postcode,
                  country: customerData.country
                }
              },
              products: updatedItems.map(function(item) {
                return {
                  product_id: item.sku || item.variantId,
                  product_name: item.title + (item.variant ? ' - ' + item.variant : ''),
                  quantity: item.quantity,
                  price: item.price
                };
              }),
              total_quote_value: updatedItems.reduce(function(total, item) {
                var priceNum = parseFloat((item.price || '0').replace(/[^0-9.-]/g, ''));
                return total + (item.quantity * priceNum);
              }, 0),
              timestamp: new Date().toISOString()
            });
            console.log('[CartQuoteModal] GA4 quote_submit fired');
          }
        } catch (e) {
          console.error('[CartQuoteModal] GA4 tracking error:', e);
        }

        // dataLayer push for GTM (generate_lead event)
        try {
          if (typeof window !== 'undefined' && window.dataLayer) {
            window.dataLayer.push({
              'event': 'generate_lead',
              'customer_email': customerData.email || '',
              'customer_phone': customerData.phone || '',
              'customer_country': customerData.country || '',
              'customer_company': customerData.company || '',
              'customer_name': customerData.name || '',
              'form_id': 'cart-quote-form',
              'form_title': 'Cart Quote Form',
              'gclid': gclid || '',
              'quote_value': updatedItems.reduce(function(total, item) {
                var priceNum = parseFloat((item.price || '0').replace(/[^0-9.-]/g, ''));
                return total + (item.quantity * priceNum);
              }, 0),
              'products_count': updatedItems.length,
              // Enhanced Conversions user_data
              'user_data': {
                'email': customerData.email || '',
                'phone_number': customerData.phone || '',
                'address': {
                  'country': customerData.country || '',
                  'city': customerData.city || '',
                  'postal_code': customerData.postcode || ''
                }
              }
            });
            console.log('[CartQuoteModal] dataLayer.push generate_lead fired');
          }
        } catch (e) {
          console.error('[CartQuoteModal] dataLayer tracking error:', e);
        }
      } else if (alreadyFired) {
        console.log('[CartQuoteModal] quote_submit skipped - already fired');
      }

      // Show thank you
      document.getElementById('cart-quote-modal-inner').classList.add('show-thank-you');
    }

    // Button handlers
    document.getElementById('btn-next').addEventListener('click', function() {
      if (currentStep === 2 && !validateStep2()) {
        return;
      }

      if (currentStep < totalSteps) {
        currentStep++;
        updateSteps();
      } else {
        submitQuote();
      }
    });

    document.getElementById('btn-back').addEventListener('click', function(e) {
      if (currentStep > 1) {
        e.preventDefault();
        currentStep--;
        updateSteps();
      } else {
        // Close modal on step 1
        document.getElementById('quote-form-modal-cart').checked = false;
      }
    });

    // Close modal on overlay click
    const modal = document.querySelector('.cart-quote-modal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          document.getElementById('quote-form-modal-cart').checked = false;
        }
      });
    }

    // Reset modal when closed
    const modalCheckbox = document.getElementById('quote-form-modal-cart');
    if (modalCheckbox) {
      modalCheckbox.addEventListener('change', function() {
        if (!this.checked) {
          setTimeout(function() {
            currentStep = 1;
            updateSteps();
            document.getElementById('cart-quote-modal-inner').classList.remove('show-thank-you');
            document.getElementById('cart-quote-form').reset();
          }, 300);
        }
      });
    }

    // Clear error on input
    document.querySelectorAll('.cart-quote-form input, .cart-quote-form textarea').forEach(input => {
      input.addEventListener('input', function() {
        const formGroup = this.closest('.form-group');
        if (formGroup) {
          formGroup.classList.remove('has-error');
        }
      });
    });

    // Initialize
    updateSteps();
  })();
</script>
