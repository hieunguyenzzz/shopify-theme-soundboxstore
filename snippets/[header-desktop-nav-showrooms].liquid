<style>
  .header-desktop-nav-showrooms {
    white-space: normal;
    opacity: 1;
    font-size: 14px;
  }

  .header-desktop-nav-showrooms a:hover {
    text-decoration: none;
  }

  .header-desktop-nav-showrooms ul {
    padding: 0;
    margin: 0
  }

  .header-desktop-nav-showrooms-col1 {
    padding: 8px 40px 40px 0;
    border-right: 2px solid;
  }

  .header-desktop-nav-showrooms-col2 {
    border-top: 2px solid;
    border-right: 2px solid;
  }

  .header-desktop-nav-showrooms-menu a,
  {
  line-height: 1.3;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 18px;
  text-transform: uppercase;
  font-weight: 500;
  padding-bottom: 0.5em;
  font-family: "Banana Grotesk", var(--typeBasePrimary), var(--typeBaseFallback), system-ui;
  }

  .header-desktop-nav-showrooms-bottom {
    border-top: 2px solid;
    padding-top: 1em
  }

  .col_1 {
    position: relative;
    background: white;
    text-align: left
  }

  .col_1-label {
    position: absolute;
    right: -0.5em;
    top: 0;
    font-size: 0.8em;
    color: white;
    padding: 0.2em 1em;
    border-radius: 99em;
    line-height: 1.5em;
    background: #fb4646;
    margin-top: -1em;
  }

  .col_1-content-inner {
    display: flex;
    gap: 1.4em;
  }

  .col_1-subtitle {
    font-size: 0.9em;
    opacity: 0.4;
    margin-block-start: 0.5em;
  }

  .col_1-title {
    font-size: 1.1em;
    white-space: nowrap;
    font-weight: 500
  }

  .col_1-content-icon {
    width: 1.5em;
    height: 1.5em;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .col_1-content-icon svg {
    font-size: 1.4em
  }


  /* Container styles */
  .showrooms-container {
    flex: 1;
  }

  /* Heading styles */
  .showrooms-title {
    font-size: 2rem;
    font-weight: 600;
    line-height: 2rem;
  }



  /* Content wrapper */
  .showrooms-content {
    margin-top: 1rem;
  }


  /* Prose styles */
  .showrooms-prose {
    max-width: none;
  }

  .showrooms-prose p {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }

  .showrooms-prose p:first-child {
    margin-top: 0;
    max-width: 72ch;
    margin-bottom: 2em;
  }

  .showrooms-prose p:last-child {
    margin-bottom: 0;
  }


  /* Button styles */
  .showrooms-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    background-color: var(--colorBtnPrimary);
    color: white;
    text-decoration: none;
    border-radius: 0.375rem;
    font-weight: 500;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .showrooms-btn:hover {
    opacity: 0.9;
  }

  .showrooms-list {
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    display: grid;
    gap: 1em;
  }

  .showrooms-list a {
    border: 1px solid #d1d5db;
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    min-height: 63px;
    padding: 1em;
    padding-bottom: 1.3em;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    cursor: pointer;
    min-height: 120px;
    position: relative
  }

  .showrooms-list a:hover {
    border: 1px solid black;
  }

  .showrooms-list a>*:first-child {
    padding-bottom: 0.2em;
    font-size: 1.2em;

  }

  .showrooms-list a:first-child {
    display: flex;

  }

  .showrooms-badges {
    position: absolute;
    right: 0.5em;
    top: 0;
    display: flex;
    height:24px;
    gap: 0.5em;
    margin-top: -12px;
    align-items: center;
  }

  .showrooms-badge {
      border: 1px solid var(--border-color);
    font-size: 0.8em;
    color: white;
    padding: 0.2em 1em;
    border-radius: 99em;
    line-height: 1.5em;
    background: #fb4646;
  }
  .showrooms-badge-flag{
     border: 1px solid var(--border-color);
    border-radius: 99em;
    height: 24px;
    width: 24px;
    object-fit: cover;
    display: flex;
  }
  .showrooms-list a{
     --border-color:#d1d5db
  }
  .showrooms-list a:hover{
    --border-color:black
  }
</style>
{%- unless title -%}
  {%- assign title = settings.header_moreinfo -%}
{%- endunless -%}
{% capture col_1 %}
  
  {% endcapture %}
{% capture col_2 %}
 {% comment %} <iframe style="width:100%;height:100%;border:none" src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d4964.982718797998!2d-0.104927!3d51.522547!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48761b51cde4e46d%3A0x608ddcdd55b93d47!2s102-108%20Clerkenwell%20Rd%2C%20London%20EC1M%205SA!5e0!3m2!1sen!2suk!4v1747805192606!5m2!1sen!2suk" width="600" height="450"  allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" data-lf-form-tracking-inspected-belvo73qlzeazmqj="true" data-lf-yt-playback-inspected-belvo73qlzeazmqj="true" data-lf-vimeo-playback-inspected-belvo73qlzeazmqj="true"></iframe> {% endcomment %}
  <img style="width:100%;height:100%;object-fit:cover" src="https://cdn.shopify.com/s/files/1/0631/9892/0929/files/chart_2.png?v=1755072448" width="600" height="450" loading="lazy" />
    {% endcapture %}

<li
  class="site-nav__item site-nav__item_open site-nav__item-verticle site-nav__expanded-item site-nav--has-dropdown  site-nav--is-megamenu"
  aria-haspopup="true"
>
  {% assign page_about = settings.page_showroom %}
  <a
    href="{{ page_about.url }}"
    style="text-transform: uppercase;"
    class="site-nav__link site-nav__link--underline site-nav__link--has-dropdown"
  >
    {{ title }}
    <span class="visually-hidden">{{ page_about.title }}</span>
  </a>
  <div
    class="site-nav__dropdown site-nav__dropdown-animate  header-desktop-nav-showrooms hide"
    style="
      padding-bottom: 64px;
      padding-top:56px;
      font-size: 14px;width:100%;
    "
  >
    <div class="page-width site-nav__dropdown-menu">
      <div style="display:flex; flex-direction:column;flex:1">
        <div style="display:flex;width:100%">
          <div class="header-desktop-nav-showrooms-col1" style="flex:1">
            <div class="showrooms-container">
              <div class="showrooms-title">Our Showroom Network</div>
              <div class="showrooms-content showrooms-prose">
                <p>
                  Visit the our Showrooms to view our range of Office Pods. Book a visit online today. See and
                  experience acoustic excellence.
                </p>
                {% assign showroom_1 = metaobjects.showroom['clerkenwell-london-showroom-uk'] %}
                {% assign showroom_2 = metaobjects.showroom['oliveti-group-uk'] %}
                {% assign showroom_3 = metaobjects.showroom['pst-transports-services'] %}
                <div class="showrooms-list">
                  <a href="{{ showroom_1.system.url }}">
                    <strong>{{ showroom_1.title }}</strong>
                    <div>
                      {{ showroom_1.address }}
                      <div class="showrooms-badges">
                        <div class="showrooms-badge">{{ 'strings.others.flagship' | t }}</div>
                        <img
                          width="16"
                          height="16"
                          class="showrooms-badge-flag"
                          src="//soundboxstore.com/cdn/shop/t/79/assets/gb-flag.svg?v=85559558288444710101754913493"
                          alt="United Kingdom flag"
                        >
                      </div>
                    </div>
                  </a>
                  <a href="{{ showroom_2.system.url }}">
                    <strong>{{ showroom_2.title }}</strong>
                    <div>
                      {{ showroom_2.address }}
                    </div>
                    <div class="showrooms-badges">
                      <img
                        width="16"
                        height="16"
                        class="showrooms-badge-flag"
                        src="//soundboxstore.com/cdn/shop/t/79/assets/gb-flag.svg?v=85559558288444710101754913493"
                        alt="United Kingdom flag"
                      >
                    </div>
                  </a>
                  <a href="{{ showroom_3.system.url }}">
                    <strong>{{ showroom_3.title }}</strong>
                    <div>
                      {{ showroom_3.address }}
                    </div>
                    <div class="showrooms-badges">
                      <img
                        width="16"
                        height="16"
                        class="showrooms-badge-flag"
                        src="https://soundboxstore.com/cdn/shop/t/79/assets/ch-flag.svg?v=155648776223213222921754913485"
                        alt="United Kingdom flag"
                      >
                    </div>
                  </a>
                  <a href="{{ settings.page_showroom.url }}#showrooms-blocks">
                    <strong>Explore Our Other Showrooms</strong>
                    <div>We have showrooms over the world. Let find out.</div>
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="header-desktop-nav-showrooms-col2" style="flex:1">{{ col_2 }}</div>
        </div>
        <div class="header-desktop-nav-showrooms-bottom">
          <div>{{ settings.header_delivery_message }}</div>
          <div
            class="site-nav__dropdown-menu_left-icons"
            style="display: flex;margin-top: 1em;gap: 1em;flex-wrap: wrap;"
          >
            {% render 'iso-images' %}
          </div>
        </div>
      </div>
    </div>
  </div>
</li>
