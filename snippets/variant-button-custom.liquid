{% liquid
  assign sel = product.metafields.custom.size_selector.value
  assign use_metafield = false
  if sel != blank
    assign use_metafield = true
    assign opt_name = sel.name.value
    assign opt_1_name = sel.option_1_name.value
    assign locale_root = request.locale.root_url
    assign opt_1_url_raw = sel.option_1_url.value | replace: 'shopify://products/', '/products/'
    assign opt_1_url = locale_root | append: opt_1_url_raw
    assign opt_2_name = sel.option_2_name.value
    assign opt_2_url_raw = sel.option_2_url.value | replace: 'shopify://products/', '/products/'
    assign opt_2_url = locale_root | append: opt_2_url_raw
    assign opt_3_name = sel.option_3_name.value
    assign opt_3_url_raw = sel.option_3_url.value | replace: 'shopify://products/', '/products/'
    assign opt_3_url = locale_root | append: opt_3_url_raw
    assign cur_handle = product.handle
    assign opt_1_handle = opt_1_url_raw | split: '/products/' | last
    assign opt_2_handle = opt_2_url_raw | split: '/products/' | last
    assign opt_3_handle = opt_3_url_raw | split: '/products/' | last
  elsif block.settings.name != blank
    assign opt_name = block.settings.name
    assign opt_1_name = block.settings.option_1_name
    assign opt_2_name = block.settings.option_2_name
    assign opt_3_name = block.settings.option_3_name
  endif
%}

{% if opt_name != blank %}
<style>
  .variant-wrapper.option-variant-custom .variant__button-label{
        font-size: 16px;
    font-weight: 500;padding:7px 15px
  }
</style>
<div
  class="variant-wrapper js  variant_picker option-variant option-variant-custom"
  data-type="button"
>
  <div
    class="variant__label"
  >
    {{ opt_name }}
  </div>
  <div
    class="variant-input-wrap"
  >
    {% if use_metafield %}
      {% if opt_1_url != blank %}
        <div class="variant-input">
          <a href="{{ opt_1_url }}" class="variant__button-label"
            {% if opt_1_handle == cur_handle %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_1_name }}</a>
        </div>
      {% endif %}
      {% if opt_2_url != blank %}
        <div class="variant-input">
          <a href="{{ opt_2_url }}" class="variant__button-label"
            {% if opt_2_handle == cur_handle %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_2_name }}</a>
        </div>
      {% endif %}
      {% if opt_3_url != blank %}
        <div class="variant-input">
          <a href="{{ opt_3_url }}" class="variant__button-label"
            {% if opt_3_handle == cur_handle %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_3_name }}</a>
        </div>
      {% endif %}
    {% else %}
      {% assign locale_root = request.locale.root_url %}
      {% if block.settings.option_1_url != blank %}
        {% assign bs_opt_1_url = locale_root | append: block.settings.option_1_url %}
        <div class="variant-input">
          <a href="{{ bs_opt_1_url }}" class="variant__button-label"
            {% if block.settings.option_1_url == product.url %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_1_name }}</a>
        </div>
      {% endif %}
      {% if block.settings.option_2_url != blank %}
        {% assign bs_opt_2_url = locale_root | append: block.settings.option_2_url %}
        <div class="variant-input">
          <a href="{{ bs_opt_2_url }}" class="variant__button-label"
            {% if block.settings.option_2_url == product.url %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_2_name }}</a>
        </div>
      {% endif %}
      {% if block.settings.option_3_url != blank %}
        {% assign bs_opt_3_url = locale_root | append: block.settings.option_3_url %}
        <div class="variant-input">
          <a href="{{ bs_opt_3_url }}" class="variant__button-label"
            {% if block.settings.option_3_url == product.url %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_3_name }}</a>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

<script type="speculationrules">
  {
    "prerender": [
      {
        "urls": [
          {% if use_metafield %}
            "{{ opt_1_url }}", "{{ opt_2_url }}", "{{ opt_3_url }}"
          {% else %}
            "{{ block.settings.option_1_url }}", "{{ block.settings.option_2_url }}", "{{ block.settings.option_3_url }}"
          {% endif %}
        ]
      }
    ]
  }
</script>
{% endif %}
