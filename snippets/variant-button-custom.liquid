{% liquid
  assign sel = product.metafields.custom.size_selector.value
  if sel == blank
    break
  endif
  assign opt_name = sel.name.value
  assign opt_1_name = sel.option_1_name.value
  assign opt_1_url = sel.option_1_url.value
  assign opt_2_name = sel.option_2_name.value
  assign opt_2_url = sel.option_2_url.value
  assign opt_3_name = sel.option_3_name.value
  assign opt_3_url = sel.option_3_url.value
%}

{% if opt_name != blank %}
<style>
  .variant-wrapper.option-variant-custom .variant__button-label{
        font-size: 16px;
    font-weight: 500;padding:7px 15px
  }
</style>
<div
  class="variant-wrapper js  variant_picker option-variant option-variant-custom"
  data-type="button"
>
  <div
    class="variant__label"
  >
    {{ opt_name }}
  </div>
  <div
    class="variant-input-wrap"
  >
    {% if opt_1_url != blank %}
      <div class="variant-input">
        <a
          href="{{ opt_1_url }}"
          class="variant__button-label"
          {% if opt_1_url == product.url %}
            style="background-color: #303a44; color: #fff;"
          {% endif %}
        >
          {{ opt_1_name }}
        </a>
      </div>
    {% endif %}
    {% if opt_2_url != blank %}
      <div class="variant-input">
        <a
          href="{{ opt_2_url }}"
          class="variant__button-label"
          {% if opt_2_url == product.url %}
            style="background-color: #303a44; color: #fff;"
          {% endif %}
        >
          {{ opt_2_name }}
        </a>
      </div>
    {% endif %}
    {% if opt_3_url != blank %}
      <div class="variant-input">
        <a
          href="{{ opt_3_url }}"
          class="variant__button-label"
          {% if opt_3_url == product.url %}
            style="background-color: #303a44; color: #fff;"
          {% endif %}
        >
          {{ opt_3_name }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<script type="speculationrules">
  {
    "prerender": [
      {
        "urls": [
          "{{ opt_1_url }}",
          "{{ opt_2_url }}",
          "{{ opt_3_url }}"
        ]
      }
    ]
  }
</script>
{% endif %}
