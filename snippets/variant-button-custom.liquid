<div
  class="variant-wrapper js   option-variant"
  data-type="button"
>
  <div
    class="variant__label"
  >
    {{ name }}}
  </div>
  <div
    class="variant-input-wrap"
  >
    {% if option_1_url %}
      <div
        class="variant-input "
      >
        <a
          href="{{ option_1_url }}"
          class="variant__button-label"
        >
          <span>{{ option_1_name }}</span>
        </a>
      </div>
    {% endif %}
    {% if option_2_url %}
      <div
        class="variant-input "
      >
        <a
          href="{{ option_2_url }}"
          class="variant__button-label"
        >
          <span>{{ option_2_name }}</span>
        </a>
      </div>
    {% endif %}
    {% if option_3_url %}
      <div
        class="variant-input "
      >
        <a
          href="{{ option_3_url }}"
          class="variant__button-label"
        >
          <span>{{ option_3_name }}</span>
        </a>
      </div>
    {% endif %}
  </div>
</div>
