<style>
  .variant-wrapper.option-variant-custom .variant__button-label{
        font-size: 16px;
    font-weight: 500;padding:7px 15px
  }
</style>
<div
  class="variant-wrapper js  variant_picker option-variant option-variant-custom"
  data-type="button"
>
  <div
    class="variant__label"
  >
    {{ block.settings.name }}
  </div>
  <div
    class="variant-input-wrap"
  >
    {% if block.settings.option_1_url %}
      <div
        class="variant-input "
        {% if block.settings.option_1_url == product.url %}
          style="
            background-color: #303a44;
            color: #fff;
          "
        {% endif %}
      >
        <a
          href="{{  block.settings.option_1_url }}"
          class="variant__button-label"
        >
          <span>{{ block.settings.option_1_name }}</span>
        </a>
      </div>
    {% endif %}
    {% if block.settings.option_2_url %}
      <div
        class="variant-input "
      >
        <a
          href="{{  block.settings.option_2_url }}"
          class="variant__button-label"
        >
          <span>{{ block.settings.option_2_name }}</span>
        </a>
      </div>
    {% endif %}
    {% if block.settings.option_3_url %}
      <div
        class="variant-input "
      >
        <a
          href="{{  block.settings.option_3_url }}"
          class="variant__button-label"
        >
          <span>{{ block.settings.option_3_name }}</span>
        </a>
      </div>
    {% endif %}
  </div>
</div>
