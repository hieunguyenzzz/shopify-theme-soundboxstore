{% liquid
  assign sel = product.metafields.custom.size_selector.value
  assign use_metafield = false

  assign locale_prefix = request.path | split: '/products/' | first

  if sel != blank
    assign use_metafield = true
    assign opt_name = sel.name.value
    assign opt_1_name = sel.option_1_name.value
    assign opt_1_url = sel.option_1_url.value | replace: 'shopify://products/', '/products/'
    assign opt_2_name = sel.option_2_name.value
    assign opt_2_url = sel.option_2_url.value | replace: 'shopify://products/', '/products/'
    assign opt_3_name = sel.option_3_name.value
    assign opt_3_url = sel.option_3_url.value | replace: 'shopify://products/', '/products/'
    assign opt_1_handle = opt_1_url | split: '/products/' | last
    assign opt_2_handle = opt_2_url | split: '/products/' | last
    assign opt_3_handle = opt_3_url | split: '/products/' | last
    assign opt_1_url_full = locale_prefix | append: opt_1_url
    assign opt_2_url_full = locale_prefix | append: opt_2_url
    assign opt_3_url_full = locale_prefix | append: opt_3_url
    assign opt_1_product = all_products[opt_1_handle]
    assign opt_2_product = all_products[opt_2_handle]
    assign opt_3_product = all_products[opt_3_handle]
  elsif block.settings.name != blank
    assign opt_name = block.settings.name
    assign opt_1_name = block.settings.option_1_name
    assign opt_2_name = block.settings.option_2_name
    assign opt_3_name = block.settings.option_3_name
    assign opt_1_handle_bs = block.settings.option_1_url | split: '/products/' | last
    assign opt_2_handle_bs = block.settings.option_2_url | split: '/products/' | last
    assign opt_3_handle_bs = block.settings.option_3_url | split: '/products/' | last
    assign opt_1_url_full = locale_prefix | append: block.settings.option_1_url
    assign opt_2_url_full = locale_prefix | append: block.settings.option_2_url
    assign opt_3_url_full = locale_prefix | append: block.settings.option_3_url
  endif
%}

{% if opt_name != blank %}

<style>
  .variant-wrapper.option-variant-custom .variant__button-label{
        font-size: 16px;
    font-weight: 500;padding:7px 15px
  }
</style>
<div
  class="variant-wrapper js  variant_picker option-variant option-variant-custom"
  data-type="button"
>
  <div
    class="variant__label"
  >
    {{ opt_name }}
  </div>
  <div
    class="variant-input-wrap"
  >
    {% if use_metafield %}
      {% if opt_1_url != blank %}
        <div class="variant-input">
          <a href="{{ opt_1_url_full }}" class="variant__button-label"
            {% if opt_1_product.id == product.id or request.path contains opt_1_handle or product.handle == opt_1_handle %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_1_name }}</a>
        </div>
      {% endif %}
      {% if opt_2_url != blank %}
        <div class="variant-input">
          <a href="{{ opt_2_url_full }}" class="variant__button-label"
            {% if opt_2_product.id == product.id or request.path contains opt_2_handle or product.handle == opt_2_handle %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_2_name }}</a>
        </div>
      {% endif %}
      {% if opt_3_url != blank %}
        <div class="variant-input">
          <a href="{{ opt_3_url_full }}" class="variant__button-label"
            {% if opt_3_product.id == product.id or request.path contains opt_3_handle or product.handle == opt_3_handle %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_3_name }}</a>
        </div>
      {% endif %}
    {% else %}
      {% if block.settings.option_1_url != blank %}
        <div class="variant-input">
          <a href="{{ opt_1_url_full }}" class="variant__button-label"
            {% if request.path contains opt_1_handle_bs or product.handle == opt_1_handle_bs %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_1_name }}</a>
        </div>
      {% endif %}
      {% if block.settings.option_2_url != blank %}
        <div class="variant-input">
          <a href="{{ opt_2_url_full }}" class="variant__button-label"
            {% if request.path contains opt_2_handle_bs or product.handle == opt_2_handle_bs %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_2_name }}</a>
        </div>
      {% endif %}
      {% if block.settings.option_3_url != blank %}
        <div class="variant-input">
          <a href="{{ opt_3_url_full }}" class="variant__button-label"
            {% if request.path contains opt_3_handle_bs or product.handle == opt_3_handle_bs %}style="background-color: #303a44; color: #fff;"{% endif %}
          >{{ opt_3_name }}</a>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

<script type="speculationrules">
  {
    "prerender": [
      {
        "urls": [
          "{{ opt_1_url_full }}", "{{ opt_2_url_full }}", "{{ opt_3_url_full }}"
        ]
      }
    ]
  }
</script>
{% endif %}
