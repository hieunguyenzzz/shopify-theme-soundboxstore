{%- assign newsletter_form_id = 'newsletter-' | append: section_id -%}
{% form 'customer', id: newsletter_form_id %}
  {%- if form.posted_successfully? -%}
    <div class="note note--success">
      {{ 'general.newsletter_form.newsletter_confirmation' | t }}
    </div>
  {%- endif -%}
  {%- if form.errors and form.context == snippet_context -%}
    {{ form.errors | default_errors }}
  {%- endif -%}
  {%- unless form.posted_successfully? -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="hidden" name="contact[context]" value="{{ snippet_context }}">

    <div class="input-group newsletter__input-group">
      <label for="Name-{{ section_id }}" class="hidden-label">
        {{- 'general.newsletter_form.newsletter_fullname' | t -}}
      </label>
      <input
        type="text"
        placeholder="{{ 'general.newsletter_form.newsletter_fullname' | t }}"
        name="contact[fullname]"
        id="Fullname-{{ section_id }}"
        class="input-group-field newsletter__input"
        autocorrect="off"
        autocapitalize="off"
      >
    </div>
    <div class="input-group newsletter__input-group">
      <label for="Email-{{ section_id }}" class="hidden-label">
        {{- 'general.newsletter_form.newsletter_email' | t -}}
      </label>
      <input
        type="email"
        value="{% if customer %}{{ customer.email }}{% endif %}"
        placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}"
        name="contact[email]"
        id="Email-{{ section_id }}"
        class="input-group-field newsletter__input"
        autocorrect="off"
        autocapitalize="off"
      >
    </div>
    <div class="input-group newsletter__input-group">
      <button
        style="width:100%"
        type="submit"
        class="btn btn--submit"
        name="commit"
        aria-label="{{ 'general.newsletter_form.submit' | t }}"
        style="background-color: var(--colorBtnPrimary);"
      >
        {{ 'general.newsletter_form.submit' | t }}
      </button>
    </div>
  {%- endunless -%}
{% endform %}
