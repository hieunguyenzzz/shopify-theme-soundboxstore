{%- comment -%}
  SBS US market launch — product eligibility gate.

  The eligibility decision itself lives in snippets/sbs-us-eligibility.liquid so
  that collection cards, search cards, recommendation cards, mega-menu tiles and
  top-searched pills all share one rule. Non-US markets are unaffected and every
  product remains reachable at its own URL.
{%- endcomment -%}
{%- capture sbs_item_eligibility -%}
  {%- render 'sbs-us-eligibility', product: product -%}
{%- endcapture -%}
{%- unless sbs_item_eligibility contains 'DENY' -%}
{% unless title != blank %}
  {% assign title = product.metafields.custom.menu_title.value | default: product.title %}
{% endunless %}
{% unless subtitle != blank %}
  {% assign subtitle = product.metafields.custom.menu_subtitle.value | default: product.metafields.custom.subtitle %}
{% endunless %}
{% assign images = images | default: product.metafields.custom.card_images.value %}

{% unless image %}
  {%- for img in images -%}
    {% if forloop.first %}
      {% assign image = img %}
    {% else %}
      {% assign image_2 = img %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endunless %}
{% unless image %}
  {% assign imgs = product.variants.first.metafields.global.images.value %}
  {%- for img in imgs -%}
    {% assign image = img %}
    {% break %}
  {% endfor %}
{% endunless %}
{% unless image_2 %}
  {% assign imgs = product.variants[2].metafields.global.images.value %}
  {%- for img in imgs -%}
    {% if forloop.first %}
      {% continue %}
    {% endif %}
    {% assign image_2 = img %}
    {% break %}
  {% endfor %}
{% endunless %}
{% if image == blank %}
  {% assign image = product.featured_image %}
{% endif %}
{% if image_2 == blank %}
  {% assign image_2 = product.metafields.custom.secondary_image.value %}
{% endif %}
{% unless description %}
  {% assign description = product.description | strip_html | slice: 0, 150 | append: '...' %}
{% endunless %}
{% if url == blank %}
  {% assign url = product.url %}
{% endif %}
{% capture seatimg %}
{{ settings.manicon | image_url :width:40 |image_tag }}
{% endcapture %}
<a
  href="{{ url }}"
  class="collection-product-item"
>
  <div class="image {% if image_2 %} had_image_2 {% endif %}">
    {% if image and image != blank %}
      {{
        image
        | image_url: width: 400
        | image_tag: widths: '400, 600, 900', loading: 'lazy', class: 'js-lazy-image', alt: title
      }}
    {% endif %}
    {% if image_2 and image_2 != blank %}
      {{
        image_2
        | image_url: width: 400
        | image_tag: widths: '400, 600, 900', loading: 'lazy', class: 'js-lazy-image', alt: title
      }}
    {% endif %}
  </div>
  <div class="content">
    <div>
      <h3>{{ title }}</h3>
      <div class="subtitle">{{ subtitle }}</div>
    </div>
    {% if product.metafields.custom.seats.value %}
      <div class="seats">
        <div style="display:flex;gap:0.3em" title="{{ product.metafields.custom.seats.value }} Seats">
          {% for i in (1..product.metafields.custom.seats.value) %}
            {{ seatimg }}
          {% endfor %}
        </div>
        <span style="display:none">{{ product.metafields.custom.seats.value }} Seats</span>
      </div>
    {% endif %}
    {%- assign swatch_file_extension = 'png' -%}
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_name = option.name | downcase
        assign is_color = false
        if option_name contains swatch_trigger
          assign is_color = true
        elsif option_name contains 'color' or option_name contains 'colour' or option_name contains 'couleur' or option_name contains 'farve' or option_name contains 'farbe' or option_name contains 'väri' or option_name contains 'dath' or option_name contains 'colore' or option_name contains 'kleur' or option_name contains 'farge' or option_name contains 'kolor' or option_name contains 'färg'
          assign is_color = true
        endif
      -%}
      {%- if is_color -%}
        <div class="colours" style="display:flex;gap:0.3em;flex-wrap:wrap">
          {% for value in option.values %}
            {%- assign value_str = value | append: '' -%}
            {%- if value_str contains '#' -%}
              {%- capture omni_sw -%}{%- render 'omni-internal-swatch-bg', value: value_str -%}{%- endcapture -%}
              <div
                title="{{ value }}"
                class="variant__button-label color-swatch"
                style="width:1.5em;height:1.5em;margin:0;background: {{ omni_sw | strip }};"
              ></div>
              {%- continue -%}
            {%- endif -%}
            {% if value.swatch %}
              {% assign swatch = value.swatch %}
              {%- liquid
                assign swatch_value = null
                if swatch.image
                  assign image_url = swatch.image | image_url: width: 50
                  assign swatch_image = 'url(' | append: image_url | append: ')'
                  assign swatch_focal_point = swatch.image.presentation.focal_point
                endif
                if swatch.color
                  assign swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
                endif
              -%}
               <script>
                console.log({{ swatch_image | json }},"=======");
              </script>
              <div
                title="{{ value }}"
                class="variant__button-label color-swatch "
                style="width:1.5em;height:1.5em;margin:0;background-color: {{ swatch_value }};background-image: {{ swatch_image }};"
              >
                {{ tranValue | escape }}
              </div>
              {% continue %}
            {% endif %}
            {% for variant in product.variants -%}
              {% if variant.option1 == value %}
                {% if variant.metafields.custom.color_image %}
                  {% assign color_image = variant.metafields.custom.color_image | img_url: '50x50' %}
                {% endif %}
              {% endif %}
            {%- endfor %}
            {% unless color_image %}
              {%- capture en_color_handle -%}{%- render 'color-en-handle', value: value -%}{%- endcapture -%}
              {%- liquid
                assign color_file_name = en_color_handle | append: '.' | append: swatch_file_extension
                assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
                assign color_swatch_fallback = value | split: ' ' | last | handle
              -%}
            {% endunless %}
            <div
              title="{{ value }}"
              class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
              style="width:1.5em;height:1.5em;margin:0;background-color: {{ color_swatch_fallback }};background-image: url({{ color_image }});{% if images[color_file_name] != blank %}  background-image: url({{ color_image }});{% endif %}"
            >
              {{ tranValue | escape }}
            </div>
            {% assign color_image = null %}
          {% endfor %}
        </div>
      {% endif %}
    {%- endfor -%}
    {% if product.price_min > 0 %}
      {% if product.template_suffix == 'omni-booth' or product.template_suffix contains 'kozee-booth' %}
        <div class="itemprice">POA</div>
      {% else %}
      {% assign lowest_price = product.price_min
        | divided_by: 100.0
        | round
        | times: 100
        | money_without_trailing_zeros
        | replace: 'Dhs.', 'AED'
      %}

      {% if lowest_price != blank %}
        <div class="itemprice">
          {{ 'products.general.from_text_html' | t: price: lowest_price }}
          {% if product.compare_at_price_min > product.price_min %}
            <span class="compare_at_price">
              {{-
                product.compare_at_price_min
                | divided_by: 100.0
                | round
                | times: 100
                | money_without_trailing_zeros
                | replace: 'Dhs.', 'AED'
              -}}
            </span>
          {% endif %}
        </div>
      {% endif %}
      {% endif %}
      {%- liquid
        # Review badge source of truth: prefer real Judge.me numbers (same data as the
        # product page, read server-side), fall back to the manual custom.reviews_* stars,
        # render nothing when neither exists.
        assign card_rating = 0
        assign card_count = 0
        assign jm_data = product.metafields.judgeme.review_widget_data.value
        if jm_data != blank and jm_data.number_of_reviews != blank
          assign card_count = jm_data.number_of_reviews | plus: 0
          assign card_rating = jm_data.average_rating | times: 1.0
        else
          assign jm_badge = product.metafields.judgeme.badge
          if jm_badge != blank and jm_badge contains "data-number-of-reviews='"
            assign card_count = jm_badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0
            assign card_rating = jm_badge | split: "data-average-rating='" | last | split: "'" | first | times: 1.0
          endif
        endif
        if card_count <= 0 and product.metafields.custom.reviews_rating.value > 1
          assign card_rating = product.metafields.custom.reviews_rating.value | times: 1.0
          assign card_count = product.metafields.custom.reviews_count | plus: 0
        endif
      -%}
      {% if card_count > 0 %}
        <div class="itempreviews">
          <div
            class="jdgm-prev-badge"
          >
            <span class="jdgm-prev-badge__stars" role="button">
              {% if card_rating > 1 %}
                <span class="jdgm-star jdgm--on"></span>
              {% else %}
                <span class="jdgm-star jdgm--half"></span>
              {% endif %}
              {% if card_rating > 2 %}
                <span class="jdgm-star jdgm--on"></span>
              {% else %}
                <span class="jdgm-star jdgm--half"></span>
              {% endif %}
              {% if card_rating > 3 %}
                <span class="jdgm-star jdgm--on"></span>
              {% else %}
                <span class="jdgm-star jdgm--half"></span>
              {% endif %}
              {% if card_rating > 4 %}
                <span class="jdgm-star jdgm--on"></span>
              {% else %}
                <span class="jdgm-star jdgm--half"></span>
              {% endif %}
              {% if card_rating >= 5 %}
                <span class="jdgm-star jdgm--on"></span>
              {% else %}
                <span class="jdgm-star jdgm--half"></span>
              {% endif %}
            </span>
            <span class="jdgm-prev-badge__text">
              {{ card_count }}
              {{ 'strings.others.reviews' | t }}
            </span>
          </div>
        </div>
      {% endif %}
    {% endif %}
    <!-- <div class="description">{{ description }}</div> -->
  </div>
</a>
{%- endunless -%}
