{% assign thankpageurl = pages.thankpage.url | escape %}
<div id="{{form_id}}-wrap">
  {%- form 'contact', id: form_id, class: 'target:ring-3', return_to: thankpageurl -%}
    {{ form.errors | default_errors }}
    <input
      hidden
      type="text"
      placeholder="{{  settings.quote_full_name }}"
      class="input-full input hide"
      name="contact[subject]"
      value="NEW CUSTOMER QUOTE REQUEST"
    >
    <div class="grid grid--small">
      <div class="grid__item">
        <input
          type="text"
          required
          placeholder="{{  settings.quote_full_name }}"
          class="input-full input"
          name="contact[Full name]"
          autocapitalize="words"
          value=""
        >
        <label for="ContactFormName-{{ section.id }}">{{ settings.quote_full_name }}</label>
      </div>
      <div class="grid__item">
        <input
          class="input-full input"
          autocomplete="email"
          type="email"
          required
          id="ContactForm-email"
          class="field__input"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"aria-describedby="ContactForm-email-error"
          {% endif -%}
          placeholder="{{  settings.quote_email }}"
        >
        <label for="ContactFormEmail-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
      </div>
      {% assign phone_example = 'strings.others.phone_example' | t %}
      <div class="grid__item">
        <div
          style="position: relative;"
        >
          <select
            class="countryphonecode-selector"
            name="contact[Mobile country code]"
            style="
              position: absolute;
              left: 1px;
              top: 1px;
              bottom: 1px;
              /* font-size: 1.4em; */
              line-height: 1;
              display: flex;
              appearance: base-select;
              align-items: center;
              padding-right: 10px;
              border-right: 1px solid;
              background-image:none;
            "
          >
            <button>
              <selectedcontent
                style="
                  display: flex;
                  align-items: center;
                "
                ><span class="icon" aria-hidden="true">🇳🇴</span
                ><span class="option-label">Norway +47</span></selectedcontent
              >
            </button>
            <option value="+44">
              <span class="icon" aria-hidden="true">🇬🇧</span><span class="option-label">United Kingdom +44</span>
            </option>
            <option value="+353">
              <span class="icon" aria-hidden="true">🇮🇪</span><span class="option-label">Ireland +353</span>
            </option>
            <option value="+971">
              <span class="icon" aria-hidden="true">🇦🇪</span><span class="option-label">United Arab Emirates +971</span>
            </option>
            <option value="+1">
              <span class="icon" aria-hidden="true">🇺🇸</span><span class="option-label">United States +1</span>
            </option>
            <option value="+45">
              <span class="icon" aria-hidden="true">🇩🇰</span><span class="option-label">Denmark +45</span>
            </option>
            <option value="+46">
              <span class="icon" aria-hidden="true">🇸🇪</span><span class="option-label">Sweden +46</span>
            </option>
            <option value="+49">
              <span class="icon" aria-hidden="true">🇩🇪</span><span class="option-label">Germany +49</span>
            </option>
            <option value="+47">
              <span class="icon" aria-hidden="true">🇳🇴</span><span class="option-label">Norway +47</span>
            </option>
            <option value="+33">
              <span class="icon" aria-hidden="true">🇫🇷</span><span class="option-label">France +33</span>
            </option>
            <option value="+31">
              <span class="icon" aria-hidden="true">🇳🇱</span><span class="option-label">Netherlands +31</span>
            </option>
            <option value="+32">
              <span class="icon" aria-hidden="true">🇧🇪</span><span class="option-label">Belgium +32</span>
            </option>
            <option value="+43">
              <span class="icon" aria-hidden="true">🇦🇹</span><span class="option-label">Austria +43</span>
            </option>
            <option value="+41">
              <span class="icon" aria-hidden="true">🇨🇭</span><span class="option-label">Switzerland +41</span>
            </option>
            <option value="+34">
              <span class="icon" aria-hidden="true">🇪🇸</span><span class="option-label">Spain +34</span>
            </option>
            <option value="+358">
              <span class="icon" aria-hidden="true">🇫🇮</span><span class="option-label">Finland +358</span>
            </option>
            <option value="+48">
              <span class="icon" aria-hidden="true">🇵🇱</span><span class="option-label">Poland +48</span>
            </option>
            <option value="+39">
              <span class="icon" aria-hidden="true">🇮🇹</span><span class="option-label">Italy +39</span>
            </option>
            <option value="+">Others</option>
          </select>
          <style>
            select.countryphonecode-selector,
            ::picker(select.countryphonecode-selector) {
              appearance: base-select;
            }
            .countryphonecode-selector selectedcontent .option-label{
              display: none
            }
          </style>
          <script>
            (() => {
              let s = document.querySelector('[name="contact[Mobile country code]"]');
              s.addEventListener('change', (e) => {
                document.querySelector('[name="contact[Mobile number]"]').value = e.target.value;
              });
            })();
          </script>
          <input
            style="padding-left:70px"
            type="tel"
            required
            autocomplete="tel"
            id="ContactFormPhone-{{ section.id }}"
            class="input-full input"
            name="contact[Mobile number]"
            placeholder="{{  settings.quote_mobile_number }}. {{ phone_example }}"
            pattern="^\+[1-9]\d{1,14}$"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          >
          <label for="ContactFormPhone-{{ section.id }}">{{ settings.quote_mobile_number }}</label>
          <label for="ContactFormPhone-">Mobile number</label>
        </div>
      </div>
      <div class="grid__item">
