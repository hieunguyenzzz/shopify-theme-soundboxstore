              >
            </button>
            <option value="+44">
              <span class="icon" aria-hidden="true">🇬🇧</span><span class="option-label">United Kingdom +44</span>
            </option>
            <option value="+353">
              <span class="icon" aria-hidden="true">🇮🇪</span><span class="option-label">Ireland +353</span>
            </option>
            <option value="+971">
              <span class="icon" aria-hidden="true">🇦🇪</span><span class="option-label">United Arab Emirates +971</span>
            </option>
            <option value="+1">
              <span class="icon" aria-hidden="true">🇺🇸</span><span class="option-label">United States +1</span>
            </option>
            <option value="+45">
              <span class="icon" aria-hidden="true">🇩🇰</span><span class="option-label">Denmark +45</span>
            </option>
            <option value="+46">
              <span class="icon" aria-hidden="true">🇸🇪</span><span class="option-label">Sweden +46</span>
            </option>
            <option value="+49">
              <span class="icon" aria-hidden="true">🇩🇪</span><span class="option-label">Germany +49</span>
            </option>
            <option value="+47">
              <span class="icon" aria-hidden="true">🇳🇴</span><span class="option-label">Norway +47</span>
            </option>
            <option value="+33">
              <span class="icon" aria-hidden="true">🇫🇷</span><span class="option-label">France +33</span>
            </option>
            <option value="+31">
              <span class="icon" aria-hidden="true">🇳🇱</span><span class="option-label">Netherlands +31</span>
            </option>
            <option value="+32">
              <span class="icon" aria-hidden="true">🇧🇪</span><span class="option-label">Belgium +32</span>
            </option>
            <option value="+43">
              <span class="icon" aria-hidden="true">🇦🇹</span><span class="option-label">Austria +43</span>
            </option>
            <option value="+41">
              <span class="icon" aria-hidden="true">🇨🇭</span><span class="option-label">Switzerland +41</span>
            </option>
            <option value="+34">
              <span class="icon" aria-hidden="true">🇪🇸</span><span class="option-label">Spain +34</span>
            </option>
            <option value="+358">
              <span class="icon" aria-hidden="true">🇫🇮</span><span class="option-label">Finland +358</span>
            </option>
            <option value="+48">
              <span class="icon" aria-hidden="true">🇵🇱</span><span class="option-label">Poland +48</span>
            </option>
            <option value="+39">
              <span class="icon" aria-hidden="true">🇮🇹</span><span class="option-label">Italy +39</span>
            </option>
            <option value="+">Others</option>
          </select>
          <script>
            (() => {
              let s = document.querySelector('[name="contact[Phone country code]"]');
              s.addEventListener('change', (e) => {
                document.querySelector('[name="contact[Phone number]"]').value = e.target.value;
              });
            })();
          </script>
          <input
            style="padding-left:70px"
            type="tel"
            required
            autocomplete="tel"
            id="ContactFormPhone-{{ section.id }}"
            class="input-full input"
            name="contact[Phone number]"
            placeholder="{{  settings.quote_phone_number }}. {{ phone_example }}"
            pattern="^\+[1-9]\d{1,14}$"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          >
          <label for="ContactFormPhone-{{ section.id }}">{{ settings.quote_phone_number }}</label>
        </div>
      </div>

      <div class="grid__item">
        <input
          required
          id="ContactFormAddress-{{ section.id }}"
          class="input-full input"
          name="contact[address]"
          placeholder="{{ 'contact.form.address' | t }}"
        >
        <label for="ContactFormPhone-{{ section.id }}">{{ 'contact.form.address' | t }}</label>
      </div>
      <div class="grid__item">
        <input
          type="text"
          required
          placeholder="{{  settings.quote_company_name }}"
          class="input-full input"
          name="contact[Company name]"
          autocapitalize="words"
          value=""
        >
        <label for="ContactFormName-{{ section.id }}">{{ settings.quote_company_name }}</label>
      </div>

      <div class="grid__item">
        <select
          type="text"
          required
          placeholder="{{ settings.quote_country }}"
          class="input-full input"
          name="contact[Country/Region]"
          style="    appearance: auto;"
          value="{{ localization.country.iso_code }}"
        >
          {% assign countrymap = 'GB en,
IE ie /en-ie,
US en /en-us,
DK da /da-dk,
SE se /sv-se,
DE de /de-de,
NO no /no-no,
FR fr /fr-fr,
NL nl /nl-nl,
BE nl /nl-be show,
BE fr /fr-be show,
AT de /de-at,
CH de /de-ch,
ES es /es-es,
FI fi /fi-fi,
PL pl /pl-pl,
IT it /it-it' %}

          {% assign contrylangs = countrymap | split: ',' %}
          {%- for contrylang in contrylangs -%}
            {% assign contrylangarray = contrylang | split: ' ' %}
            {% assign contrycode = contrylangarray[0] %}
            {% assign country = localization.available_countries | where: 'iso_code', contrycode | first %}
            {% unless country %}
              {% continue %}
            {% endunless %}
            <option
              value="{{ country.iso_code }}"
              {% if localization.country.iso_code == country.iso_code %}
                selected
              {% endif %}
            >
              {{ country.name }}
            </option>
          {%- endfor -%}
          <option value="other">Other</option>
        </select>
        <label for="ContactFormName-{{ section.id }}">{{ settings.quote_country }}</label>
      </div>
      <div
        class="grid__item"
        style="display: grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));  gap: 1em; max-width: 410px;"
      >
        <input type="hidden" name="contact[tags]" value="quote-request">
        <input type="hidden" name="contact[context]" value="quote-request-header">
        <div class="">
          <input
            class="input-full input"
            required
            id="ContactForm-city"
            class="field__input"
            name="contact[city]"
            value=""
            aria-required="true"
            placeholder="{{  'customer.addresses.city' | t }}"
          >
          <label for="ContactFormCity-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
        </div>
        <div class="">
          <input
            class="input-full input"
            required
            id="ContactForm-postcode"
            class="field__input"
            name="contact[postcode]"
            value=""
            aria-required="true"
            placeholder="{{ 'contact.form.postcode' | t }}"
          >
          <label for="ContactFormPostcode-{{ section.id }}">{{ 'contact.form.postcode' | t }}</label>
        </div>
      </div>
      <div class="grid__item">
        <textarea
          rows="5"
          required
          id="ContactFormMessage-{{ section.id }}"
          class="input-full input"
          placeholder="{{ settings.quote_message }}"
          name="contact[body]"
          value="{%- if form.body -%}{{ form.body }}{%- endif -%}"
        ></textarea>
        <label for="ContactFormMessage-{{ section.id }}">{{ settings.quote_message }}</label>
      </div>
      {% assign collection = settings.quote_collection | default: settings.collection_products %}
      {% unless collection %}
        {% assign collection = collections.first %}
      {% endunless %}
      <div class="grid__item">
        <input
          hidden
          class="hide"
          name="contact[products]"
          value=""
        >
        <div
          style="
            display: flex;
            gap: 0.3em;
            flex-wrap: wrap;
          "
        >
          {% for product in collection.products %}
            <label style="display:block">
              <input
                hidden
                type="checkbox"
                class="hide"
                name="contact[product]"
                value="{{ product.title }}:{{ product.first_available_variant.sku }}"
              >
              {% assign title = product.metafields.custom.menu_title.value | default: product.title %}
              {% assign subtitle = product.metafields.custom.menu_subtitle.value
                | default: product.metafields.custom.subtitle
              %}
              {% assign image = product.metafields.custom.menu_image.value | default: product.featured_image %}
              <div class="product-item">
                <div class="product-item_image">
                  {{ image | image_url: width: 300 | image_tag: class: '', loading: 'lazy' }}
                </div>
                <div class="product-item_content">
                  <div class="product-item_title">{{ title }}</div>
                </div>
              </div>
            </label>
          {% endfor %}
        </div>
        <label style="display:block" for="ContactFormMessage-{{ section.id }}">
          {{- settings.quote_interested_booths -}}
        </label>
      </div>
      <div class="submit-btn-wrap grid__item">
        <div>
          <button
            type="submit"
            class="btn"
            onclick="umami.track('quote_submit')"
          >
            {{ settings.quote_submit_btn }}
          </button>
        </div>
      </div>
    </div>
  {%- endform -%}
  <script>
    (() => {
      function logSubmit(event) {
        event.preventDefault();
        try {
          console.log(`Form Submitted! Timestamp: ${event.timeStamp}`, event);
          let data = {
            create_at: new Date().toISOString(),
            products: [],
          };
          new FormData(event.target).forEach((value, key) => {
            console.log(key, value);
            if (key === 'contact[product]') {
              let [title, sku] = value.split(':');
              data.products.push({
                title,
                sku,
                quantity: 1,
              });
            } else {
              data[key] = value;
            }
          });
          console.log({ data });
          let stringproducts = JSON.stringify(data.products);
          if (form.elements['contact[products]']) {
            form.elements['contact[products]'].value = stringproducts;
          }
          fetch('https://hooks.zapier.com/hooks/catch/14043376/248z11w/', {
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            method: 'POST',
            mode: 'no-cors',
            body: JSON.stringify(data),
          })
            .then(function (res) {
              console.log(res, data);
            })
            .catch(function (res) {
              console.log(res, data);
            });
          fetch('https://n8n.soundboxstore.com/webhook/subscribe', {
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            method: 'POST',
            mode: 'no-cors',
            body: JSON.stringify(data),
          })
            .then(function (res) {
              console.log(res, data);
            })
            .catch(function (res) {
              console.log(res, data);
            });
        } catch (err) {
          console.error(err);
        }
        event.target.submit();
      }
      const form = document.getElementById('{{- form_id -}}');
      form.addEventListener('submit', logSubmit);
    })();
  </script>
</div>
