{% assign thankpageurl = pages.thankpage.url | default: '/pages/thankpage' | escape %}
<div id="{{form_id}}-wrap">
  {%- form 'contact', id: form_id, class: 'target:ring-3', return_to: thankpageurl -%}
    {{ form.errors | default_errors }}
    <input
      hidden
      type="text"
      placeholder="{{  settings.quote_full_name }}"
      class="input-full input hide"
      name="contact[subject]"
      value="NEW CUSTOMER QUOTE REQUEST"
    >
    <div class="grid grid--small">
      <div class="grid__item">
        <input
          type="text"
          required
          placeholder="{{  settings.quote_full_name }}"
          class="input-full input"
          name="contact[Full name]"
          autocapitalize="words"
          value=""
        >
        <label for="ContactFormName-{{ section.id }}">{{ settings.quote_full_name }}</label>
      </div>
      <div class="grid__item">
        <input
          class="input-full input"
          autocomplete="email"
          type="email"
          required
          id="ContactForm-email"
          class="field__input"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"aria-describedby="ContactForm-email-error"
          {% endif -%}
          placeholder="{{  settings.quote_email }}"
        >
        <label for="ContactFormEmail-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
      </div>
      {% assign phone_example = 'strings.others.phone_example' | t %}
      <style>
        .countryphonecode-selector {
          font-size: 0.85em;
          cursor: pointer;
        }
      </style>
      <div class="grid__item" style="display: none;">
        <div
          style="position: relative;"
        >
          <select
            class="countryphonecode-selector"
            name="contact[Mobile country code]"
            style="
              position: absolute;
              left: 1px;
              top: 1px;
              bottom: 1px;
              border: none;
              border-right: 1px solid;
              background: white;
              padding: 0 4px;
              width: 76px;
            "
          >
            <option {% if localization.country.iso_code == 'GB' %}selected{% endif %} value="+44">🇬🇧 +44</option>
            <option {% if localization.country.iso_code == 'IE' %}selected{% endif %} value="+353">🇮🇪 +353</option>
            <option {% if localization.country.iso_code == 'AE' %}selected{% endif %} value="+971">🇦🇪 +971</option>
            <option {% if localization.country.iso_code == 'US' %}selected{% endif %} value="+1">🇺🇸 +1</option>
            <option {% if localization.country.iso_code == 'DK' %}selected{% endif %} value="+45">🇩🇰 +45</option>
            <option {% if localization.country.iso_code == 'SE' %}selected{% endif %} value="+46">🇸🇪 +46</option>
            <option {% if localization.country.iso_code == 'DE' %}selected{% endif %} value="+49">🇩🇪 +49</option>
            <option {% if localization.country.iso_code == 'NO' %}selected{% endif %} value="+47">🇳🇴 +47</option>
            <option {% if localization.country.iso_code == 'FR' %}selected{% endif %} value="+33">🇫🇷 +33</option>
            <option {% if localization.country.iso_code == 'NL' %}selected{% endif %} value="+31">🇳🇱 +31</option>
            <option {% if localization.country.iso_code == 'BE' %}selected{% endif %} value="+32">🇧🇪 +32</option>
            <option {% if localization.country.iso_code == 'AT' %}selected{% endif %} value="+43">🇦🇹 +43</option>
            <option {% if localization.country.iso_code == 'CH' %}selected{% endif %} value="+41">🇨🇭 +41</option>
            <option {% if localization.country.iso_code == 'ES' %}selected{% endif %} value="+34">🇪🇸 +34</option>
            <option {% if localization.country.iso_code == 'FI' %}selected{% endif %} value="+358">🇫🇮 +358</option>
            <option {% if localization.country.iso_code == 'PL' %}selected{% endif %} value="+48">🇵🇱 +48</option>
            <option {% if localization.country.iso_code == 'IT' %}selected{% endif %} value="+39">🇮🇹 +39</option>
            <option {% if localization.country.iso_code == 'CA' %}selected{% endif %} value="+1">🇨🇦 +1</option>
          </select>

          <input
            style="padding-left:84px"
            type="tel"
            autocomplete="tel"
            id="ContactFormPhone-{{ section.id }}"
            class="input-full input"
            name="contact[Mobile number]"
            placeholder="{{  settings.quote_mobile_number }}. {{ phone_example }}"
            pattern="[0-9\s\-\(\)\+]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          >
          <label for="ContactFormPhone-{{ section.id }}">{{ settings.quote_mobile_number }}</label>
          <label for="ContactFormPhone-">Mobile number</label>
          <script>
            (() => {
              let s = document.querySelector('[name="contact[Mobile country code]"]');
              let i = document.querySelector('[name="contact[Mobile number]"]');
              s.addEventListener('change', (e) => {
                i.placeholder = e.target.value + ' ...';
              });
            })();
          </script>
        </div>
      </div>
      <div class="grid__item">
        <div
          style="position: relative;"
        >
          <select
            class="countryphonecode-selector"
            name="contact[Office Phone country code]"
            style="
              position: absolute;
              left: 1px;
              top: 1px;
              bottom: 1px;
              border: none;
              border-right: 1px solid;
              background: white;
              padding: 0 4px;
              width: 76px;
            "
          >
            <option {% if localization.country.iso_code == 'GB' %}selected{% endif %} value="+44">🇬🇧 +44</option>
            <option {% if localization.country.iso_code == 'IE' %}selected{% endif %} value="+353">🇮🇪 +353</option>
            <option {% if localization.country.iso_code == 'AE' %}selected{% endif %} value="+971">🇦🇪 +971</option>
            <option {% if localization.country.iso_code == 'US' %}selected{% endif %} value="+1">🇺🇸 +1</option>
            <option {% if localization.country.iso_code == 'DK' %}selected{% endif %} value="+45">🇩🇰 +45</option>
            <option {% if localization.country.iso_code == 'SE' %}selected{% endif %} value="+46">🇸🇪 +46</option>
            <option {% if localization.country.iso_code == 'DE' %}selected{% endif %} value="+49">🇩🇪 +49</option>
            <option {% if localization.country.iso_code == 'NO' %}selected{% endif %} value="+47">🇳🇴 +47</option>
            <option {% if localization.country.iso_code == 'FR' %}selected{% endif %} value="+33">🇫🇷 +33</option>
            <option {% if localization.country.iso_code == 'NL' %}selected{% endif %} value="+31">🇳🇱 +31</option>
            <option {% if localization.country.iso_code == 'BE' %}selected{% endif %} value="+32">🇧🇪 +32</option>
            <option {% if localization.country.iso_code == 'AT' %}selected{% endif %} value="+43">🇦🇹 +43</option>
            <option {% if localization.country.iso_code == 'CH' %}selected{% endif %} value="+41">🇨🇭 +41</option>
            <option {% if localization.country.iso_code == 'ES' %}selected{% endif %} value="+34">🇪🇸 +34</option>
            <option {% if localization.country.iso_code == 'FI' %}selected{% endif %} value="+358">🇫🇮 +358</option>
            <option {% if localization.country.iso_code == 'PL' %}selected{% endif %} value="+48">🇵🇱 +48</option>
            <option {% if localization.country.iso_code == 'IT' %}selected{% endif %} value="+39">🇮🇹 +39</option>
            <option {% if localization.country.iso_code == 'CA' %}selected{% endif %} value="+1">🇨🇦 +1</option>
          </select>
          <input
            style="padding-left:84px"
            type="tel"
            required
            autocomplete="tel"
            id="ContactFormPhone-{{ section.id }}"
            class="input-full input"
            name="contact[Office Phone number]"
            pattern="[0-9\s\-\(\)\+]*"
            placeholder="{{  settings.quote_phone_number }}. {{ phone_example }}"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          >
          <label for="ContactFormPhone-{{ section.id }}">{{ settings.quote_phone_number }}</label>
          <script>
            (() => {
              let s = document.querySelector('[name="contact[Office Phone country code]"]');
              let i = document.querySelector('[name="contact[Office Phone number]"]');
              s.addEventListener('change', (e) => {
                i.placeholder = e.target.value + ' ...';
              });
            })();
          </script>
        </div>
      </div>

      <div class="grid__item">
        <input
          required
          id="ContactFormAddress-{{ section.id }}"
          class="input-full input"
          name="contact[address]"
          placeholder="{{ 'contact.form.address' | t }}"
        >
        <label for="ContactFormPhone-{{ section.id }}">{{ 'contact.form.address' | t }}</label>
      </div>
      <div class="grid__item">
        <input
          type="text"
          required
          placeholder="{{  settings.quote_company_name }}"
          class="input-full input"
          name="contact[Company name]"
          autocapitalize="words"
          value=""
        >
        <label for="ContactFormName-{{ section.id }}">{{ settings.quote_company_name }}</label>
      </div>

      <div class="grid__item">
        <select
          type="text"
          required
          placeholder="{{ settings.quote_country }}"
          class="input-full input"
          name="contact[Country/Region]"
          style="    appearance: auto;"
          value="{{ localization.country.iso_code }}"
        >
          {% assign countrymap = 'GB en,
IE ie /en-ie,
US en /en-us,
DK da /da-dk,
SE se /sv-se,
DE de /de-de,
NO no /no-no,
FR fr /fr-fr,
NL nl /nl-nl,
BE nl /nl-be show,
BE fr /fr-be show,
AT de /de-at,
CH de /de-ch,
ES es /es-es,
FI fi /fi-fi,
PL pl /pl-pl,
IT it /it-it' %}

          {% assign contrylangs = countrymap | split: ',' %}
          {%- for contrylang in contrylangs -%}
            {% assign contrylangarray = contrylang | split: ' ' %}
            {% assign contrycode = contrylangarray[0] %}
            {% assign country = localization.available_countries | where: 'iso_code', contrycode | first %}
            {% unless country %}
              {% continue %}
            {% endunless %}
            <option
              value="{{ country.iso_code }}"
              {% if localization.country.iso_code == country.iso_code %}
                selected
              {% endif %}
            >
              {{ country.name }}
            </option>
          {%- endfor -%}
          <option value="other">Other</option>
        </select>
        <label for="ContactFormName-{{ section.id }}">{{ settings.quote_country }}</label>
      </div>
      <div
        class="grid__item"
        style="display: grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));  gap: 1em; max-width: 410px;"
      >
        <input type="hidden" name="contact[tags]" value="quote-request">
        <input type="hidden" name="contact[context]" value="quote-request-header">
        <input type="hidden" name="contact[gclid]" id="quote-form-gclid" value="">
        <div class="">
          <input
            class="input-full input"
            required
            id="ContactForm-city"
            class="field__input"
            name="contact[city]"
            value=""
            aria-required="true"
            placeholder="{{  'customer.addresses.city' | t }}"
          >
          <label for="ContactFormCity-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
        </div>
        <div class="">
          <input
            class="input-full input"
            required
            id="ContactForm-postcode"
            class="field__input"
            name="contact[postcode]"
            value=""
            aria-required="true"
            placeholder="{{ 'contact.form.postcode' | t }}"
          >
          <label for="ContactFormPostcode-{{ section.id }}">{{ 'contact.form.postcode' | t }}</label>
        </div>
      </div>
      <div class="grid__item">
        <textarea
          rows="5"
          id="ContactFormMessage-{{ section.id }}"
          class="input-full input"
          placeholder="{{ settings.quote_message }}"
          name="contact[body]"
          value="{%- if form.body -%}{{ form.body }}{%- endif -%}"
        ></textarea>
        <label for="ContactFormMessage-{{ section.id }}">{{ settings.quote_message }}</label>
      </div>
      {% assign collection = settings.quote_collection | default: settings.collection_products %}
      {% unless collection %}
        {% assign collection = collections.first %}
      {% endunless %}
      <div class="grid__item" id="{{form_id}}-products-wrap">
        <input
          hidden
          class="hide"
          name="contact[products]"
          value=""
        >
        <div
          style="
            display: flex;
            gap: 0.3em;
            flex-wrap: wrap;
          "
        >
          {% for product in collection.products %}
            <label style="display:block">
              <input
                hidden
                type="checkbox"
                class="hide"
                name="contact[product]"
                value="{{ product.title }}:{{ product.first_available_variant.sku }}"
              >
              {% assign title = product.metafields.custom.menu_title.value | default: product.title %}
              {% assign subtitle = product.metafields.custom.menu_subtitle.value
                | default: product.metafields.custom.subtitle
              %}
              {% assign image = product.metafields.custom.menu_image.value | default: product.featured_image %}
              <div class="product-item">
                <div class="product-item_image">
                  {{ image | image_url: width: 300 | image_tag: class: '', loading: 'lazy' }}
                </div>
                <div class="product-item_content">
                  <div class="product-item_title">{{ title }}</div>
                </div>
              </div>
            </label>
          {% endfor %}
        </div>
        <label style="display:block" for="ContactFormMessage-{{ section.id }}">
          {{- settings.quote_interested_booths -}}
        </label>
        <p id="{{form_id}}-products-error" style="color:red;font-size:0.85em;margin-top:0.3em;display:none;">
          Please select at least one product
        </p>
      </div>
      <div class="submit-btn-wrap grid__item">
        <div>
          <button
            type="submit"
            class="btn"
          >
            {{ settings.quote_submit_btn }}
          </button>
        </div>
      </div>
    </div>
  {%- endform -%}
  <script>
    (() => {
      // Helper to get gclid from various sources (matches MerakiQuote plugin approach)
      function getGclid() {
        try {
          // Priority: URL param > localStorage > cookie
          const urlParams = new URLSearchParams(window.location.search);
          const fromUrl = urlParams.get('gclid') || urlParams.get('_gcl_aw');
          if (fromUrl) return fromUrl;

          const fromStorage = localStorage.getItem('_gcl_aw');
          if (fromStorage) return fromStorage;

          // Try cookie as fallback
          const cookies = document.cookie.split(';');
          for (let c of cookies) {
            const [name, val] = c.trim().split('=');
            if (name === '_gcl_aw') return val.split('.').pop();
          }
        } catch (e) {}
        return '';
      }

      // Gate to block form.submit() calls from external scripts when validation fails
      let productValidationPassed = false;

      function logSubmit(event) {
        event.preventDefault();
        event.stopImmediatePropagation();

        // Validate at least one product is selected
        const productCheckboxes = form.querySelectorAll('input[name="contact[product]"]:checked');
        const productsError = document.getElementById('{{form_id}}-products-error');
        const productsWrap = document.getElementById('{{form_id}}-products-wrap');
        if (productCheckboxes.length === 0) {
          productValidationPassed = false;
          if (productsError) productsError.style.display = 'block';
          if (productsWrap) productsWrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        productValidationPassed = true;
        if (productsError) productsError.style.display = 'none';

        try {
          console.log(`Form Submitted! Timestamp: ${event.timeStamp}`, event);

          // Get gclid for Google Ads attribution
          const gclid = getGclid();

          // Set the hidden field value
          const gclidField = document.getElementById('quote-form-gclid');
          if (gclidField) {
            gclidField.value = gclid;
          }

          let data = {
            create_at: new Date().toISOString(),
            products: [],
            gclid: gclid,
            _gcl_aw: gclid, // For consistency with MerakiQuote plugin
          };
          new FormData(event.target).forEach((value, key) => {
            console.log(key, value);
            if (key === 'contact[product]') {
              let [title, sku] = value.split(':');
              data.products.push({
                title,
                sku,
                quantity: 1,
              });
            } else {
              data[key] = value;
            }
          });
          console.log({ data });
          console.log('[QuoteForm] gclid:', gclid || 'none');
          let stringproducts = JSON.stringify(data.products);
          if (form.elements['contact[products]']) {
            form.elements['contact[products]'].value = stringproducts;
          }
          fetch('https://n8n.soundboxstore.com/webhook/form-to-zoho', {
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            method: 'POST',
            mode: 'no-cors',
            body: JSON.stringify(data),
          })
            .then(function (res) {
              console.log(res, data);
            })
            .catch(function (res) {
              console.log(res, data);
            });

          // Send to Brevo worker for email marketing
          fetch('https://brevo-subscribe.soundboxstore.com/quote', {
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            method: 'POST',
            body: JSON.stringify(data),
          })
            .then(function (res) {
              console.log('Brevo worker response:', res);
            })
            .catch(function (err) {
              console.log('Brevo worker error:', err);
            });

          // Analytics tracking
          var customerData = {
            form_id: 'header-quote-form',
            email: data['contact[email]'] || '',
            name: data['contact[Full name]'] || '',
            first_name: (data['contact[Full name]'] || '').split(' ')[0] || '',
            last_name: (data['contact[Full name]'] || '').split(' ').slice(1).join(' ') || '',
            company: data['contact[Company name]'] || '',
            phone: data['contact[Mobile number]'] || data['contact[Phone]'] || '',
            postcode: data['contact[postcode]'] || '',
            city: data['contact[city]'] || '',
            country: data['contact[Country/Region]'] || '',
            gclid: gclid,
            landing_page: window.location.pathname,
            page_path: window.location.pathname,
            products: (data.products || []).map(function(item) {
              return {
                product_name: item.title || '',
                sku: item.sku || '',
                variant: '',
                quantity: item.quantity || 1,
                price: ''
              };
            })
          };

          // Shared dedup flag: blocks duplicate generate_lead across theme tracking
          // paths (quote-tracking.liquid interceptor, pushGenerateLead, etc.)
          var SUBMIT_FLAG = 'qt_lead_submitted';
          var alreadyFired = false;
          try { alreadyFired = sessionStorage.getItem(SUBMIT_FLAG) === 'true'; } catch (e) {}

          if (!alreadyFired) {
            // Supabase lead write (always runs, independent of Umami)
            try {
              if (typeof window.sbsSubmitLead === 'function') {
                window.sbsSubmitLead(customerData);
              }
            } catch (e) {
              console.error('[HeaderQuoteForm] sbsSubmitLead error:', e);
            }

            // Umami analytics (best-effort, may be blocked by ad-blockers)
            try {
              if (typeof umami !== 'undefined') {
                umami.track('generate_lead', customerData);
                console.log('[HeaderQuoteForm] Umami generate_lead fired with customer data:', customerData);
              }
            } catch (e) {
              console.error('[HeaderQuoteForm] Umami tracking error:', e);
            }

            // dataLayer push for GTM (generate_lead event) — GTM fires the GA4 tag
            // from this push. Do NOT also call gtag() directly: double-fires GA4.
            try {
              if (typeof window !== 'undefined' && window.dataLayer) {
                window.dataLayer.push({
                  'event': 'generate_lead',
                  'customer_email': customerData.email || '',
                  'customer_phone': customerData.phone || '',
                  'customer_country': customerData.country || '',
                  'customer_company': customerData.company || '',
                  'customer_name': customerData.name || '',
                  'form_id': 'header-quote-form',
                  'form_title': 'Header Quote Form',
                  'gclid': gclid || '',
                  // Enhanced Conversions user_data
                  'user_data': {
                    'email': customerData.email || '',
                    'phone_number': customerData.phone || '',
                    'address': {
                      'country': customerData.country || '',
                      'city': customerData.city || '',
                      'postal_code': customerData.postcode || ''
                    }
                  }
                });
                console.log('[HeaderQuoteForm] dataLayer.push generate_lead fired');
              }
            } catch (e) {
              console.error('[HeaderQuoteForm] dataLayer tracking error:', e);
            }

            try { sessionStorage.setItem(SUBMIT_FLAG, 'true'); } catch (e) {}
          } else {
            console.log('[HeaderQuoteForm] generate_lead skipped - already fired');
          }
        } catch (err) {
          console.error(err);
        }
        // Only submit if products are selected (re-check as safety net)
        if (form.querySelectorAll('input[name="contact[product]"]:checked').length > 0) {
          event.target.submit();
        }
      }
      const form = document.getElementById('{{- form_id -}}');
      form.addEventListener('submit', logSubmit);

      // Override form.submit() to enforce product validation
      // This prevents external scripts (Shopify apps, injected JS) from bypassing our validation
      const originalSubmit = form.submit.bind(form);
      form.submit = function() {
        if (!productValidationPassed) {
          console.warn('[QuoteForm] Blocked form.submit() — no products selected');
          return;
        }
        originalSubmit();
      };

      // Clear product validation error when a product is selected
      form.querySelectorAll('input[name="contact[product]"]').forEach(cb => {
        cb.addEventListener('change', () => {
          const err = document.getElementById('{{form_id}}-products-error');
          if (err && form.querySelectorAll('input[name="contact[product]"]:checked').length > 0) {
            err.style.display = 'none';
          }
        });
      });
    })();
  </script>
</div>
