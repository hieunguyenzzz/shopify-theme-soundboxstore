<a href="{{ url }}" class="collection-product-item">
  <div class="image ">
    {% if image %}
      {{
        image
        | image_url: width: 400
        | image_tag: widths: '400, 600, 900', loading: 'lazy', class: 'js-lazy-image', alt: title
      }}
    {% endif %}
    {% if image_2 %}
      {{
        image_2
        | image_url: width: 400
        | image_tag: widths: '400, 600, 900', loading: 'lazy', class: 'js-lazy-image', alt: title
      }}
    {% endif %}
  </div>
  <div class="content">
    <div>
      <h3>{{ title }}</h3>
      <div class="subtitle">{{ subtitle }}</div>
    </div>
  </div>
</a>
