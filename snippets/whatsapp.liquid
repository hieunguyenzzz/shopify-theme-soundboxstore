{% if settings.whatsapp_phone_number %}
  {% assign whatsapp_url = 'https://wa.me/' | append: settings.whatsapp_phone_number %}
  {% assign whatsapp_url = whatsapp_url | replace: '+', '' %}
  {% assign whatsapp_url = whatsapp_url | replace: ' ', '' %}
  <style>
    /* Move Zoho chat widget to accommodate WhatsApp button */
    .zsiq_theme1.zsiq_floatmain {
        right: 80px;
    }

    /* Hide Zoho chat prompt text on mobile - reduce clutter */
    @media screen and (max-width: 768px) {
      .zsiq_theme1 .zsiq_cnt,
      .zsiq_theme1.zsiq_floatmain .zsiq_flt_rel {
        display: none !important;
      }
      .zsiq_theme1.zsiq_floatmain {
        right: 70px;
        bottom: 10px;
      }
    }

    .whatsapp_url {
      box-shadow: 0 4px 8px rgba(37, 211, 102, 0.3);
      padding: 3px;
      width: 60px;
      border-radius: 60px;
      height: 60px;
      font-size: 14px;
      background-color: #328a59;
      background: transparent;
      line-height: 100%;
      display: block;
      position: fixed;
      bottom: 10px;
      right: 10px;
      background-image: url(https://cdn.shopify.com/s/files/1/0631/9892/0929/files/whatsapp.png?v=1756367938);
      background-size: 60px 60px;
      z-index: 3;
      border: 0;
    }

    /* Smaller WhatsApp button on mobile */
    @media screen and (max-width: 768px) {
      .whatsapp_url {
        width: 50px;
        height: 50px;
        background-size: 50px 50px;
        bottom: 8px;
        right: 8px;
      }
    }

    .whatsapp_url:hover {
        box-shadow: 1px 1px 8px -1px #aaa;
    }
  </style>
  <a
    class="whatsapp_url"
    style=""
    target="_blank"
    href="{{whatsapp_url}}"
  ></a>
{% endif %}
