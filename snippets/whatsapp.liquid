{% if settings.whatsapp_phone_number %}
  {% assign whatsapp_url = 'https://wa.me/' | append: settings.whatsapp_phone_number %}
  {% assign whatsapp_url = whatsapp_url | replace: '+', '' %}
  {% assign whatsapp_url = whatsapp_url | replace: ' ', '' %}
  <a style="display:none" target="_blank" href="{{ whatsapp_url }}"
    ><strong>Whatsapp: </strong> {{ settings.whatsapp_phone_number -}}
  </a>
{% endif %}
