{% if settings.whatsapp_phone_number %}
  {% assign whatsapp_url = 'https://wa.me/' | append: settings.whatsapp_phone_number %}
  {% assign whatsapp_url = whatsapp_url | replace: '+', '' %}
  {% assign whatsapp_url = whatsapp_url | replace: ' ', '' %}
  <a
    style="position: relative;padding: 3px;width: 60px;border-radius: 60px;height: 60px;font-size: 14px;background-color: #328a59;background: transparent;line-height: 100%;display: block;position: fixed;bottom: 10px;left: 10px;background-image: url(https://cdn.shopify.com/s/files/1/0631/9892/0929/files/whatsapp.png?v=1756367938);background-size: 58px 58px;z-index: 3;border: 1px solid white;"
    target="_blank"
    href="{{whatsapp_url}}"
  ></a>
{% endif %}
