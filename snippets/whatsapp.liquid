{% if settings.whatsapp_phone_number %}
  {% assign whatsapp_url = 'https://wa.me/' | append: settings.whatsapp_phone_number %}
  {% assign whatsapp_url = whatsapp_url | replace: '+', '' %}
  {% assign whatsapp_url = whatsapp_url | replace: ' ', '' %}
  <style>
    .zsiq_theme1.zsiq_floatmain {
        right: 80px;
    }
    .whatsapp_url{
        box-shadow: 0 4px 8px rgba(37, 211, 102, 0.3);position: relative;padding: 3px;width: 60px;border-radius: 60px;height: 60px;font-size: 14px;background-color: #328a59;background: transparent;line-height: 100%;display: block;position: fixed;bottom: 10px;right: 10px;background-image: url(https://cdn.shopify.com/s/files/1/0631/9892/0929/files/whatsapp.png?v=1756367938);background-size: 60px 60px;z-index: 3;border:0
    }
    .whatsapp_url:hover {
        box-shadow: 1px 1px 8px -1px #aaa;
    }
  </style>
  <a
    class="whatsapp_url"
    style=""
    target="_blank"
    href="{{whatsapp_url}}"
  ></a>
{% endif %}
