<div class="product-block variant_picker" style="width:100%">
  <div class="variant-wrapper">
    <label class="variant__label" for="ProductSelect-template--19970960589025__main-7836616818913-option-0">
      Choose your plan
    </label>
    <div
      class="variant-input-wrap"
      name="Furniture"
      data-index="option3"
      data-handle="furniture"
      id="ProductSelect-template--19970972549345__main-7587394781409-option-2"
    >
      <div
        class="variant-input "
        data-index="option3"
        data-value="With Furniture"
        data-trvalue="White / Dark Grey / With Furniture"
      >
        <input
          type="radio"
          form="AddToCartForm-template--19970972549345__main-7587394781409"
          checked="checked"
          value="With Furniture"
          data-index="option3"
          name="Furniture"
          data-variant-input=""
          class=""
          id="ProductSelect-template--19970972549345__main-7587394781409-option-furniture-With+Furniture"
          data-gtm-form-interact-field-id="2"
        >
        <label
          for="ProductSelect-template--19970972549345__main-7587394781409-option-furniture-With+Furniture"
          class="variant__button-label"
        >
          With Furniture

          <span>Stool / Device Shelf</span></label
        >
      </div>

      <div
        class="variant-input "
        data-index="option3"
        data-value="No Furniture"
        data-trvalue="White / Dark Grey / No Furniture"
      >
        <input
          type="radio"
          form="AddToCartForm-template--19970972549345__main-7587394781409"
          value="No Furniture"
          data-index="option3"
          name="Furniture"
          data-variant-input=""
          class=""
          id="ProductSelect-template--19970972549345__main-7587394781409-option-furniture-No+Furniture"
          data-gtm-form-interact-field-id="1"
        >
        <label
          for="ProductSelect-template--19970972549345__main-7587394781409-option-furniture-No+Furniture"
          class="variant__button-label"
        >
          No Furniture
        </label>
      </div>
    </div>
    <div>
      <span
        data-product-price
        class="product__price{% if current_variant.compare_at_price > current_variant.price %} on-sale{% endif %}"
      >
        {%- unless product.empty? -%}
          {%- render 'price' with current_variant.price -%}
        {%- else -%}
          {%- render 'price' with 1999 -%}
        {%- endunless -%}
        {%- if shop.taxes_included -%}
          <span class="vat_text">(INC VAT)</span>
        {%- endif -%}
      </span>
      {%- assign hide_sale_price = true -%}
      {%- if product.compare_at_price_max > product.price -%}
        {%- if current_variant.compare_at_price > current_variant.price -%}
          {%- assign hide_sale_price = false -%}
        {%- endif -%}
        <span
          data-a11y-price
          class="visually-hidden"
          aria-hidden="{{ hide_sale_price }}"
        >
          {{ 'products.general.regular_price' | t }}
        </span>
        <span
          data-product-price-wrap
          class="{% if hide_sale_price %} hide{% endif %}"
        >
          <span
            data-compare-price
            class="product__price product__price--compare"
          >
            {%- if current_variant.compare_at_price > current_variant.price -%}
              {%- render 'price' with current_variant.compare_at_price -%}
            {%- endif -%}
          </span>
        </span>
        <span data-compare-price-a11y class="visually-hidden">
          {{- 'products.general.sale_price' | t -}}
        </span>
      {%- else -%}
        <span
          id="PriceA11y-{{ section_id }}"
          class="visually-hidden"
        >
          {{- 'products.general.regular_price' | t -}}
        </span>
      {%- endif -%}
      {%- if shop.taxes_included -%}
        <span class="vat_text">(INC VAT)</span>
      {%- endif -%}
      <div
        data-unit-price-wrapper
        class="product__unit-price{% unless current_variant.unit_price_measurement %} hide{% endunless %}"
      >
        {%- capture unit_price_base_unit -%}
                          <span data-unit-base>
                            {%- if current_variant.unit_price_measurement -%}
                              {%- if current_variant.unit_price_measurement.reference_value != 1 -%}
                                {{ current_variant.unit_price_measurement.reference_value }}
                              {%- endif -%}
                              {{ current_variant.unit_price_measurement.reference_unit }}
                            {%- endif -%}
                          </span>
                        {%- endcapture -%}
        <span data-unit-price>
          {%- render 'price' with current_variant.unit_price -%}</span
        >/{{ unit_price_base_unit }}
      </div>
      {%- render 'product-leasing', current_variant: current_variant -%}
    </div>
  </div>
</div>
