  <script>
    function closePopup() {
      const popup = document.getElementById('popupOverlay');
      popup.style.animation = 'fadeOut 0.3s ease-out forwards';

      setTimeout(() => {
        popup.style.display = 'none';
      }, 50);
    }
    function product__leasing_openPopup() {
      const popup = document.getElementById('popupOverlay');
      popup.style.animation = 'fadeIn 0.3s ease-out forwards';
      setTimeout(() => {
        popup.style.display = 'flex';
      }, 50);
    }
    // Close popup when clicking outside
    document.getElementById('popupOverlay').addEventListener('click', function (e) {
      if (e.target === this) {
        closePopup();
      }
    });

    // Close popup with Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closePopup();
      }
    });

    // Add fadeOut animation
    const style = document.createElement('style');
    style.textContent = `
            @keyframes fadeOut {
                from { opacity: 1; }
                to { opacity: 0; }
            }
        `;
    document.head.appendChild(style);

    // ============================================
    // Leasing enquiry lead capture (SBS-311)
    // Reuses the shared n8n form-to-zoho endpoint + lead/consent helpers
    // (sbsMintLeadId / sbsReadConsent / sbsSubmitLead from quote-tracking.liquid),
    // so leasing leads flow through the same CRM pipeline but flagged form_type=leasing.
    // ============================================
    (function () {
      var form = document.getElementById('leasing-enquiry-form');
      if (!form) return;

      function getGclid() {
        try {
          var urlParams = new URLSearchParams(window.location.search);
          var fromUrl = urlParams.get('gclid') || urlParams.get('_gcl_aw');
          if (fromUrl) return fromUrl;
          var fromStorage = localStorage.getItem('_gcl_aw');
          if (fromStorage) return fromStorage;
        } catch (e) {}
        return '';
      }

      function readMonthlyPrice() {
        var lp = document.querySelector('#product__leasing-wrap input[name="leasing_price"]');
        return lp ? lp.value : '';
      }

      // Keep the variant label current as the shopper switches variants.
      document.addEventListener('variant:change', function (evt) {
        var v = evt.detail && evt.detail.variant;
        if (!v) return;
        var variantEl = document.getElementById('leasing-enquiry-variant');
        if (variantEl) variantEl.value = (v.title || '') + ' (SKU ' + (v.sku || '') + ')';
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;

        var submitBtn = form.querySelector('.leasing-submit-btn');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }

        var monthlyEl = document.getElementById('leasing-enquiry-monthly');
        if (monthlyEl) {
          var mp = readMonthlyPrice();
          monthlyEl.value = mp ? mp + ' /month' : '';
        }
        var gclid = getGclid();
        var gEl = document.getElementById('leasing-enquiry-gclid');
        if (gEl) gEl.value = gclid;

        var data = {
          created_at: new Date().toISOString(),
          source: 'product-leasing-enquiry',
          form_type: 'leasing',
          lead_source: 'Leasing',
          gclid: gclid,
          _gcl_aw: gclid
        };
        new FormData(form).forEach(function (value, key) {
          data[key] = value;
        });

        // SBS-11 / SBS-287: shared lead_id + Consentmo snapshot (same as other forms).
        var sbsLeadId = (typeof window.sbsMintLeadId === 'function') ? window.sbsMintLeadId() : '';
        if (sbsLeadId) data.lead_id = sbsLeadId;
        if (typeof window.sbsReadConsent === 'function') Object.assign(data, window.sbsReadConsent());
        if (sbsLeadId) data.transaction_id = sbsLeadId;

        // Boundary log with correlation id — no PII in the console.
        console.log('[LeasingEnquiry] submit', {
          lead_id: sbsLeadId,
          form_type: data.form_type,
          product: data['contact[Product title]'],
          monthly: data['contact[Indicative monthly price]']
        });

        fetch('https://n8n.soundboxstore.com/webhook/form-to-zoho', {
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          method: 'POST',
          mode: 'no-cors',
          body: JSON.stringify(data)
        })
          .then(function (res) { console.log('[LeasingEnquiry] n8n request sent', sbsLeadId); })
          .catch(function (err) { console.error('[LeasingEnquiry] n8n error', sbsLeadId, err); });

        try {
          if (typeof window.sbsSubmitLead === 'function') {
            window.sbsSubmitLead({ email: data['contact[email]'] });
          }
        } catch (err) {
          console.error('[LeasingEnquiry] dedup shim error', err);
        }

        // Popup context: show inline success, no navigation.
        form.style.display = 'none';
        var success = document.getElementById('leasing-enquiry-success');
        if (success) success.style.display = 'block';
      });
    })();
  </script>
{% endif %}
