  </section>

  <!-- SECTION 4: Mid CTA -->
  <section class="comp-mid-cta">
    <div class="comp-page-width">
      <h2>We could make this list much longer!</h2>
      <p><a href="/pages/schedule-a-callback">Talk to our team today</a> to see the full picture — or request a free sample.</p>
    </div>
  </section>

  <!-- SECTION 5: Testimonials -->
  <section class="comp-testimonials" id="comp-testimonials">
    <div class="comp-page-width">
      <div class="comp-split" style="align-items:start;">

        <!-- Left panel -->
        <div>
          <h2 class="comp-test-left-heading">What Our Customers Say</h2>
          <p class="comp-test-left-sub">Real reviews from real customers who switched to Soundbox Store.</p>
          <div class="comp-test-nav">
            <button class="comp-test-nav-btn" id="comp-prev" aria-label="Previous">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <div class="comp-test-dots">
              <div class="comp-test-dot active" data-idx="0"></div>
              <div class="comp-test-dot" data-idx="1"></div>
