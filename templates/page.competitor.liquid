            <tr><td class="feat-col">Connectivity</td><td class="hl">Ethernet + WiFi pass-through</td><td>WiFi only</td></tr>
            <tr><td class="feat-col">Warranty</td><td>5 years</td><td>2 years</td></tr>
            <tr><td class="feat-col">UK-Based Support</td><td>&#10003; Yes</td><td>&#10007; International only</td></tr>
            <tr><td class="feat-col">Sustainability</td><td class="hl">Recycled materials, carbon neutral shipping</td><td>Standard manufacturing</td></tr>
            <tr><td class="feat-col">Certifications</td><td>CE, UL, ISO 9001</td><td>CE</td></tr>
            <tr><td class="feat-col">Finance Options</td><td>0% interest available</td><td>Not offered</td></tr>
          </tbody>
