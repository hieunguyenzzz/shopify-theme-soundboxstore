<script src="https://cdn.tailwindcss.com"></script>
<style>
  html { scroll-behavior: smooth; }
  .competitor-page { font-family: inherit; }

  /* ---- Hero ---- */
  .comp-hero { background: #f0f4f0; }
  .comp-hero-card {
    background: #fff;
    border-radius: 12px;
    padding: 2.5rem 3rem;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
  }
  .comp-hero-heading {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 1rem;
    color: #1a1a1a;
  }
  .comp-hero-sub { color: #555; line-height: 1.6; margin: 0 0 1.5rem; }
  .comp-hero-btns { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.2rem; }
  .comp-btn-primary {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background: #5c6b3a;
    color: #fff !important;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: background 0.2s;
  }
  .comp-btn-primary:hover { background: #4a5630; color: #fff !important; }
  .comp-btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border: 2px solid #5c6b3a;
    color: #5c6b3a !important;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    background: transparent;
    transition: background 0.2s, color 0.2s;
  }
  .comp-btn-secondary:hover { background: #5c6b3a; color: #fff !important; }
  .comp-delivery-text {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.9rem; color: #555; margin: 0;
  }
  .comp-delivery-text svg { flex-shrink: 0; color: #5c6b3a; }

  /* ---- Features ---- */
  .comp-features { background: #fff; padding: 4rem 0; }
  .comp-features-heading { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; text-align: center; margin: 0 0 0.5rem; }
  .comp-features-sub { text-align: center; color: #666; max-width: 600px; margin: 0 auto 2.5rem; }
  .comp-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .comp-feature-card {
    background: #f7f8f5;
    border-radius: 12px;
    padding: 2rem;
  }
  .comp-feature-title { font-weight: 700; font-size: 1.1rem; margin: 0 0 0.5rem; color: #1a1a1a; }
  .comp-feature-body { color: #555; font-size: 0.95rem; line-height: 1.6; margin: 0; }

  /* ---- Comparison table ---- */
  .comp-table-section { background: #f4f4f2; padding: 4rem 0; }
  .comp-table-heading { font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800; text-align: center; margin: 0 0 2rem; }
  .comp-table-wrap { overflow-x: auto; border-radius: 12px; box-shadow: 0 2px 16px rgba(0,0,0,0.07); }
  .comp-table { border-collapse: collapse; width: 100%; font-size: clamp(13px, 1.8vw, 15px); }
  .comp-table th, .comp-table td { padding: 0.85em 1.2em; text-align: left; border-bottom: 2px solid #fff; }
  .comp-table thead th { background: #dadada; font-weight: 700; font-size: 1.05em; }
  .comp-table thead th:nth-child(2) { background: #5c6b3a; color: #fff; }
  .comp-table tbody tr:nth-child(even) td:not(.hl), .comp-table tbody tr:nth-child(even) th:not(.hl) { background: #eeeeee; }
  .comp-table tbody tr:nth-child(odd) td:not(.hl), .comp-table tbody tr:nth-child(odd) th:not(.hl) { background: #f4f4f4; }
  .comp-table .feat-col { font-weight: 600; color: #333; min-width: 10em; }
  .comp-table .hl { background: #5c6b3a !important; color: #fff !important; font-weight: 600; }
  .comp-table tbody td:last-child { color: #666; }
  .comp-table-footnote { font-size: 0.85rem; color: #888; text-align: center; margin-top: 1rem; }

  /* ---- Mid CTA ---- */
  .comp-mid-cta { background: #fff; padding: 3rem 0; text-align: center; }
  .comp-mid-cta h2 { font-size: clamp(1.3rem, 2.5vw, 1.9rem); font-weight: 800; margin: 0 0 0.75rem; }
  .comp-mid-cta p { color: #555; font-size: 1rem; }
  .comp-mid-cta a { color: #5c6b3a; font-weight: 600; }

  /* ---- Testimonials ---- */
  .comp-testimonials { background: #f0f4f0; padding: 4rem 0; }
  .comp-test-left-heading { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 0.75rem; line-height: 1.25; }
  .comp-test-left-sub { color: #555; margin: 0 0 2rem; }
  .comp-test-nav { display: flex; align-items: center; gap: 1rem; }
  .comp-test-nav-btn {
    width: 40px; height: 40px;
    border: 2px solid #5c6b3a; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; background: white; color: #5c6b3a;
    transition: background 0.2s, color 0.2s; flex-shrink: 0;
  }
  .comp-test-nav-btn:hover { background: #5c6b3a; color: #fff; }
  .comp-test-dots { display: flex; gap: 6px; align-items: center; }
  .comp-test-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #ccc; cursor: pointer; transition: background 0.2s;
  }
  .comp-test-dot.active { background: #5c6b3a; }
  .comp-test-card { display: none; }
  .comp-test-card.active { display: block; }
  .comp-test-card-inner {
    background: #fff; border-radius: 12px; padding: 2.5rem;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
  }
  .comp-test-stars { color: #f5a623; font-size: 1.3em; letter-spacing: 2px; margin-bottom: 1rem; }
  .comp-test-text { color: #333; font-size: 1.05rem; line-height: 1.7; margin: 0 0 1.25rem; }
  .comp-test-author { font-weight: 700; color: #1a1a1a; margin: 0; }

  /* ---- Layout helpers ---- */
  .comp-page-width { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .comp-split { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  @media (max-width: 768px) {
    .comp-split { grid-template-columns: 1fr; }
    .comp-hero-card { padding: 2rem 1.5rem; }
    .comp-features-grid { grid-template-columns: 1fr; }
    .comp-table thead th:nth-child(3) { display: none; }
    .comp-table tbody td:last-child { display: none; }
  }
</style>

<div class="competitor-page">

  <!-- SECTION 1: Hero -->
  <section class="comp-hero" style="padding: 3rem 0 2rem;">
    <div class="comp-page-width">
      <div class="comp-split">
