  <!-- SECTION 3: Comparison Table -->
  <section class="comp-table-section">
    <div class="comp-page-width">
      <h2 class="comp-table-heading">Soundbox Store vs Framery — Feature Comparison</h2>
      <div class="comp-table-wrap">
        <table class="comp-table">
          <thead>
            <tr>
              <th class="feat-col">Feature</th>
              <th>Quell Flex<br><span style="font-size:0.8em;font-weight:400;">from £4,995</span></th>
              <th>Framery One<br><span style="font-size:0.8em;font-weight:400;">from £8,500</span></th>
