    "product-icon-text-section": {"type": "Product-icon-text-section", "blocks": {"873c2214-06d5-4a5c-9edf-d70f57ff9a02": {"type": "icon-text-block", "settings": {"iconimage": "shopify://shop_images/door-icon.png", "text": "<p>Ships flat to your door</p>"}}, "e51b3a93-c310-46a3-86cf-031dccbc1192": {"type": "icon-text-block", "settings": {"iconimage": "shopify://shop_images/plug-play.png", "text": "<p>Plug & play</p>"}}, "2f4ce18f-fc46-4d16-ab85-52111f71d6a9": {"type": "icon-text-block", "settings": {"iconimage": "shopify://shop_images/space-icon.png", "text": "<p>Flexible to any space</p>"}}, "aff0d8c6-1f4e-4905-8c02-2071a65a5787": {"type": "icon-text-block", "settings": {"iconimage": "shopify://shop_images/fork1.png", "text": "<p>Movable</p>"}}}, "block_order": ["873c2214-06d5-4a5c-9edf-d70f57ff9a02", "e51b3a93-c310-46a3-86cf-031dccbc1192", "2f4ce18f-fc46-4d16-ab85-52111f71d6a9", "aff0d8c6-1f4e-4905-8c02-2071a65a5787"], "disabled": true, "settings": {}},
    "165656720859a9e8d5": {"type": "rich-text", "blocks": {"165656720836c7d25b-0": {"type": "heading", "settings": {"title": "Extra Large Access Meeting Booth"}}, "165656720836c7d25b-1": {"type": "text", "settings": {"enlarge_text": true, "text": "<p>Our large and extra-large access booths are thoughtfully designed with inclusivity in mind, ensuring comfort and accessibility for everyone. Ideal for meetings, events, or personal breaks, these booths cater to diverse needs, offering accessible, private, and comfortable spaces.</p><h3><strong>Key Features:</strong></h3><p><strong>DDA Compliant and Inclusive Meeting Spaces:</strong> Designed to meet diverse accessibility needs, including wheelchair access.</p><p><strong>Soundproof Meeting Booth:</strong> Advanced acoustic design ensures privacy and focus, ideal for busy environments.</p><p><strong>Customisable Options:</strong> Includes height-adjustable optional office chair, fold-down sofa bench.</p><p><strong>Accessible Button Design</strong>: \"Push to Open\" button for enhanced accessibility.</p><h3><strong>Spacious and Accessible Design</strong></h3><p><strong>Ample Space for Mobility:</strong> Designed for easy navigation and accommodating wheelchairs.</p><p><strong>Comfortable Group Use:</strong> Spacious enough for multiple users, suitable for group meetings or personal use.</p><h3><strong>Soundproof and Acoustic Design</strong></h3><p><strong>Enhanced Privacy:</strong> Soundproofing ensures a quiet atmosphere for meetings, video calls, and a focused, productive working environment.</p><p><strong>Acoustic Design:</strong> PET panels and toughened glass provide excellent sound insulation.</p><h3><strong>Inclusive and Adjustable Features</strong></h3><p><strong>Inclusive Design:</strong> Height-adjustable tables and chairs cater to various physical needs.</p><p><strong>Ergonomic Comfort:</strong> Optional pressure-relieving cushions and ergonomic seating available.</p><h3><strong>Friendly Environment</strong></h3><p><strong>Reduced Noise Levels:</strong> Soundproof panels prevent sensory overload, ideal for individuals with sensory processing disorders.</p><h3><strong>Advanced Communication Technology</strong></h3><p><strong>Accessible Video Conferencing:</strong> Includes assistive technology for seamless communication.</p><p><strong>Inclusive Tools:</strong> Features such as hearing loops, screen readers, and voice-activated systems ensure full participation.</p><h3><strong>Versatile Usage</strong></h3><p><strong>Multi-Purpose Design:</strong> Ideal for meetings, video calls, rest areas, and personal consultations.</p><p><strong>High-Traffic Compatibility:</strong> Suitable for offices, airports, conferences, and public events.</p><h3><strong>Safety and Privacy</strong></h3><p><strong>Enhanced Safety Features:</strong> Non-slip floors, safety rails, and emergency buttons ensure user safety.</p><p><strong>Privacy and Dignity:</strong> Includes private screens and accessible facilities for personal care needs.</p><p>For more information or to inquire about custom solutions, contact us today.</p>"}}}, "block_order": ["165656720836c7d25b-0", "165656720836c7d25b-1"], "settings": {"collapable": true, "align_text": "center", "narrow_column": false, "color_scheme": "none", "divider": false}},
    "meeting-rooms-features": {"type": "meeting-rooms-features", "blocks": {"82e4437d-c3ed-46e1-8f33-db6645f21ed8": {"type": "features_list_left", "settings": {"title": "Dimensions", "description": "<p><strong>Internal Size:</strong><br/>Height: 214cm Width: 204cm Depth: 210cm<strong><br/>External Size:</strong><br/>Height: 230cm Width: 220cm Depth: 213.6cm<br/><strong>Weight:<br/></strong>Total: 680kg (Pod)<strong><br/></strong>Total: 833kg (Pod+Furn. Set 1)<br/>Total: 761kg (Pod+Furn. Set 2)<br/></p>"}}, "d390db88-124b-4e53-b3e8-234749d7ec3a": {"type": "features_list_left", "settings": {"title": "Sound / Acoustics", "description": "<p><strong>Leading The Sound Pod Industry</strong><br/>STC 30dB (±5dB) &<br/>RT0.25s (±0.1s)<br/>Daiki Verified<br/>ISO 23351-1</p>"}}, "d3a6f941-b3fc-45f8-b5a6-c82167cfcad9": {"type": "features_list_left", "settings": {"title": "Materials", "description": "<p><strong>External Frame</strong><br/>Aviation Type Alloy, Cast Aluminium Corners<br/>Nanometer PP Finish<strong><br/>External Panels<br/></strong>Carbon Composite <br/>≤0.071kg CO2e<br/><strong>Glass<br/></strong>10mm Laminated Front & Back, Similar To High Speed Trains ≤0.4MJ<br/><strong>Damping Feet<br/></strong>Vibration control<br/><strong>Internally</strong> <br/>Acoustic PET board (Recycled Plastic Bottles)</p>"}}, "453c3266-3dfc-413c-a2c1-d76c8e57c79d": {"type": "features_list_left", "settings": {"title": "Ventilation", "description": "<p>Double Turbo Fan / 4 Inlet + 2 Outlets, Highly efficient airflow change rate at 551 m³/h (max) refreshing air every minute, guaranteeing excellent oxygen rates. A low-noise air system via multi-channel air ducts allows minimum noise disturbance inside and out.</p>"}}, "cb2a41ec-f379-4bf5-bcce-bde5e4db4e1a": {"type": "features_list_right", "settings": {"title": "Electrical / Lighting", "description": "<p>LED<br>*Square 4000k, 50Lx, Daylight <br>*Side Strips 4000k, 50Lx, Daylight <br>*Multiple Power Outlets, 220- 24V USB, USB-C<br>*Energy Saving Motion Sensor<br>*Ethernet (Cat 6) Connector </p><p>External LAN Port (Inlet) / Internal LAN Port (Outlet)</p><p>Ethernet cables not supplied</p><p>*Bluetooth Audio System</p><p>Requires connection to mains power through a standard wall socket. Supplied with a 1.8m cable. Please contact us for longer lengths.</p>"}}, "6b66cb21-f9e3-4ec5-89ed-37a0d24af348": {"type": "features_list_right", "settings": {"title": "Optional Furniture", "description": "<p>Optional Office Chair x2, Draw down soft open table. Furniture specifically built for these pods is an excellent option for functionality, comfort and style whilst allowing maximum space without feeling crowded. *monitor not included.</p>"}}, "19323c70-b1a6-44b1-b5b4-12733c55ae2e": {"type": "features_list_right", "settings": {"title": "Safety", "description": "<p><strong>Emergency Safety Hammer<br/></strong>Included For Internal Fitting<br/><strong>Fire Rated Foam<br/></strong>UK Fire foam where required.<strong> <br/>Sprinkler / Mains Fire Alarm<br/></strong>Laser cut (25mm) and usable if required<strong><br/>Formaldehyde Free<br/></strong>No wood or glue</p>"}}, "aade32d9-6806-430b-b9c3-07623b95803d": {"type": "features_list_right", "settings": {"title": "Sustainability", "description": "<p><strong>Recycled materials approx</strong><br/>≥180kg (12m²/0.66m³) each</p><p><strong>Carbon Footprint</strong><br/>≤0.071kg CO2e<br/><strong>Energy Consumption<br/></strong>≤0.4MJ</p>"}}, "features_list_right_iTJjBC": {"type": "features_list_right", "settings": {"title": "Pod Placement", "description": "<p>The placement of an acoustic pod can make a big difference to how well it performs. In spaces with high ceilings and large windows, positioning pods near a wall helps reduce echo.</p><p>It’s also important to leave enough space around the pod for proper airflow, and adding soft furnishings or plants nearby can further improve acoustics.</p><p>If you’re unsure where to place your pod, feel free to get in touch—our team will be happy to help you find the best spot.</p>"}}, "c21a0fde-facf-4d41-9329-1ea7cbfdac23": {"type": "feature_middle_image", "settings": {"middle-img": "shopify://shop_images/L1_white_lights_on.png"}}, "6cf7c02f-a050-4d80-8e04-8f288286c6d2": {"type": "hotspot_point", "settings": {"point_x": 11, "negative_y": false, "point_y": 3, "hotspot_title": "Dimensions"}}, "03433a09-09b3-4e6b-a6c9-e5517ee3f7e0": {"type": "hotspot_point", "settings": {"point_x": 22, "negative_y": false, "point_y": 35, "hotspot_title": "Sound / Acoustics"}}, "c081d9ee-3e16-4431-99a3-382ead340ee3": {"type": "hotspot_point", "settings": {"point_x": 45, "negative_y": false, "point_y": 7, "hotspot_title": "Electrical / Lighting"}}, "0a79d994-15ef-43ba-a0af-eb98f0f412e6": {"type": "hotspot_point", "settings": {"point_x": 84, "negative_y": false, "point_y": 3, "hotspot_title": "Materials"}}, "56703a54-a604-429c-942a-7aee94e66fa6": {"type": "hotspot_point", "settings": {"point_x": 49, "negative_y": false, "point_y": 1, "hotspot_title": "Ventilation"}}, "6a4c359c-9793-4187-9e54-0fb5fd26aaca": {"type": "hotspot_point", "settings": {"point_x": 48, "negative_y": false, "point_y": 64, "hotspot_title": "Optional Furniture"}}, "541c93a6-a6b0-47da-b38f-0e184ab84a18": {"type": "hotspot_point", "settings": {"point_x": 41, "negative_y": false, "point_y": 41, "hotspot_title": "Safety"}}, "d1f069e7-7a57-45bf-96af-c70758c98580": {"type": "hotspot_point", "settings": {"point_x": 87, "negative_y": false, "point_y": 44, "hotspot_title": "Sustainability"}}}, "block_order": ["82e4437d-c3ed-46e1-8f33-db6645f21ed8", "d390db88-124b-4e53-b3e8-234749d7ec3a", "d3a6f941-b3fc-45f8-b5a6-c82167cfcad9", "453c3266-3dfc-413c-a2c1-d76c8e57c79d", "cb2a41ec-f379-4bf5-bcce-bde5e4db4e1a", "6b66cb21-f9e3-4ec5-89ed-37a0d24af348", "19323c70-b1a6-44b1-b5b4-12733c55ae2e", "aade32d9-6806-430b-b9c3-07623b95803d", "features_list_right_iTJjBC", "c21a0fde-facf-4d41-9329-1ea7cbfdac23", "6cf7c02f-a050-4d80-8e04-8f288286c6d2", "03433a09-09b3-4e6b-a6c9-e5517ee3f7e0", "c081d9ee-3e16-4431-99a3-382ead340ee3", "0a79d994-15ef-43ba-a0af-eb98f0f412e6", "56703a54-a604-429c-942a-7aee94e66fa6", "6a4c359c-9793-4187-9e54-0fb5fd26aaca", "541c93a6-a6b0-47da-b38f-0e184ab84a18", "d1f069e7-7a57-45bf-96af-c70758c98580"], "settings": {"seo": "Experience This Phone Booth Yourself", "title": "Finer Details", "content": "<p>Design, Function & More</p>", "show_videos": true, "no_sound": false, "loop": false, "close_label": "Close door", "close_audio": "https://cdn.shopify.com/s/files/1/0631/9892/0929/files/Close-Audio_MP3.mp3?v=1667985721", "close_video": "https://cdn.shopify.com/videos/c/o/v/68ec373ad7a24bc397ee07bf1520b64a.mp4", "close_thumb": "", "open_label": "Open door", "open_audio": "https://cdn.shopify.com/s/files/1/0631/9892/0929/files/Open-Audio_MP3.mp3?v=1667985721", "open_video": "https://cdn.shopify.com/videos/c/o/v/80741e99a033410aaee8670d96c27eff.mp4", "open_thumb": "https://cdn.shopify.com/s/files/1/0631/9892/0929/files/close_image.png?v=1736148247"}},
    "ebf4881c-faca-44ef-a5ac-a577e1bf76cb": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/Accessible-Disability-Meeting-Booth-XL_7_e4d9deab-6ac0-49d3-bfb0-9750812fd756.png", "image_position": "right", "mobile_image_position": "top", "title": "Inclusive Worplaces", "detection": "<p>Our Inclusivity meeting booths allow flexibility in the workplace for all. Allowing for focused, productive meetings for all.</p>", "button_text": "", "button_link": ""}},
    "image_text_column_BVXazR": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/Disability_Booth_XL_Detail_02.png", "image_position": "left", "mobile_image_position": "top", "title": "Mindful In Design", "detection": "<p>Primarily an acoustic control company, technically engineers; design-wise, we are creators. Our furniture packs have been developed over years of trials and customer feedback: functional, comfortable, and organic design. Whilst still maintaining hardwearing upholstery, build quality and finish.</p>", "button_text": "", "button_link": ""}},
    "49a5198e-c7ce-4269-bf55-ad7c4f002a9d": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/Disability_Booth_XL_Detail_04.png", "image_position": "right", "mobile_image_position": "top", "title": "New, Upgraded Lighting", "detection": "<p>Soundbox Store now offers, as standard, additional LED strip lighting 4000k 50Lx Daylight, neatly designed on either side of the meeting and conference booths. Powered separately from the leading central light-creating task or ambient lighting.</p>", "button_text": "", "button_link": ""}},
    "1655472797be735185": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/Disability_Booth_XL_Detail_03.png", "image_position": "left", "mobile_image_position": "top", "title": "Easy Access Pad", "detection": "<p>Designed for accessibility, the door open button provides seamless entry for wheelchair users. The drop table ensures convenience and flexibility, making the space inclusive and user-friendly.</p>", "button_text": "", "button_link": ""}},
    "8281adaf-628d-4174-9d8a-c0e2b81add14": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/Disability_Booth_XL_Detail_01.png", "image_position": "right", "mobile_image_position": "top", "title": "Power + Bluetooth", "detection": "<p>UL & CE Certificated<br/>Bluetooth Control System with speaker, connect devices for calls, Zoom calls or music.<br/>Switches for LED lighting and ventilation power.<br/>Motion Sensor - Only use power when in use.<br/>1 * 220-240 Power Socket UK/ EU<br/>2 * USB DC 5V, 2.1A.<br/>1 * USB-C DC 5V, 2.1A.<br/>* Twice as many power outlets with furniture option.</p>", "button_text": "", "button_link": ""}},
    "acoustic-environment": {"type": "acoustic-environment", "disabled": true, "settings": {"bgcolor": "#e8e8e1", "heading": "Acoustic Environment", "subheading": "a comfortable workspace can", "description": "<p><strong>48%</strong> increase in employee focus,<br/><strong>10%</strong> fewer errors made,<br/><strong>27%</strong> reduction in stress level,<br/><strong>23%</strong> increase work efficiency,<br/><strong>21 %</strong> lower work fatigue...</p><p>By creating a workplace with a good acoustics environment, you can develop an office that workers will enjoy working within.</p>", "image": "shopify://shop_images/Why-Soundbox-13.jpg", "mobile_image": "shopify://shop_images/Why-Soundbox-30.jpg", "perameter_text": "<li>Focus</li>              <li>Errors</li>              <li>Stress</li>         <li>Efficiency</li><li>Fatigue</li>", "graphtitle": "<p>Sykes, David M., PhD., 2004, “Productivity: How Acoustics Affect Workers’ Performance in Open Areas”</p>"}},
    "subscribe_follow_aBVRhR": {"type": "main-collection-next", "blocks": {"28cea507-6689-4704-af63-50ae541df227": {"type": "email", "settings": {"title": "Thinking Outside The Box, Inside The Booth", "text": "<p>Stay ahead of the curve by subscribing to our newsletter. Don't miss out on exciting events, product launches, meet and greets, and valuable upgrades. Join our community and be a part of the workspace revolution.</p>", "image_bg": "shopify://shop_images/sbs-stn6-1-2-bg.jpg"}}, "b781bad8-6c0a-4ac9-86de-bedf4e1fdc25": {"type": "instagram", "settings": {"feed_id": "18121", "title": "Follow Us", "text": "<p><a href=\"https://www.instagram.com/soundboxstore/\" target=\"_blank\">@soundboxstore</a></p>", "image_bg": "shopify://shop_images/sbs-stn6-3-4-bg.jpg"}}}, "block_order": ["28cea507-6689-4704-af63-50ae541df227", "b781bad8-6c0a-4ac9-86de-bedf4e1fdc25"], "custom_css": [".main-collection-next {padding: 10;}", ".collection-template-grid {padding: 10; gap: 10;}"], "settings": {"collection": ""}},
