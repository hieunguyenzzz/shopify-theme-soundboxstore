    "1657348293dc4e4fd8": {"type": "rich-text", "blocks": {"165734829349367447-0": {"type": "heading", "settings": {"title": "{{ product.title }}"}}, "165734829349367447-1": {"type": "text", "settings": {"enlarge_text": true, "text": "<p>{{ product.metafields.custom.description | metafield_tag }}</p>"}}}, "block_order": ["165734829349367447-0", "165734829349367447-1"], "settings": {"collapable": true, "align_text": "center", "narrow_column": true, "color_scheme": "none", "divider": false}},
    "meeting-rooms-features": {"type": "meeting-rooms-features", "blocks": {"82e4437d-c3ed-46e1-8f33-db6645f21ed8": {"type": "features_list_left", "settings": {"title": "Dimensions", "description": "<p><strong>External Size:</strong><br/>Seat Height: 51cm to 74.5cm<br/>Diameter: Ø 34.5cm<strong><br/></strong></p>"}}, "453c3266-3dfc-413c-a2c1-d76c8e57c79d": {"type": "features_list_left", "settings": {"title": "Comfort", "description": "<p>Manufactured from the high quality materials, high-density moulded polyurethane foam seat, hard wearing yet great grip on rolling floor pad</p>"}}, "aade32d9-6806-430b-b9c3-07623b95803d": {"type": "features_list_right", "settings": {"title": "Sustainability", "description": "<p><strong>Recycled materials approx</strong><br/>≥180kg (12m²/0.66m³) each</p><p><strong>Carbon Footprint</strong><br/>≤0.071kg CO2e<br/><strong>Energy Consumption<br/></strong>≤0.4MJ</p>"}}, "features_list_right_X3VHC6": {"type": "features_list_right", "settings": {"title": "Pod Placement", "description": "<p>The placement of an acoustic pod can make a big difference to how well it performs. In spaces with high ceilings and large windows, positioning pods near a wall helps reduce echo.</p><p>It’s also important to leave enough space around the pod for proper airflow, and adding soft furnishings or plants nearby can further improve acoustics.</p><p>If you’re unsure where to place your pod, feel free to get in touch—our team will be happy to help you find the best spot.</p>"}}, "c21a0fde-facf-4d41-9329-1ea7cbfdac23": {"type": "feature_middle_image", "settings": {"middle-img": "shopify://shop_images/Folio_Booth_3.png"}}}, "block_order": ["82e4437d-c3ed-46e1-8f33-db6645f21ed8", "453c3266-3dfc-413c-a2c1-d76c8e57c79d", "aade32d9-6806-430b-b9c3-07623b95803d", "features_list_right_X3VHC6", "c21a0fde-facf-4d41-9329-1ea7cbfdac23"], "settings": {"seo": "Experience This Phone Booth Yourself", "title": "Finer Details", "content": "<p>Design, Function & More</p>", "show_videos": false, "no_sound": false, "loop": false, "close_label": "", "close_audio": "", "close_video": "", "close_thumb": "", "open_label": "", "open_audio": "", "open_video": "", "open_thumb": ""}},
    "16554719626663b231": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/Joy-Stool.png", "image_position": "left", "mobile_image_position": "top", "title": "Multitude Of Uses", "detection": "<p>The Joy Stool task, bar, counter top, task stool is a unique and playful piece of furniture. Its unconventional shape, inspired by a cocktail glass, adds a fun touch to any space. The stool's simple and elegant design makes it versatile and easy to incorporate into various interior styles. A statement piece in a minimalist space or a quirky accent in a more eclectic setting.</p>", "button_text": "", "button_link": ""}},
    "1655472025349426d8": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/Screenshot_2023-04-04_at_08.02.23.png", "image_position": "right", "mobile_image_position": "top", "title": "Form & Function", "detection": "<p>A great addition to any room. Cushioned with  high-density moulded foam. Upholstered with polyester mixed hardwearing fabric for comfort and supported by a durable polypropylene seat shell with gas lift cylinder. The base is made with non-slip, wear-resistant rubber that ensures the stool will remain secure while still allowing for tilting movement of the stool and occupant. A functional and aesthetically pleasing piece of furniture that is well-suited for use in any living and working area.</p>", "button_text": "", "button_link": ""}},
    "subscribe-follow": {"type": "main-collection-next", "blocks": {"28cea507-6689-4704-af63-50ae541df227": {"type": "email", "settings": {"title": "Thinking Outside The Box, Inside The Booth", "text": "<p>Stay ahead of the curve by subscribing to our newsletter. Don't miss out on exciting events, product launches, meet and greets, and valuable upgrades. Join our community and be a part of the workspace revolution.</p>", "image_bg": "shopify://shop_images/sbs-stn6-1-2-bg.jpg"}}, "b781bad8-6c0a-4ac9-86de-bedf4e1fdc25": {"type": "instagram", "settings": {"feed_id": "18121", "title": "Follow Us", "text": "<p><a href=\"https://www.instagram.com/soundboxstore/\" target=\"_blank\">@soundboxstore</a></p>", "image_bg": "shopify://shop_images/sbs-stn6-3-4-bg.jpg"}}}, "block_order": ["28cea507-6689-4704-af63-50ae541df227", "b781bad8-6c0a-4ac9-86de-bedf4e1fdc25"], "custom_css": [".main-collection-next {padding: 10;}", ".collection-template-grid {padding: 10; gap: 10;}"], "settings": {"collection": ""}},
    "9feac80b-e399-4ea8-9045-291758052834": {"type": "acoustic-environment-2", "blocks": {"item-0": {"type": "item", "settings": {"heading": "70%", "subheading": "<p>Increase work motivation by more comfortable environments.</p>"}}, "item-1": {"type": "item", "settings": {"heading": "60%", "subheading": "<p>Bring colour into the work place, inspire creativity.</p>"}}, "item-2": {"type": "item", "settings": {"heading": "30%", "subheading": "<p>Multi use flexible furniture saving an average of 30% on like for like furniture options.</p>"}}, "item-3": {"type": "item", "settings": {"heading": "40% - 60%", "subheading": "<p>Buy direct from main dealer 40-60% cost saving%.</p>"}}}, "block_order": ["item-0", "item-1", "item-2", "item-3"], "settings": {"bg_image": "shopify://shop_images/Joy-Stool-Banner.png", "heading": "Joy Stool - Multi Task Options", "subheading": "<p>Adding Flexibility To Work Environments</p><p>Durable, task stool with adjustable sturdy height option, comes in a number of colours ways to fit into interiors with the most complex designs.</p>", "subheading2": ""}},
