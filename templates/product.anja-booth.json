    "16634102988a9c9e05": {
      "type": "image-text-column",
      "settings": {
        "image": "shopify://shop_images/Anja-ContentImage-2P.png",
        "image_position": "left",
        "mobile_image_position": "top",
        "title": "The Anja M Booth",
        "detection": "<p>The Anja Acoustic 2 Person Meeting Booth from Soundbox Store provides an excellent solution for those looking for a quiet and comfortable workspace. With superior sound insulation, a curved wraparound design, and plug-and-play installation, our meeting booths are the perfect addition to any busy office environment. Don't let noise and distractions get in the way of your productivity and creativity - invest in an Anja Meeting Booth today.<br/></p>",
        "button_text": "",
        "button_link": ""
      }
    },
    "1655472025349426d8": {
      "type": "image-text-column",
      "settings": {
        "image": "shopify://shop_images/Anja-2P-Top_Shot.png",
