<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: #333;
    background: #fff;
  }

  .landing-container {
    max-width: 1400px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 80px 0;
  }

  /* Mobile-first layout */
  .content-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Video Section */
  .video-section {
    position: relative;
    width: 100%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-container {
    position: relative;
    width: 100%;
    height: auto;
    min-height: auto;
  }

  .video-player {
    width: 100%;
    height: auto; 
    object-fit: contain;
    display: block;
  }

  .play-pause-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    background: rgba(255, 255, 255, 0.95);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .play-pause-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background: rgba(255, 255, 255, 1);
  }

  .play-pause-btn.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .play-pause-btn svg {
    width: 32px;
    height: 32px;
    fill: #333;
  }

  /* Details Section */
  .details-section {
    flex: 1;
    padding: 32px 20px;
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  }

  .details-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .product-title {
    font-size: 32px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .product-subtitle {
    font-size: 18px;
    color: #666;
    margin-bottom: 24px;
    font-style: italic;
  }

  .product-description {
    font-size: 16px;
    color: #444;
    margin-bottom: 32px;
    line-height: 1.8;
  }

  .features-grid {
    display: grid;
    gap: 20px;
    margin-bottom: 32px;
  }

  .feature-card {
    background: #fff;
    padding: 20px;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-2px);
  }

  .feature-title {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .feature-icon {
    width: 24px;
    height: 24px;
    color: #4CAF50;
  }

  .feature-text {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
  }

  .benefits-section {
    background: #fff;
    padding: 24px;
    border-radius: 12px;
    margin-bottom: 32px;
  }

  .benefits-title {
    font-size: 22px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
  }

  .benefits-list li {
    padding: 8px 0;
    padding-left: 32px;
    position: relative;
    color: #444;
    font-size: 15px;
    line-height: 1.4;
  }

  .benefits-list li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #4CAF50;
    font-weight: bold;
    font-size: 18px;
  }

  .cta-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cta-button {
    display: inline-block;
    padding: 16px 32px;
    background: var(--colorBtnPrimary);
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 16px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .cta-button:hover {
   color: white;
  }

  .cta-button.secondary {
    background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
    color: #333;
    border: 2px solid #ddd;
  }

  .cta-button.secondary:hover {
    border-color: #4CAF50;
  }

  /* Desktop Layout */
  @media (min-width: 768px) {
    .content-wrapper {
      flex-direction: row;
    }

    .video-section {
      width: 50%;
      position: sticky;
      top: 0;
      height: auto;
      align-self: flex-start;
    }

    .video-container {
      height: auto;
      min-height: auto;
    }

    .video-player {
      height: auto;
      object-fit: contain;
    }

    .details-section {
      width: 50%;
      padding: 48px 40px;
      overflow-y: auto;
      height: 100vh;
    }

    .product-title {
      font-size: 42px;
    }

    .product-subtitle {
      font-size: 20px;
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .play-pause-btn {
      width: 100px;
      height: 100px;
    }

    .play-pause-btn svg {
      width: 40px;
      height: 40px;
    }
  }

  /* Large Desktop */
  @media (min-width: 1200px) {
    .details-content {
      max-width: 700px;
    }

    .product-title {
      font-size: 48px;
    }
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Loading state */
  .video-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
    font-size: 18px;
  }
</style>

