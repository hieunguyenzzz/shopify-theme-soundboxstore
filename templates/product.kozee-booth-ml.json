    "feature_content_zkRWaV": {
      "type": "feature-content",
      "blocks": {
        "tab_highlight_2": {
          "type": "feature-content",
          "settings": {
            "title": "Intelligent Environmental Control",
            "content": "<p><strong>Every Kozee Gen 2 booth includes:</strong><br/>- Automatic occupancy light display<br/>- Integrated air circulation<br/>- Dimmable, tunable lighting<br/><br/>Users can set lighting levels and temperature tone to suit personal preference and the task at hand, supporting comfort across different sensory needs.</p>",
            "image": "shopify://shop_images/ML_v6.png",
            "image_from_feature": "",
            "youtube_url": ""
          }
        },
        "tab_highlight_3": {
          "type": "feature-content",
          "settings": {
            "title": "Practical Benefits",
            "content": "<p><strong>Built for flexibility in day-to-day use:</strong><br/>Fast installation (phone booth in around 30 minutes)<br/>Integrated castors for easy relocation<br/>Fully demountable construction<br/>Top or base cable feed-in<br/>Ventilation to base and top<br/>Side-to-side or central placement<br/><br/>Kozee Gen 2 can be reconfigured as workspace needs change.</p>",
            "image": "shopify://shop_images/KozeeGen2-MLimage1.jpg",
            "image_from_feature": "",
            "youtube_url": ""
          }
        },
        "tab_highlight_4": {
          "type": "feature-content",
          "settings": {
            "title": "A Versatile Solution for Modern Environments",
            "content": "<p>Kozee Gen 2 booths suit a wide range of settings, from corporate offices to universities and industrial sites, giving teams focused, acoustically controlled space wherever it is needed.<br/><br/>Considered design and solid technical performance make the range practical to specify and easy to live with, and its adaptability supports inclusive, neurodiverse ways of working.</p>",
            "image": "shopify://shop_images/KozeeGen2-MLimage2.jpg",
            "image_from_feature": "",
            "youtube_url": ""
          }
        }
      },
      "block_order": [
        "tab_highlight_2",
        "tab_highlight_3",
        "tab_highlight_4"
      ],
      "settings": {}
