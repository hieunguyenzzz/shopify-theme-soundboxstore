    "image-loop-new": {
      "type": "image-loop-new",
      "blocks": {
        "9d8aec96-c9d8-4b5b-b03e-f8152828e3ba": {
          "type": "image_section",
          "settings": {
            "image": "shopify:\/\/shop_images\/Quell_SR_Solo_Our_Philosophy.png",
            "image_bg": "shopify:\/\/shop_images\/sbs-stn6-1-2-bg.jpg",
            "title": "",
            "description": "<h4>Our philosophy<\/h4><p>Partnering with professionals from different industry sectors to deliver consistent, reliable, and competitive acoustic control, insulation, and damping solutions. We are in the business of inspiring and opening up a new era of infinite possibilities within the industry.<\/p><p><\/p><h4>Our mission<\/h4><p>As Europe's acoustic solution leader, we're dedicated to providing comfortable, sustainable soundproof pod and booth environments that foster productivity.<\/p>",
            "btn_text": "Let's talk",
            "btn_class": "",
            "btn_url": "shopify:\/\/pages\/contact"
          }
        },
        "274907dc-3e29-4235-af23-66c46219173a": {
          "type": "image_section",
          "settings": {
            "image": "shopify:\/\/shop_images\/sbs-stn6-3-4.png",
            "image_bg": "shopify:\/\/shop_images\/sbs-stn6-3-4-bg.jpg",
            "title": "",
            "description": "<h4>10 years in the making<\/h4><p>With a state-of-the-art manufacturing facility in Europe, we've spent 10 years perfecting our sound booth solutions. From mature markets to emerging ones, our innovative Zoom rooms and phone booths enhance productivity and acoustic control.<\/p><h4>Environmental Responsibility<\/h4><p>Pioneers in using recycled carbon plastic, Soundbox Store champions a low-carbon footprint approach. Each Soundbox booth boasts a:<\/p><ul><li>Carbon footprint of <strong>≤0.071kg Co2e<\/strong><\/li><li>Energy consumption average of<strong> ≤0.4MJ<\/strong><\/li><li>Air acidification level of <strong>≤0.0001kg SO2e<\/strong> <\/li><li>Water eutrophication of <strong>≤0.00002PO4<\/strong><\/li><\/ul>",
            "btn_text": "GET PHONE BOOTHS SPECIFICATIONS",
            "btn_class": "specBtn",
            "btn_url": ""
          }
        }
      },
      "block_order": [
        "9d8aec96-c9d8-4b5b-b03e-f8152828e3ba",
        "274907dc-3e29-4235-af23-66c46219173a"
      ],
      "custom_css": [
        "h3 {margin-top: 2.8em;}",
        ".image-loop .right-col img {object-position: top left; object-fit: scale-down;}",
        ".image-loop .image-text-row:nth-child(2n) img {object-position: right bottom;}",
        "section {max-width: unset; padding: 0;}",
        ".image-text-row .flexbox {max-width: 1640px; margin: auto;}",
        ".image-text-row:first-child .left-col {justify-content: end;}",
        "@media only screen and (min-width: 1025px) {.left-col .col-wrap {max-width: min(40vw, 765px); }}"
      ],
      "settings": {
        "title": "",
        "description": "<h3>Premium Acoustic Soundproof Office Pods, Meeting Rooms and Phone Booths<\/h3><p>Soundbox offers advanced acoustic soundproof office pods, meeting rooms, Zoom rooms, and phone booths. Designed with sustainability, safety, and impeccable design in mind, they level up your business and offer premium service to your clients.<\/p><p>Our frames showcase a blend of engineering and aesthetics, recognizable for high-end features and distinguishable qualities unlike any bulky alternatives in the market.<\/p>",
        "bg_color": "rgba(0,0,0,0)"
      }
    },
