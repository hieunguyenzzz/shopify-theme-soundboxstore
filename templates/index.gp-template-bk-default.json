            "slider": false,
            "title": ""
          },
          "type": "brand_details"
        },
        "5752b708-0a8d-4e5d-903e-3fd549c4f22d": {
          "settings": {
            "background_color": "#f5e8d8",
            "bottm_right_text": "<p>Starbucks chose our Meeting Pods to ensure optimal productivity and privacy for their meetings. Featuring stylish, modern designer furniture, flexible configurations, and state-of-the-art technology, these pods provide a quiet and efficient environment for any work session or one-on-one discussion.</p>",
            "bottom_sub_title": "Shanghai, china",
            "bottom_title": "Starbucks Office",
            "logo_image": "shopify://shop_images/starbucks-logo.png",
            "slide_class": "",
            "slide_image1": "shopify://shop_images/M_L_MODEL.jpg",
            "slide_image2": "shopify://shop_images/M_L_MODEL2.png",
            "slider": false,
