    "165656720859a9e8d5": {"type": "rich-text", "blocks": {"165656720836c7d25b-0": {"type": "heading", "settings": {"title": "Meeting Booth Quell Max"}}, "165656720836c7d25b-1": {"type": "text", "settings": {"enlarge_text": true, "text": "<p>Introducing one of the largest acoustic meeting booths /  conference rooms (8 Person) on the market which can cater for various use case scenarios. </p><p>Whether you need a large workspace, a conference room, or acoustically controlled breakout area with sofas, bean bags, potential coffee station, our designers are ready to assist you.</p><p>Our Quell Max is a spacious  booth which features top-of-the-line acoustic properties  equipped with a 4 fan silent ventilation system, providing industry-leading fresh airflow to ensure a comfortable and distraction-free environment. This booth is designed to inspire your team and help them focus on productivity with minimal internal and external acoustic interference.</p><p>Inside, the environment is well-ventilated, cool, comfortable, and spacious, making it ideal for conference calls, private meetings, with optional Logitech Meet Conference camera and Monitor. </p><p>The booth itself is constructed from aviation-style alloy and  toughened Laminated, ensuring durability and strength. To further enhance its acoustic properties, the internal walls are lined with PET sound acoustic panels. </p><p></p>"}}}, "block_order": ["165656720836c7d25b-0", "165656720836c7d25b-1"], "settings": {"collapable": true, "align_text": "center", "narrow_column": false, "color_scheme": "none", "divider": false}},
    "meeting-rooms-features": {"type": "meeting-rooms-features", "blocks": {"82e4437d-c3ed-46e1-8f33-db6645f21ed8": {"type": "features_list_left", "settings": {"title": "Dimensions", "description": "<p><strong>Internal Size:</strong><br/>Height: 214cm Width: 284cm Depth: 420cm<strong><br/>External Size:</strong><br/>Height: 234.5cm Width: 300cm Depth: 423.6cm<br/><strong>Weight:<br/></strong>Total: 1442kg (Pod)<strong><br/></strong>120 kg pe square meter approx<br/></p>"}}, "d390db88-124b-4e53-b3e8-234749d7ec3a": {"type": "features_list_left", "settings": {"title": "Sound / Acoustics", "description": "<p><strong>Leading The Sound Pod Industry</strong><br/>STC 30dB (±5dB) &<br/>RT0.25s (±0.1s)<br/>Daiki Verified<br/>ISO 23351-1</p>"}}, "d3a6f941-b3fc-45f8-b5a6-c82167cfcad9": {"type": "features_list_left", "settings": {"title": "Materials", "description": "<p><strong>External Frame</strong><br/>Aviation Type Alloy, Cast Aluminium Corners<br/>Nanometer PP Finish<strong><br/>External Panels<br/></strong>Carbon Composite <br/>≤0.071kg CO2e<br/><strong>Glass<br/></strong>10mm Laminated Front & Back, Similar To High Speed Trains ≤0.4MJ<br/><strong>Damping Feet<br/></strong>Vibration control<br/><strong>Internally</strong> <br/>Acoustic PET board (Recycled Plastic Bottles)</p>"}}, "453c3266-3dfc-413c-a2c1-d76c8e57c79d": {"type": "features_list_left", "settings": {"title": "Ventilation", "description": "<p>Quad Turbo Fans + 4 Outlets, Highly efficient airflow change rate at 551 m³/h (max) refreshing air every minute, guaranteeing excellent oxygen rates. A low-noise air system via multi-channel air ducts allows minimum noise disturbance inside and out.</p>"}}, "cb2a41ec-f379-4bf5-bcce-bde5e4db4e1a": {"type": "features_list_right", "settings": {"title": "Electrical / Lighting", "description": "<p><br>*LED Middle Strip 6500k, 50Lx, Daylight <br>*LED Side Strips 4000k, 50Lx, Daylight <br>*Multiple Power Outlets, 220- 24V USB, USB-C<br>*Energy Saving Motion Sensor<br>*2 * Ethernet (Cat 6) Connector </p><p>External LAN Port (Inlet) / Internal LAN Port (Outlet)</p><p>Ethernet cables not supplied</p><p>*Bluetooth Connect Speaker<br>*Wireless Charging Dock *Furniture Option Only</p><p>Requires connection to mains power through a standard wall socket. Supplied with a 1.8m cable. Please contact us for longer lengths.</p>"}}, "6b66cb21-f9e3-4ec5-89ed-37a0d24af348": {"type": "features_list_right", "settings": {"title": "Optional Furniture", "description": "<p>Optional conference table and designer office chairs. Optional conference Logitech Meet Cam and 23\" monitor available for this booth. Furniture specifically built for these pods is an excellent option for functionality comfort and style whilst allowing maximum space without feeling crowded.</p>"}}, "19323c70-b1a6-44b1-b5b4-12733c55ae2e": {"type": "features_list_right", "settings": {"title": "Safety", "description": "<p><strong>Emergency Safety Hammer<br/></strong>Included For Internal Fitting<br/><strong>Fire Rated Foam<br/></strong>UK Fire foam where required.<strong> <br/>Sprinkler / Mains Fire Alarm<br/></strong>Laser cut (25mm) and usable if required<strong><br/>Formaldehyde Free<br/></strong>No wood or glue</p>"}}, "aade32d9-6806-430b-b9c3-07623b95803d": {"type": "features_list_right", "settings": {"title": "Sustainability", "description": "<p><strong>Recycled materials approx</strong><br/>≥180kg (12m²/0.66m³) each</p><p><strong>Carbon Footprint</strong><br/>≤0.071kg CO2e<br/><strong>Energy Consumption<br/></strong>≤0.4MJ</p>"}}, "features_list_right_k7QjiN": {"type": "features_list_right", "settings": {"title": "Pod Placement", "description": "<p>The placement of an acoustic pod can make a big difference to how well it performs. In spaces with high ceilings and large windows, positioning pods near a wall helps reduce echo.</p><p>It’s also important to leave enough space around the pod for proper airflow, and adding soft furnishings or plants nearby can further improve acoustics.</p><p>If you’re unsure where to place your pod, feel free to get in touch—our team will be happy to help you find the best spot.</p>"}}, "c21a0fde-facf-4d41-9329-1ea7cbfdac23": {"type": "feature_middle_image", "settings": {"middle-img": "shopify://shop_images/L1_white_lights_on.png"}}, "6cf7c02f-a050-4d80-8e04-8f288286c6d2": {"type": "hotspot_point", "settings": {"point_x": 7, "negative_y": false, "point_y": 15, "hotspot_title": "Dimensions"}}, "03433a09-09b3-4e6b-a6c9-e5517ee3f7e0": {"type": "hotspot_point", "settings": {"point_x": 22, "negative_y": false, "point_y": 35, "hotspot_title": "Sound / Acoustics"}}, "c081d9ee-3e16-4431-99a3-382ead340ee3": {"type": "hotspot_point", "settings": {"point_x": 37, "negative_y": false, "point_y": 9, "hotspot_title": "Electrical / Lighting"}}, "0a79d994-15ef-43ba-a0af-eb98f0f412e6": {"type": "hotspot_point", "settings": {"point_x": 84, "negative_y": false, "point_y": 3, "hotspot_title": "Materials"}}, "56703a54-a604-429c-942a-7aee94e66fa6": {"type": "hotspot_point", "settings": {"point_x": 52, "negative_y": false, "point_y": 0, "hotspot_title": "Ventilation"}}, "6a4c359c-9793-4187-9e54-0fb5fd26aaca": {"type": "hotspot_point", "settings": {"point_x": 30, "negative_y": false, "point_y": 49, "hotspot_title": "Optional Furniture"}}, "541c93a6-a6b0-47da-b38f-0e184ab84a18": {"type": "hotspot_point", "settings": {"point_x": 50, "negative_y": false, "point_y": 35, "hotspot_title": "Safety"}}, "d1f069e7-7a57-45bf-96af-c70758c98580": {"type": "hotspot_point", "settings": {"point_x": 87, "negative_y": false, "point_y": 44, "hotspot_title": "Sustainability"}}}, "block_order": ["82e4437d-c3ed-46e1-8f33-db6645f21ed8", "d390db88-124b-4e53-b3e8-234749d7ec3a", "d3a6f941-b3fc-45f8-b5a6-c82167cfcad9", "453c3266-3dfc-413c-a2c1-d76c8e57c79d", "cb2a41ec-f379-4bf5-bcce-bde5e4db4e1a", "6b66cb21-f9e3-4ec5-89ed-37a0d24af348", "19323c70-b1a6-44b1-b5b4-12733c55ae2e", "aade32d9-6806-430b-b9c3-07623b95803d", "features_list_right_k7QjiN", "c21a0fde-facf-4d41-9329-1e