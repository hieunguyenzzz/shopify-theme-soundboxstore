    "16514886521bb2c480": {"type": "image-slider", "blocks": {"d1bac85b-c4e9-4f84-9605-6e017a84e81a": {"type": "image_slide", "settings": {"image": "shopify://shop_images/Why-Soundbox13.jpg", "overlay": false, "overlay_range": 10, "overlay_color": "#303a44"}}}, "block_order": ["d1bac85b-c4e9-4f84-9605-6e017a84e81a"], "disabled": true, "settings": {"slide_dots": false, "slide_arrow": false, "sectionwidth": true}},
    "ebf4881c-faca-44ef-a5ac-a577e1bf76cb": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/XXL-Detail-2.png", "image_position": "left", "mobile_image_position": "top", "title": "Mindful In Design", "detection": "<p>Primarily an acoustic control company, technically engineers; design-wise, we are creators. Our  furniture packs have been developed over years of trials and customer feedback: functional, comfortable, and organic design. </p>", "button_text": "", "button_link": ""}},
    "49a5198e-c7ce-4269-bf55-ad7c4f002a9d": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/XXL-Detail-1.png", "image_position": "right", "mobile_image_position": "top", "title": "New, Upgraded Lighting", "detection": "<p>Soundbox Store now offers as standard additional LED strip lighting 4000k 50Lx Daylight, neatly designed on either side of the meeting and conference booth. Powered separately from the leading central light-creating the potential if task or ambient lighting.</p>", "button_text": "", "button_link": ""}},
    "1655472797be735185": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/Turbo-Fans.png", "image_position": "left", "mobile_image_position": "top", "title": "New - Turbo Fan System", "detection": "<p>Introducing the new Turbo Fan, sleeker in design with more airflow, creating ample comfort and a refreshing environment.</p>", "button_text": "", "button_link": ""}},
    "8281adaf-628d-4174-9d8a-c0e2b81add14": {"type": "image-text-column", "blocks": {"youtube_popup_mbxP8j": {"type": "youtube-popup", "disabled": true, "settings": {"image": "shopify://shop_images/Lrge-Pod-Control-Panel.png", "external_video_url": "https://www.youtube.com/watch?v=Z0zScNarmCE"}}}, "block_order": ["youtube_popup_mbxP8j"], "settings": {"image": "shopify://shop_images/Lrge-Pod-Control-Panel.png", "image_position": "right", "mobile_image_position": "top", "title": "Power + Bluetooth", "detection": "<p>UL & CE Certificated<br/>Bluetooth Speaker, connect devices for calls, zoom calls or music.<br/>Switches for LED lighting and ventilation (dimmable).<br/>Motion Sensor - Only use power when in use.<br/>8* 220-240 Power Socket UK/ EU<br/>6* USB DC 5V, 2.1A.<br/>6* USB-C DC 5V, 2.1A.<br/>2* Wireless Phone Chargers<br/>* The power out lets above are based on table option being included.</p>", "button_text": "", "button_link": ""}},
    "1655472824af811b1b": {"type": "image-text-column", "settings": {"image": "shopify://shop_images/state-of-the-art.png", "image_position": "left", "mobile_image_position": "top", "title": "Ground Breaking Tech", "detection": "<p>Sound Box is a fully engaged company focusing on the highest technological advancements, creating highly efficient, creative, focused work environments, and continually striving for excellence in technology and acoustic engineering.</p>", "button_text": "", "button_link": ""}},
    "acoustic-environment": {"type": "acoustic-environment", "disabled": true, "settings": {"bgcolor": "#e8e8e1", "heading": "Acoustic Environment", "subheading": "a comfortable workspace can", "description": "<p><strong>48%</strong> increase in employee focus,<br/><strong>10%</strong> fewer errors made,<br/><strong>27%</strong> reduction in stress level,<br/><strong>23%</strong> increase work efficiency,<br/><strong>21 %</strong> lower work fatigue...</p><p>By creating a workplace with a good acoustics environment, you can develop an office that workers will enjoy working within.</p>", "image": "shopify://shop_images/Why-Soundbox-13.jpg", "mobile_image": "shopify://shop_images/Why-Soundbox-30.jpg", "perameter_text": "<li>Focus</li>              <li>Errors</li>              <li>Stress</li>         <li>Efficiency</li><li>Fatigue</li>", "graphtitle": "<p>Sykes, David M., PhD., 2004, “Productivity: How Acoustics Affect Workers’ Performance in Open Areas”</p>"}},
    "subscribe_follow_aBVRhR": {"type": "main-collection-next", "blocks": {"28cea507-6689-4704-af63-50ae541df227": {"type": "email", "settings": {"title": "Thinking Outside The Box, Inside The Booth", "text": "<p>Stay ahead of the curve by subscribing to our newsletter. Don't miss out on exciting events, product launches, meet and greets, and valuable upgrades. Join our community and be a part of the workspace revolution.</p>", "image_bg": "shopify://shop_images/sbs-stn6-1-2-bg.jpg"}}, "b781bad8-6c0a-4ac9-86de-bedf4e1fdc25": {"type": "instagram", "settings": {"feed_id": "18121", "title": "Follow Us", "text": "<p><a href=\"https://www.instagram.com/soundboxstore/\" target=\"_blank\">@soundboxstore</a></p>", "image_bg": "shopify://shop_images/sbs-stn6-3-4-bg.jpg"}}}, "block_order": ["28cea507-6689-4704-af63-50ae541df227", "b781bad8-6c0a-4ac9-86de-bedf4e1fdc25"], "custom_css": [".main-collection-next {padding: 10;}", ".collection-template-grid {padding: 10; gap: 10;}"], "settings": {"collection": ""}},
