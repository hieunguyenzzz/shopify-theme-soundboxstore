    "f6ac66f9-6f01-49e0-ba3c-8e364479fe1b": {
      "type": "faq",
      "blocks": {
        "template--16818200281313__f6ac66f9-6f01-49e0-ba3c-8e364479fe1b-question-1": {
          "type": "question",
          "settings": {
            "title": "Are the electrical elements in your products eco-friendly?",
            "text": "<p>Yes, our products feature electrical elements that are designed with sustainability in mind. These elements are engineered to be energy-efficient and are composed of materials that are up to 90% recyclable, reducing the overall environmental impact.</p>"
          }
        },
        "template--16818200281313__f6ac66f9-6f01-49e0-ba3c-8e364479fe1b-question-2": {
          "type": "question",
          "settings": {
            "title": "Do your products use plastic packaging?",
            "text": "<p>We are committed to minimising waste at every stage. Our packaging materials, including cardboard and plastic, are chosen for their recyclability. Our cardboard packaging is fully recyclable, and our plastic packaging boasts a remarkable 95% recyclability rate, helping to reduce waste in the packaging process.</p>"
          }
        },
        "cdfbd858-86f4-4d7a-b0b3-52fcb6a6594f": {
          "type": "question",
          "settings": {
            "title": "How do I dispose of my Soundbox product at the end of its lifecycle?",
            "text": "<p>When our products reach the end of their useful life, they can be disassembled, and their recyclable components can be separated and sent for recycling. This ensures that even after years of use, our products continue to contribute positively to the environment.</p>"
          }
        },
        "f87b9de3-248d-4471-9173-bfd3750166b3": {
          "type": "question",
          "settings": {
            "title": "Are your customisable products sustainable?",
            "text": "<p>Absolutely. We offer customisation options that allow you to tailor our products to your needs without compromising our sustainability principles. Our aim is to create bespoke solutions that align with both functionality and environmental responsibility.</p>"
          }
        }
      },
