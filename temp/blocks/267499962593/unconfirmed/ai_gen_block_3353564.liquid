{% doc %}
  @prompt
    section introdu our new product

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-intro-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-product-intro-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .ai-product-intro-content-{{ ai_gen_id }} {
    text-align: left;}

  .ai-product-intro-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-intro-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-product-intro-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 30px;
    opacity: 0.8;
  }

  .ai-product-intro-features-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 30px;
  }

  .ai-product-intro-feature-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    margin-bottom: 12px;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-intro-feature-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    color: {{ block.settings.accent_color }};
    flex-shrink: 0;
  }

  .ai-product-intro-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    padding: 16px 32px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    transition: background-color 0.3s ease;}

  .ai-product-intro-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-product-intro-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-product-intro-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-intro-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-intro-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .ai-product-intro-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-product-intro-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
      text-align: center;
    }

    .ai-product-intro-content-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-product-intro-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-product-intro-image-placeholder-{{ ai_gen_id }} {
      height: 300px;
    }
  }

  {% if block.settings.layout == 'image_left' %}
    .ai-product-intro-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }
    
    .ai-product-intro-image-wrapper-{{ ai_gen_id }} {
      order: -1;
    }
  {% endif %}
{% endstyle %}<div class="ai-product-intro-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-intro-container-{{ ai_gen_id }}">
    <div class="ai-product-intro-content-{{ ai_gen_id }}">
      {% if block.settings.badge_text != blank %}
        <span class="ai-product-intro-badge-{{ ai_gen_id }}">
          {{ block.settings.badge_text }}
        </span>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-product-intro-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-product-intro-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.feature_1 != blank or block.settings.feature_2 != blank or block.settings.feature_3 != blank %}
        <ul class="ai-product-intro-features-{{ ai_gen_id }}">
          {% if block.settings.feature_1 != blank %}
            <li class="ai-product-intro-feature-{{ ai_gen_id }}">
              <svg class="ai-product-intro-feature-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              {{ block.settings.feature_1 }}
            </li>
          {% endif %}
          {% if block.settings.feature_2 != blank %}
            <li class="ai-product-intro-feature-{{ ai_gen_id }}">
              <svg class="ai-product-intro-feature-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              {{ block.settings.feature_2 }}
            </li>
          {% endif %}
          {% if block.settings.feature_3 != blank %}
            <li class="ai-product-intro-feature-{{ ai_gen_id }}">
              <svg class="ai-product-intro-feature-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              {{ block.settings.feature_3 }}
            </li>
          {% endif %}
        </ul>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-product-intro-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div><div class="ai-product-intro-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product_image %}
        <img
          src="{{ block.settings.product_image | image_url: width: 800 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          class="ai-product-intro-image-{{ ai_gen_id }}"
          loading="lazy"width="{{ block.settings.product_image.width }}"
          height="{{ block.settings.product_image.height }}"
        >
      {% else %}
        <div class="ai-product-intro-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "New product introduction",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "New product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Introducing our latest innovation"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover the future of innovation with our groundbreaking new product. Designed with cutting-edge technology and crafted for excellence.</p>"
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "Feature 1",
      "default": "Premium quality materials"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Feature 2",
      "default": "Advanced technology integration"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "Sustainable and eco-friendly"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        {
          "value": "image_right",
          "label": "Right"
        },
        {
          "value": "image_left",
          "label": "Left"
        }
      ],
      "default": "image_right"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#007acc"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge background",
      "default": "#007acc"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "New product introduction"
    }
  ],
  "tag": null
}
{% endschema %}