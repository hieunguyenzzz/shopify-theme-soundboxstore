<style>
   #shopify-section-{{section.id}}{
     margin-top: 2em !important
   }
     #shopify-section-{{section.id}} p{
     margin:0;
   }
  #shopify-section-{{section.id}}  .product-icon-text-section .flexbox .shopify-block{
    flex:1;
  }
   #shopify-section-{{section.id}}  .slick-track{
    width:100%
  }
  #shopify-section-{{section.id}}  .product-icon-text-section .flexbox .col .icon-text-block .icon-wrap {
    max-width: 80px;
    height: 80px;    margin-right: 1em;
  }
   #shopify-section-{{section.id}} .product-icon-text-section .page-width{
    max-width:1024px;
  }
  .product-icon-text-section .text-block{
    white-space:nowrap
  }
  .product-icon-text-section .flexbox{
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }
     .product-icon-text-section .icon-text-block .col{
      flex:unset
    }
    .product-icon-text-section .flexbox >.col{
       max-width: 350px;
    }
  @media screen and (max-width: 767px) {
    .product-icon-text-section .flexbox {
      flex-wrap: nowrap;
      overflow: hidden;
    }
    
    .product-icon-text-section .flexbox .shopify-block {
      min-width: 100%;
      flex: 0 0 100%;
    }

    /* Hide all slides initially except first one */
    .product-icon-text-section .flexbox .shopify-block:not(:first-child) {
      display: none;
    }

    /* Show all slides when slick is initialized */
    .product-icon-text-section .flexbox.slick-initialized .shopify-block {
      display: block;
    }
  }
    @media screen and (min-width: 1440) {
      .product-icon-text-section .page-width{
    max-width:unset;
    display:flex;
    overflow:auto;
  }
  .product-icon-text-section .text-block{
    white-space:nowrap
  }
  .product-icon-text-section .flexbox{
    justify-content:center;flex-shrink: 0;min-width:100%

  }
  }
</style>
<section class="product-icon-text-section product-icon-text-section-{{ section.id }}">
  <div class="page-width">
    <div class="flexbox">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>
<script>
  $(document).ready(function() {
    const initSlider = () => {
      if (window.innerWidth <= 767) {
        if (!$('.product-icon-text-section .flexbox').hasClass('slick-initialized')) {
          $('.product-icon-text-section .flexbox').slick({
            dots: true,
            arrows: false,
            infinite: true,
            speed: 300,
            slidesToShow: 1,
            slidesToScroll: 1,
            autoplay: true,
            autoplaySpeed: 3000,
            adaptiveHeight: true
          });
        }
      } else {
        if ($('.product-icon-text-section .flexbox').hasClass('slick-initialized')) {
          $('.product-icon-text-section .flexbox').slick('unslick');
        }
      }
    };

    initSlider();
    $(window).on('resize', initSlider);
  });
</script>

{% schema %}
{
  "name": "Call actions",
  "settings": [

  ],
  "blocks": [
    {
      "type": "call-actions-item",
    },
  ],
    "presets": [
     {
       "name": "Call actions",
       "blocks": []
     }
   ]
}
{% endschema %}
