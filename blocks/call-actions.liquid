<style>
  #shopify-section-{{section.id}}  .product-icon-text-section .flexbox>div{
    flex:1;


  }
  .product-icon-text-section .page-width{
    max-width:unset;
  }
  .product-icon-text-section .text-block{
    white-space:nowrap
  }
  .product-icon-text-section .flexbox{
    justify-content:center;

  }
     .product-icon-text-section .icon-text-block .col{
      flex:unset
    }
    .product-icon-text-section .flexbox >.col{
       max-width: 350px;
    }
  @media screen and (max-width: 860px) {
      .product-icon-text-section-{{ section.id }} .col:not(:first-child){
    display:none
  }
   .product-icon-text-section-{{ section.id }} .slick-initialized.slick-slider .col{
    display:unset
  }
  }
    @media screen and (min-width: 1440) {
      .product-icon-text-section .page-width{
    max-width:unset;
    display:flex;
    overflow:auto;
  }
  .product-icon-text-section .text-block{
    white-space:nowrap
  }
  .product-icon-text-section .flexbox{
    justify-content:center;flex-shrink: 0;min-width:100%

  }
  }
</style>
<section class="product-icon-text-section product-icon-text-section-{{ section.id }}">
  <div class="page-width">
    <div class="flexbox">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>
<script>
    $(window).on('load', function() {
      $(".template-index .product-icon-text-section .flexbox").slick({
    slidesToShow: 1,
    slidesToScroll: 1,
    mobileFirst: true,
    arrows: false,
    autoplay: true,
    dots: false,
    responsive: [
      {
        breakpoint: 1440,
        settings: "unslick",
      },
      {
        breakpoint: 1081,
        settings: {
          slidesToShow: 4,
          slidesToScroll: 1,
          adaptiveHeight: true,
        },
      },
      {
        breakpoint: 861,
        settings: {
          slidesToShow: 1,
          slidesToScroll: 1,
          adaptiveHeight: true,
        },
      },
    ],
  });
  })
</script>

{% schema %}
{
  "name": "Call actions",
  "settings": [

  ],
  "blocks": [
    {
      "type": "call-actions-item",
    },
  ],
    "presets": [
     {
       "name": "Call actions",
       "blocks": []
     }
   ]
}
{% endschema %}
