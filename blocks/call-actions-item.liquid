<div class="col">
  <a href="{{ block.settings.url }}" class="col-wrap">
    <div class="icon-text-block">
      {% if block.settings.iconimage != blank %}
        <div class="icon-block">
          <div class="icon-wrap">
            <img
              loading="lazy"
              src="{{ block.settings.iconimage | image_url : width: 100 }}"
              width="80"
              height="80"
              alt="{{ block.settings.iconimage.alt }}"
            >
          </div>
        </div>
      {% endif %}
      {% if block.settings.text != blank %}
        <div>
          <div class="" style="position:relative">
            {{ block.settings.text -}}
            <span
              style="
                margin-right: 0;
                position: absolute;
                top: .1em;
                left: -1.1em;
              "
              class="icon icon--inventory"
              style="margin-right:0"
            ></span>
          </div>
          <div style="font-size:0.8em ;  text-underline-offset:0.3em;    text-decoration: underline;  opacity: 0.7;">
            {{ block.settings.url_text }}
          </div>
        </div>
      {% endif %}
    </div>
  </a>
</div>
{% schema %}
{
  "name": "call-actions-item",
  "settings": [ {
          "type": "image_picker",
          "id": "iconimage",
          "label": "Icon Image"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "label": "Link",
          "id": "url"
        },
          {
          "type": "text",
          "label": "Link text",
          "id": "url_text"
        }],
  "presets": [
  { "name": "item" },
]
}
{% endschema %}
