<style>
  :root {
    --video-section-width: {{ section.settings.video_section_width }}%;
    --details-section-width: {{ 100 | minus: section.settings.video_section_width }}%;
    --video-height: {{ section.settings.video_height | default: 'auto' }};
    --poster-width: {{ section.settings.poster_width | default: '100%' }};
    --poster-height: {{ section.settings.poster_height | default: '100%' }};
  }
</style>
{{ 'custom-video-controls.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-video-controls.js' | asset_url }}" defer></script>


<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: #333;
    background: #fff;
  }

  .landing-container {
    max-width: 1400px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 80px 0;
  }

  /* Mobile-first layout */
  .content-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Video Section */
  .video-section {
    position: relative;
    width: 100%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-container {
    position: relative;
    width: 100%;
    height: auto;
    min-height: auto;
  }

  .video-player {
    width: 100%;
    height: var(--video-height, auto);
    object-fit: contain;
    display: block;
  }

  .video-poster-img {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--poster-width, 100%);
    height: var(--poster-height, 100%);
    object-fit: contain;
    display: block;
    cursor: pointer;
    z-index: 5;
  }

  .video-poster-img.hidden {
    display: none;
  }

  .play-pause-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    background: rgba(255, 255, 255, 0.95);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .play-pause-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background: rgba(255, 255, 255, 1);
  }

  .play-pause-btn.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .play-pause-btn svg {
    width: 32px;
    height: 32px;
    fill: #333;
  }

  /* Details Section */
  .details-section {
    flex: 1;
    padding: 32px 20px;
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  }

  .details-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .product-title {
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .product-subtitle {
    font-size: 18px;
    color: #666;
    margin-bottom: 24px;
    font-style: italic;
  }

  .product-description {
    font-size: 16px;
    color: #444;
    margin-bottom: 32px;
    line-height: 1.8;
  }

  .features-grid {
    display: grid;
    gap: 20px;
    margin-bottom: 32px;
  }

  .feature-card {
    background: #fff;
    padding: 20px;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-2px);
  }

  .feature-title {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .feature-icon {
    width: 24px;
    height: 24px;
    color: #4CAF50;
  }

  .feature-text {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
  }

  .benefits-section {
    background: #fff;
    padding: 24px;
    border-radius: 12px;
    margin-bottom: 32px;
  }

  .benefits-title {
    font-size: 22px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
  }

  .benefits-list li {
    padding: 8px 0;
    padding-left: 32px;
    position: relative;
    color: #444;
    font-size: 15px;
    line-height: 1.4;
  }

  .benefits-list li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #4CAF50;
    font-weight: bold;
    font-size: 18px;
  }

  .cta-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cta-button {
    display: inline-block;
    padding: 16px 32px;
    background: var(--colorBtnPrimary);
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 16px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .cta-button:hover {
   color: white;
  }

  .cta-button.secondary {
    background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
    color: #333;
    border: 2px solid #ddd;
  }

  .cta-button.secondary:hover {
    border-color: #4CAF50;
  }

  /* Desktop Layout */
  @media (min-width: 768px) {
    .content-wrapper {
      flex-direction: row;
    }

    .video-section {
      width: var(--video-section-width, 50%);
      position: sticky;
      top: 0;
      height: auto;
      align-self: flex-start;
    }

    .video-container {
      height: auto;
      min-height: auto;
    }

    .video-player {
      height: auto;
      object-fit: contain;
      max-height: 800px;
    }

    .details-section {
      width: var(--details-section-width, 50%);
      padding: 48px 40px;
      overflow-y: auto;
      height: 100vh;
    }

    .product-title {
      font-size: 36px;
    }

    .product-subtitle {
      font-size: 20px;
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .play-pause-btn {
      width: 100px;
      height: 100px;
    }

    .play-pause-btn svg {
      width: 40px;
      height: 40px;
    }
  }

  /* Large Desktop */
  @media (min-width: 1200px) {
    .details-content {
      max-width: 700px;
    }

    .product-title {
      font-size: 42px;
    }
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Loading state */
  .video-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
    font-size: 18px;
  }
</style>

<div class="landing-container">
  <div class="content-wrapper">
    <!-- Video Section -->
    <div class="video-section">
      <div class="video-container">
        <video
          id="productVideo"
          class="video-player"
          playsinline
          preload="auto"
          loop
          {% if section.settings.video_poster != blank %}
            poster="{{ section.settings.video_poster | image_url: width: 800, format: 'pjpg' }}"
          {% endif %}
        >
          {% if section.settings.video_src != blank %}
            {% comment %}1. Prioritize HLS (m3u8) for adaptive streaming (best for mobile/5G){% endcomment %}
            {% assign hls_src = section.settings.video_src.sources | where: "format", "m3u8" | first %}
            {% if hls_src %}
              <source src="{{ hls_src.url }}" type="{{ hls_src.mime_type }}">
            {% endif %}
            
            {% comment %}2. Fallback to optimized MP4 sources sorted by height{% endcomment %}
            {% assign mp4_sources = section.settings.video_src.sources | where: "format", "mp4" | sort: "height" %}
            {% for source in mp4_sources %}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {% endfor %}
          {% endif %}
          Your browser does not support the video tag.
        </video>


        {% if section.settings.video_poster != blank %}
          {{ section.settings.video_poster | image_url: width: 800, quality: 70, format: 'pjpg' | image_tag: 
            id: 'videoPoster',
            class: 'video-poster-img',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '360, 540, 720, 800',
            sizes: '(min-width: 768px) 50vw, 100vw',
            alt: section.settings.video_poster.alt | escape
          }}
        {% endif %}


        <button id="playPauseBtn" class="play-pause-btn" aria-label="Play video">
          <svg id="playIcon" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg id="pauseIcon" viewBox="0 0 24 24" style="display: none;">
            <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Details Section -->
    <div class="details-section">
      <div class="details-content">
        <h1 class="product-title">{{ section.settings.product_title }}</h1>

        {% if section.settings.product_subtitle != blank %}
          <p class="product-subtitle">{{ section.settings.product_subtitle }}</p>
        {% endif %}

        {% if section.settings.product_description != blank %}
          <div class="product-description">
            <p>{{ section.settings.product_description }}</p>
          </div>
        {% endif %}

        {% if section.settings.cta_url != blank %}
          <div class="cta-section" style="margin-bottom: 32px;">
            <a href="{{ section.settings.cta_url }}" class="cta-button">
              {{ section.settings.cta_text | default: 'View Full Details & Pricing' }}
            </a>
          </div>
        {% endif %}

        {% assign benefits = section.blocks | where: "type", "benefit" %}
        {% if benefits.size > 0 %}
          <div class="benefits-section">
            <h2 class="benefits-title">{{ section.settings.benefits_title }}</h2>
            <ul class="benefits-list">
              {% for block in benefits %}
                <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% assign features = section.blocks | where: "type", "feature" %}
        {% if features.size > 0 %}
          <div class="features-grid">
            {% for block in features %}
              <div class="feature-card" {{ block.shopify_attributes }}>
                <div class="feature-title">
                  {% case block.settings.icon %}
                    {% when 'acoustics' %}
                      <svg class="feature-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    {% when 'setup' %}
                      <svg class="feature-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
                    {% when 'eco' %}
                      <svg class="feature-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4c-1.48 0-2.85.43-4.01 1.17l1.46 1.46C10.21 6.23 11.08 6 12 6c3.04 0 5.5 2.46 5.5 5.5v.5H19c1.66 0 3 1.34 3 3 0 1.13-.64 2.11-1.56 2.62l1.45 1.45C23.16 18.16 24 16.68 24 15c0-2.64-2.05-4.78-4.65-4.96zM3 5.27l2.75 2.74C2.56 8.15 0 10.77 0 14c0 3.31 2.69 6 6 6h11.73l2 2L21 20.73 4.27 4 3 5.27zM7.73 10l8 8H6c-2.21 0-4-1.79-4-4s1.79-4 4-4h1.73z"/></svg>
                    {% when 'movable' %}
                      <svg class="feature-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    {% else %}
                      <svg class="feature-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  {% endcase %}
                  {{ block.settings.title }}
                </div>
                <p class="feature-text">{{ block.settings.text }}</p>
              </div>
            {% endfor %}
          </div>
        {% endif %}


      </div>
    </div>
  </div>
</div>

<script>
  // Custom video controls are handled by custom-video-controls.js
</script>


{% schema %}
{
  "name": "Quell 2 Person Landing",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video_src",
      "label": "Video"
    },
    {
      "type": "text",
      "id": "video_height",
      "label": "Video Height",
      "default": "auto",
      "info": "CSS value, e.g. auto, 500px, 60vh"
    },
    {
      "type": "header",
      "content": "Poster Image"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Poster Image"
    },
    {
      "type": "text",
      "id": "poster_width",
      "label": "Poster Width",
      "default": "100%",
      "info": "CSS value, e.g. 100%, 500px"
    },
    {
      "type": "text",
      "id": "poster_height",
      "label": "Poster Height",
      "default": "100%",
      "info": "CSS value, e.g. 100%, 500px, auto"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "video_section_width",
      "label": "Video Width (desktop)",
      "options": [
        { "value": "30", "label": "30%" },
        { "value": "35", "label": "35%" },
        { "value": "40", "label": "40%" },
        { "value": "45", "label": "45%" },
        { "value": "50", "label": "50%" },
        { "value": "55", "label": "55%" },
        { "value": "60", "label": "60%" },
        { "value": "65", "label": "65%" },
        { "value": "70", "label": "70%" }
      ],
      "default": "50",
      "info": "Width of the video panel on desktop. The content panel fills the remaining space."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "Quell 2 Person Office Phone Booth"
    },
    {
      "type": "text",
      "id": "product_subtitle",
      "label": "Subtitle",
      "default": "Your Personal Workspace Sanctuary"
    },
    {
      "type": "textarea",
      "id": "product_description",
      "label": "Description",
      "default": "Transform your busy office into a haven of productivity. The Quell 2 Person Office Phone Booth offers an ergonomically designed cocoon of tranquility, allowing you to focus on what matters most without interruption."
    },
    {
      "type": "text",
      "id": "benefits_title",
      "label": "Benefits Section Title",
      "default": "Why Choose Quell 2 Person?"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "View Full Details & Pricing"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Add a benefit item"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "acoustics", "label": "Acoustics" },
            { "value": "setup", "label": "Setup" },
            { "value": "eco", "label": "Eco-Friendly" },
            { "value": "movable", "label": "Movable" }
          ],
          "default": "acoustics"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Feature description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quell 2 Person Landing"
    }
  ]
}
{% endschema %}
