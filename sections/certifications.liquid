<style>
  .product-icon-text-section .page-width{
    max-width:unset;
    display:flex;
    overflow:auto;
  }
  .product-icon-text-section .text-block{
    white-space:nowrap
  }
  .product-icon-text-section .flexbox{
    justify-content:center;flex-shrink: 0;

  }
     .product-icon-text-section .icon-text-block .col{
      flex:unset
    }
    .product-icon-text-section .flexbox >.col{
       max-width: 350px;
    }
  @media screen and (max-width: 860px) {

      .product-icon-text-section-{{ section.id }} .col:not(:first-child){
    display:none
  }
   .product-icon-text-section-{{ section.id }} .slick-initialized.slick-slider .col{
    display:unset
  }
  }
</style>
<section class="product-icon-text-section product-icon-text-section-{{ section.id }}">
  <div class="page-width">
    <div class="flexbox">
      {% for certification in shop.metaobjects.certifications.certifications.certifications.value %}
        {% assign image = certification.image %}
        {% if image %}
          <div
            class="col"
          >
            <div class="col-wrap">
              <div class="icon-text-block">
                <div class="col-wrap">
                  <div class="icon-text-block">
                    <div class="icon-block">
                      <div class="icon-wrap">
                        {{ image | image_url: width: 50 | image_tag: loading: 'lazy' }}
                      </div>
                    </div>
                  </div>
                </div>

                <div class="text-block">{{ image.alt | default: certification.label }}</div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="visually-hidden">{{ section.settings.seo }}</div>
</section>
<script>
    $(window).on('load', function() {
    $('.product-icon-text-section-{{ section.id }} .flexbox').slick({
      slidesToShow: 1,
      slidesToScroll: 1,
      mobileFirst: true,
      arrows: false,
      autoplay: true,
      dots: false,
      responsive: [
        {
          breakpoint: 861,
          settings: 'unslick'
        }
      ]
    });
  })
</script>

{% schema %}
{
  "name": "certifications",
  "settings": [
      {
        "type": "checkbox",
        "id": "dynamic",
        "label": "Dynamic",
        "default":false
      },
     {
       "type": "text",
      "id": "seo",
      "label": "SEO title",
      "default":"FULLY CERTIFIED & TESTED"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "name": "Icon Text Block",
      "type": "icon-text-block",
      "settings": [
        {
          "type": "image_picker",
          "id": "iconimage",
          "label": "Icon Image"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
    "presets": [
     {
       "name": "certifications",
       "blocks": []
     }
   ]
}
{% endschema %}
