{%- comment -%}
  Product FAQs from metafield
  Reads product.metafields.custom.faqs (list.metaobject_reference of type 'faqs')
  Renders accordion + FAQPage JSON-LD for AEO/SEO
  Created via Claude MCP on 2026-05-14 (SBS-38 fix)
{%- endcomment -%}

{%- assign faqs = product.metafields.custom.faqs.value -%}
{%- if faqs != blank and faqs.size > 0 -%}
<section class="product-faqs-metafield index-section">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <header class="section-header text-center">
        <h2 class="section-header__title title-font">{{ section.settings.heading | escape }}</h2>
      </header>
    {%- endif -%}

    <div class="product-faqs-metafield__list">
      {%- for faq in faqs -%}
        {%- if faq.question != blank -%}
          {%- assign faq_id = faq.id | replace: 'gid://shopify/Metaobject/', '' -%}
          <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <button
              type="button"
              class="label collapsible-trigger collapsible-trigger-btn collapsible-trigger-btn--borders collapsible--auto-height"
              aria-controls="FAQ-mf-content-{{ faq_id }}"
              aria-expanded="false"
            >
              <span class="collapsible-trigger__layout">
                <span style="padding-right:50px">
                  <span itemprop="name">{{ faq.question }}</span>
                </span>
                {%- render 'collapsible-icons' -%}
              </span>
            </button>
            <div
              id="FAQ-mf-content-{{ faq_id }}"
              class="collapsible-content collapsible-content--all"
              itemscope
              itemprop="acceptedAnswer"
              itemtype="https://schema.org/Answer"
            >
              <div class="collapsible-content__inner rte" itemprop="text">
                {%- comment -%} SBS US market launch: corrects the shared UK/Europe delivery statement for US sessions only. See snippets/sbs-us-market-copy.liquid. {%- endcomment -%}
                {%- capture sbs_faq_answer_raw -%}{{ faq.text | metafield_tag }}{%- endcapture -%}
                {%- capture sbs_faq_answer -%}{%- render 'sbs-us-market-copy', text: sbs_faq_answer_raw -%}{%- endcapture -%}
                {{ sbs_faq_answer }}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign first_emitted = false -%}
    {%- for faq in faqs -%}
      {%- if faq.question != blank -%}
        {%- if first_emitted -%},{%- endif -%}
        {
          "@type": "Question",
          "name": {{ faq.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            {%- capture sbs_faq_schema_raw -%}{{ faq.text | metafield_tag }}{%- endcapture -%}
            {%- capture sbs_faq_schema -%}{%- render 'sbs-us-market-copy', text: sbs_faq_schema_raw -%}{%- endcapture -%}
            "text": {{ sbs_faq_schema | strip_html | strip_newlines | json }}
          }
        }
        {%- assign first_emitted = true -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product FAQs (metafield)",
  "tag": "section",
  "class": "section-product-faqs-metafield",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs"
    }
  ],
  "presets": [
    {
      "name": "Product FAQs (metafield)"
    }
  ]
}
{% endschema %}
