{%- comment -%} DEBUG VERSION - tests section inclusion {%- endcomment -%}
<section class="product-faqs-metafield-debug" style="padding:40px;background:#ffeb3b;border:4px solid red;text-align:center;">
  <h2 style="font-size:24px;font-weight:bold">FAQ SECTION DEBUG MARKER</h2>
  <p>If you see this, the section IS being included by templates/product.json.</p>
  <p>Product handle: {{ product.handle }}</p>
  {%- if product.metafields.custom.faqs == blank -%}
    <p>Metafield is BLANK</p>
  {%- else -%}
    <p>Metafield is SET</p>
    <p>faqs metafield type: {{ product.metafields.custom.faqs.type }}</p>
    {%- assign faqs = product.metafields.custom.faqs.value -%}
    <p>faqs.value size: {{ faqs.size }}</p>
    {%- if faqs.size > 0 -%}
      <p>First faq id: {{ faqs.first.id }}</p>
      <p>First faq question: {{ faqs.first.question }}</p>
      <p>First faq question.value: {{ faqs.first.question.value }}</p>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product FAQs (metafield)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs"
    }
  ],
  "presets": [
    {
      "name": "Product FAQs (metafield)"
    }
  ]
}
{% endschema %}
