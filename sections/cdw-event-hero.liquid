      //       // Extract the slug (last part of the URL)
      //       const slug = link.split('/').pop();
      //       slugToLinkMap[slug] = link;
      //   });
    // Function to handle hash changes
        function handleHashChange() {
            const hash = window.location.hash.substring(1);
            const slug = hash.split('/').pop();
          console.log({slug})
            let e = document.querySelector(`#${slug}-value`)
            if(e){
              e.checked=true
            }
        }

        // Listen for hash changes
        window.addEventListener('hashchange', handleHashChange);

        // Check the hash when the page initially loads
        document.addEventListener('DOMContentLoaded', handleHashChange);
  })()
</script>
{% schema %}
{
  "name": "cdw-event-hero",
  "settings":[
    {
      "type": "image_picker",
      "id": "bg",
      "label": "Background"
    }
    ,
    {
    "type": "checkbox",
    "id": "hidemap",
    "label": "Hide map"
  }, {
          "type": "url",
          "id": "calendly_url",
          "label": "calendly url"
        },{
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
  },{
          "type": "text",
          "id": "form-title",
          "label": "Form title",
    "default":"Find Out How Acoustic Booths Can Help Focus & Productivity"
        },{
          "type": "text",
          "id": "sub-heading-top",
          "label": "Sub Heading",
    "default":"Embracing Sustainability"
        },{
          "type": "text",
          "id": "heading",
          "label": "Heading",
    "default":"Embracing Sustainability"
        },
    {
          "type": "text",
          "id": "sub-heading-bottom",
          "label": "Sub Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
            "default":"<p>As a pioneer in crafting soundproof phone booths, office pods, and meeting rooms for businesses, we take pride in our unwavering commitment to eco-friendly manufacturing practices. Join us as we embark on a journey toward agreener future, one sustainable product at a time.</p>"
        },
     {
          "type": "richtext",
          "id": "date20th",
          "label": "20th"
        },
     {
          "type": "richtext",
          "id": "date21st",
          "label": "21st"
        },
     {
          "type": "richtext",
          "id": "date22nd",
          "label": "22nd"
        },

{
          "type": "richtext",
          "id": "address",
          "label": "Address"
        },
  ],
  "presets": [
    {
      "name": "cdw-event-hero",
      "blocks": []
    }
  ]
}
{% endschema %}
