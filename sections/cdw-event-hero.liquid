{% comment %}
  https://play.tailwindcss.com/qwvCADIYZy

  https://calendly.com/hush-w3u/kabine-demo-coffee-and-croissants
  https://calendly.com/hush-w3u/importance-of-biophillia-talk
  https://calendly.com/hush-w3u/guided-showroom-tour
  https://calendly.com/hush-w3u/forecasting-for-the-future-of-workplace-design-talk
  https://calendly.com/hush-w3u/quell-co-working-demo
  https://calendly.com/hush-w3u/guided-showroom-tour-1
{% endcomment %}
{% assign urls = 'https://calendly.com/hush-w3u/kabine-demo-coffee-and-croissants,
  https://calendly.com/hush-w3u/importance-of-biophillia-talk,
  https://calendly.com/hush-w3u/guided-showroom-tour,
  https://calendly.com/hush-w3u/forecasting-for-the-future-of-workplace-design-talk,
  https://calendly.com/hush-w3u/quell-co-working-demo,
  https://calendly.com/hush-w3u/guided-showroom-tour-clone,
  https://calendly.com/hush-w3u/guided-showroom-tour-1'
  | split: ','
%}
<script src="https://cdn.tailwindcss.com?plugins=typography,forms"></script>
<style type="text/tailwindcss">
  @layer base {
    h2 {
          font-size: calc(var(--typeHeaderSize)*.85);
    }
  }
</style>

{%- assign form_id = 'consultation-form' -%}
<style>
       .call-image-wrap img{
         opacity:0.9;
  width:min(300px,30vw) !important;

  }
  *{
      scroll-margin-top: 160px;
  }
  #consultation-form-wrap:target{
  box-shadow:  rgb(248, 250, 252) 0px 0px 0px 2px, rgb(147, 197, 253) 0px 0px 0px 6px, rgba(0, 0, 0, 0.05) 0px 1px 2px 0px
  }
  html{
    scroll-behavior: smooth;
  }
  #{{form_id}}{
    --color-error:red,

  }
  #{{form_id}} .input.blured:invalid{
    border-color: var(--color-error);
  }
  #{{form_id}} .input.blured:invalid+label{
    color: var(--color-error);
  }
  #{{form_id}} .input:not([required])+label::after{
    content: ' (Optional)';
  }
  #{{form_id}} .grid__item{
    display: flex;
    flex-direction: column-reverse;
  }
  #{{form_id}}  .grid__item input{
    padding: 0.8em;
  }
  #{{form_id}} .grid__item label{
    margin-bottom:0.2em;display:none
  }
  #Contact_us_form{
    scroll-margin-top: 140px;
    text-align:center
  }
  .calendly-inline-widget{
    display:none
  }
  .input-calendly-inline-widget{
    display:none
  }
  input:checked+.calendly-inline-widget{
    display:block
  }
</style>
<section class="relative isolate">
  <div class="page-width">
    <div class="w-full md:flex  gap-12 md:min-h-[40vw] md:items-center py-6 md:py-12 ">
      {% if section.settings.bg %}
        {{
          section.settings.bg
          | image_url: width: 1440
          | image_tag: class: 'inset-0 -z-10 h-full w-full object-cover md:absolute hidden md:block'
        }}
      {% else %}
        <div class="inset-0 -z-10 h-full w-full object-cover absolute bg-[#f7f7f7]"></div>
      {% endif %}
      {% unless section.settings.hidemap %}
        <div
          style="
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;left:0;
            pointer-events: none;    overflow: hidden;
          "
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d9929.028635293496!2d-0.096887!3d51.526843!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48766721d213ddd3%3A0xdd26ef6f7b7027b8!2sSoundbox%20Store!5e0!3m2!1sen!2s!4v1724079900595!5m2!1sen!2s"
            width="600"
            height="450"
            style="
                       border: 0;
              position: absolute;
              min-width: 100%;
              height: 100%;
              top: 0;
              left: -300px;
              max-width: unset;
              filter: grayscale(1);
              pointer-events: none;
              right: -300px;
              width: calc(100vw + 600px);
            "
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      {% endunless %}
      <div class="p-6 mb-6  md:w-3/5 bg-white rounded-lg md:p-12 md:max-w-[72ch] lg:min-h-[70%] lg:flex flex flex-col justify-center z-10 relative ">
        <div class="flex gap-4 md:gap-8">
          {% if section.settings.avatar != blank %}
            {{ section.settings.avatar | image_url: width: 500 | image_tag: class: 'max-w-[300px] w-1/3 rounded-lg' }}
          {% endif %}
          <div
            style="
              display: flex;
              flex-direction: column;
              justify-content: center;
            "
            class=" "
          >
            <p class="opacity-70">{{ section.settings['sub-heading-top'] }}</p>
            <h1 class="text-2xl md:text-4xl font-semibold h2 m-0">{{ section.settings.heading }}</h1>
            <p class="opacity-70">{{ section.settings['sub-heading-bottom'] }}</p>
          </div>
        </div>
        <div class="my-4 md:my-8 md:text-lg prose prose-a:underline prose-ul:text-sm">
          {{ section.settings.content }}
          {% if section.settings.date20th %}
            <div class="grid grid-cols-2 gap-3 m-0 mt-4 ">
              <div>
                {{ section.settings.date20th }}
              </div>
              <div>
                {{ section.settings.date21st }}
              </div>
              <div>
                {{ section.settings.date22nd }}
              </div>
            </div>
          {% endif %}
          {% if section.settings.address %}
            <div>
              {{ section.settings.address }}
            </div>
          {% endif %}
        </div>
        {% if section.settings.btn_text != blank %}
          <p>
            <a
              class="btn  bg-[var(--colorBtnPrimary)]"
              href="{{ section.settings.btn_url }}"
              onclick="Calendly.initPopupWidget({url: '{{ section.settings.calendly_url | default :'https://calendly.com/james-low-wyy/consultancy' }}?hide_gdpr_banner=1'});return false;"
            >
              {{- section.settings.btn_text | default: 'Schedule Design Survey ' -}}
            </a>
          </p>
        {% endif %}
      </div>
      <div class="flex-1">
        <div
          id="consultation-form-wrap"
          class="form-vertical shadow-lg rounded-lg bg-white target:ring-3 rounded-lg z-10 relative "
          style="
            max-width: 480px;
            margin: auto;
            border: 2px solid;
            padding: 2px;
          "
        >
          <div>
            <!-- Calendly inline widget begin -->

            {% for url in urls %}
              {% assign slug = url | split: '/' | last %}
              <input
                {% if forloop.first %}
                  checked
                {% endif %}
                hidden
                type="radio"
                id="{{ slug }}-value"
                name="calendly-inline-widget"
                value="{{ slug }}"
                class="input-calendly-inline-widget hide hidden"
              >
              <div
                id="{{ slug }}"
                class="calendly-inline-widget "
                data-url="{{  url | default :'https://calendly.com/hush-w3u/kabine-demo-coffee-and-croissants'  }}?hide_gdpr_banner=1"
                style="min-width:320px;height:600px;"
              ></div>
            {% endfor %}
            <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
            <!-- Calendly inline widget end -->
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
