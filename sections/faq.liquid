You can learn more about this (and learn how to cleanly revert these changes) at https://yoa.st/removing-theme-changes.
{%- endcomment -%}

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 769px) {
    .faq-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 2rem;
    }
  }
  .faq-grid .collapsible-trigger h2.faq-question-heading {
    margin: 0;
    padding: 0;
    font-size: 1em;
    font-weight: 600;
    text-transform: none;
    letter-spacing: normal;
    display: block;
  }
</style>

{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div class="page-width">
  {%- if section.settings.title != blank -%}
    <header class="section-header text-center">
      <h2 class="section-header__title title-font">
        {{ section.settings.title | escape }}
      </h2>
    </header>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="faq-grid">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {% case block.type %}
          {% when 'rich-text' %}
            <div class="index-section index-section--faq">
              <div class="text-{{ block.settings.align_text }}">
                {%- if block.settings.title != blank -%}
                  <p class="h2">
                    {{ block.settings.title | escape }}
                  </p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte">
                    {%- if block.settings.enlarge_text %}<div class="enlarge-text">{% endif -%}
                    {{ block.settings.text }}
                    {%- if block.settings.enlarge_text %}</div>{% endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>

          {% when 'question' %}
            <div {% if disabled_by_yoast_seo %}itemscope{% endif %} {% if disabled_by_yoast_seo %}itemprop="mainEntity"{% endif %} {% if disabled_by_yoast_seo %}itemtype="https://schema.org/Question"{% endif %}>
              <button
                type="button"
                class="collapsible-trigger collapsible-trigger-btn collapsible-trigger-btn--borders collapsible--auto-height"
                aria-controls="FAQ-content-{{ block.id }}"
              >
                <span class="collapsible-trigger__layout">
                  <span style="padding-right:50px">
                    <h2 {% if disabled_by_yoast_seo %}itemprop="name"{% endif %} class="faq-question-heading">{{ block.settings.title }}</h2>
                  </span>
                  {%- render 'collapsible-icons' -%}
                </span>
              </button>
              <div
                id="FAQ-content-{{ block.id }}"
                class="collapsible-content collapsible-content--all"
                {% if disabled_by_yoast_seo %}itemscope{% endif %}
                {% if disabled_by_yoast_seo %}itemprop="acceptedAnswer"{% endif %}
                {% if disabled_by_yoast_seo %}itemtype="https://schema.org/Answer"{% endif %}
              >
                <div class="collapsible-content__inner rte" {% if disabled_by_yoast_seo %}itemprop="text"{% endif %}>
                  {{ block.settings.text }}
                </div>
              </div>
            </div>
        {% endcase %}
      </div>
    {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size == 0 -%}
    <div class="placeholder-noblocks">
      {{ 'home_page.onboarding.no_content' | t }}
    </div>
  {%- endif -%}
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FAQs"
    }
  ],
  "blocks": [
    {
      "type": "rich-text",
      "name": "Rich text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Rich text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this section for any descriptive text you need to fill out your pages or to add introductory headings between other blocks.</p>"
        },
        {
          "type": "select",
          "id": "align_text",
          "label": "Text alignment",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Centered"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Frequently asked question"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this text to answer questions in as much detail as possible for your customers.</p>"
        }
      ]
    }
  ],
  "presets": [{
    "name": "FAQ",
    "blocks": [
      {
        "type": "question"
      },
      {
        "type": "question"
      }
    ]
  }]
}
{% endschema %}
