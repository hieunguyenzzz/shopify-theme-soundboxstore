{% style %}
         .main-content {
            font-size: min(20px,4vw);
            --image-bg: #e9f0f0;
        }
   .collection-main-header-wrap{
         margin-bottom: 0em;

   }
         .main-content header {
           padding-top:2em;
        }

         .main-content header .image {
            aspect-ratio: 3 / 2 ;
            object-fit: cover;
        }
         {% assign title_size = 0 | plus:section.settings.title_size %}
       .main-content header .collection-main-title  {
            font-size: min({{ title_size }}.4em, 10vw);
            line-height: 1.14;
            font-weight: 500;
            max-width: 24ch;
         margin-bottom:0.5em
        }
  .main-content header .collection-main-subtitle  {
         margin-top:0.3em;

            font-size: min(0.6em, 16px);

        }
         .main-content header .delivery-message {
            opacity: 0.4;
        }

        .collection-main-description {
            padding: 1em 0
        }

        .products_count {
            font-size: 0.8;
            margin-bottom: 1em;
        }

        .products_count span {
            opacity: 0.4
        }

        .collection-main {
            margin: 1em auto
        }

        .collection-main ul {
            list-style: none;
            margin: 0;
            display: grid;
            gap: 1em;
        }

        .collection-main ul li {
            position: relative;
        }

        .collection-main ul li:before {
            content: ''
        }

        .collection-product-item .content {
            padding: 1em;
        }

        .collection-product-item .content>* {
            margin-bottom: 0.5em
        }

        .collection-product-item {
            gap: 0;
            /* flex-direction: column; */
            align-items: center;
            /* padding: 1em 0; */
            font-size: 0.9em;
            display: flex;
            background: var(--image-bg);
            border-radius: 1em;
        }

        .collection-product-item .image {
            /* background:var(--image-bg); */
            aspect-ratio: 1 / 1;
            position: relative;
            /* padding-bottom: 100%; */
            display: block;
        }

        .collection-product-item .image img {
            position: absolute;
            padding: 1px;
            top: 0;
            left: 0;
            width: 100%;
            border-radius: 1em;
            height: 100%;
        }

        .collection-product-item .image {
          border-radius: 1em;
          min-width: 50%;
          width:50%;
          max-width: min(500px,50%);
          flex-shrink: 0;
        }

        .collection-product-item .collection-btn-group {
            justify-content: center;
            margin-top: 1em;
        }
    }

    .collection-main .image img:not(:first-child) {
        opacity: 0
    }

    .collection-main .collection-product-item h3 {
        margin: 0;
        font-size: min(1.4em, 4vw);
        text-transform: uppercase;
        font-weight: 500
    }

    .collection-main .collection-product-item:hover .image img {
        filter: drop-shadow(0px 4px 16px rgba(0, 0, 0, 0.00)) drop-shadow(0px 3.28515px 5.84026px rgba(0, 0, 0, 0.0827978)) drop-shadow(0px 1.59488px 2.83534px rgba(0, 0, 0, 0.0667549))
    }

    .collection-main .collection-product-item .subtitle {
        opacity: 0.4
    }

    .collection-main .collection-product-item .image.had_image_2 img:not(:first-child) {
         opacity: 0
    }

    .collection-main .collection-product-item:hover .image.had_image_2 img:not(:first-child) {
       opacity: 1
    }

    .collection-main .collection-product-item:hover .image.had_image_2 img:first-child {
        opacity: 0
    }

    .collection-main .collection-product-item .itemprice {
        font-size: 1.2em;
        text-transform: capitalize;
    }

    .collection-main .collection-product-item .compare_at_price {
        opacity: 0.4;
        font-size: 0.8em;
        text-decoration: line-through;
    }

    .collection-main .collection-product-item .seats img {
        height: 1.4em;
        width: auto;
    }

    @media screen and (min-width: 979px) {
           .main-content  {
           padding-top:0;
           padding-bottom:0;
        }
        .collection-main ul {
            grid-template-columns: 1fr 1fr;
        }
   .collection-main-header-wrap{
     background: var(--image-bg);
   }
         .main-content  .collection-main-content {
            display: flex;
            justify-content: space-between;
            flex-direction: row-reverse;
            gap: 3em;
            align-items: center;
        }

         .main-content  .collection-main-content .collection-main-description {
            flex: 1 1 aut0;
            max-width: 520px;
        }
       .main-content  .collection-main-content .collection-main-description {
            flex: 1 1 520px;
            max-width: 520px;
        }
        .main-content  .collection-main-content .image {
   flex: 1 ;min-width:0
        }
    }
    @font-face {
    font-family: 'JudgemeStar';
    src: url("data:application/x-font-woff;charset=utf-8;base64,") format("woff");
    font-weight: normal;
    font-style: normal
  }

  .jdgm-star {
    font-family: 'JudgemeStar';
    display: inline !important;
    text-decoration: none !important;
    padding: 0 0px 0 0 !important;
    margin: 0 !important;
    font-weight: bold;
    opacity: 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale
  }

  .jdgm-star:hover {
    opacity: 1
  }

  .jdgm-star:last-of-type {
    padding: 0 !important
  }

  .jdgm-star.jdgm--on:before {
    content: "\e000"
  }

  .jdgm-star.jdgm--off:before {
    content: "\e001"
  }

  .jdgm-star.jdgm--half:before {
    content: "\e002"
  }

  .jdgm-widget * {
    margin: 0;
    line-height: 1.4;
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;
    -webkit-overflow-scrolling: touch
  }

  .jdgm-hidden {
    display: none !important;
    visibility: hidden !important
  }

  .jdgm-temp-hidden {
    display: none
  }

  .jdgm-spinner {
    width: 40px;
    height: 40px;
    margin: auto;
    border-radius: 50%;
    border-top: 2px solid #eee;
    border-right: 2px solid #eee;
    border-bottom: 2px solid #eee;
    border-left: 2px solid #ccc;
    -webkit-animation: jdgm-spin 0.8s infinite linear;
    animation: jdgm-spin 0.8s infinite linear
  }
{% endstyle %}
{% unless collection %}
  {% assign collection = section.settings.collection | default: settings.collection_products %}
{% endunless %}
{% assign title = section.settings.title | default: collection.metafields.custom.card_title.value %}
{% assign description = section.settings.subheading_richtext
  | default: collection.metafields.custom.card_description.value
%}
{% assign image = section.settings.image | default: collection.metafields.custom.card_image.value %}
{% render '[call-out-dot-banner]',
  blocks: section.blocks,
  title: title,
  subtitle: section.settings.subtitle,
  description: description,
  image: image,
  products: collection.products,
  products_count: collection.products_count
%}
{% if section.settings.show_products %}
  {% render 'collection-main-products',
    title: title,
    description: description,
    image: image,
    collection: collection,
    products: collection.products,
    products_count: collection.products_count
  %}
{% endif %}
{% assign highlight_content = collection.metafields.custom.highlight %}
{% if highlight_content != blank %}
  {% assign collection_desc_section_id = 'collection-desc-' | append: section.id %}
  <style>
    .collection-desc-checkbox{
      display:none
    }
    #{{collection_desc_section_id}}{
      margin-top:0;
      position: relative;
      isolation: isolate;
      max-height:250px;
      height:250px;
      overflow:hidden;
      position:relative;
      transition: all 0.7s cubic-bezier(0.95, 0.3, 0.56, 0.96);
    }
    #{{collection_desc_section_id}} .page-width{
      padding-bottom:70px ;
    }
    #{{collection_desc_section_id}}{
      --view-less:none;
      --view-more:block;
      margin-top:40px;
      border-top:1px solid #e8e8e1;
      padding:0;
    }
    #{{collection_desc_section_id}} .page-width-inner{
      margin: 0;
      padding-top: 60px;
      padding-bottom: 60px;
    }
    #{{collection_desc_section_id}} .page-width-overlay {
      pointer-events:none;
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 250px;
      display: flex;
      z-index: 10;
      align-items: flex-end;
      justify-content: center;
      padding: 12px;
      transition: all 0.7s cubic-bezier(0.95, 0.3, 0.56, 0.96);
    }
    #{{collection_desc_section_id}} .page-width-overlay:before{
      content:'';
      position:absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height:100%;
      background: rgb(255,255,255);
      background: linear-gradient(357deg, rgba(255,255,255,1) 0%, rgba(255,255,255,1) 15%, rgb(255 255 255 / 0%) 100%);
      transition: all 0.7s cubic-bezier(0.95, 0.3, 0.56, 0.96);
      opacity: 1;
      z-index:-1;
    }
    .collection-desc-checkbox:checked~#{{collection_desc_section_id}}{
      max-height:var(--innerHeight);
      height:var(--innerHeight);
      --view-less:block;
      --view-more:none;
    }
    .collection-desc-checkbox:checked~#{{collection_desc_section_id}} .page-width-overlay::before{
      opacity: 0;
      visibility: hidden;
    }
    #{{collection_desc_section_id}} .page-width-overlay label{
      pointer-events:auto;
      text-transform: uppercase;
      padding: 0.3em 1em;
      border: 1px solid currentColor;
      border-radius: 99em;
      font-size: 0.7em;
    }
    @media only screen and (max-width: 540px){
      #{{collection_desc_section_id}} .page-width{
        padding-bottom:120px ;
      }
    }
  </style>

  {% assign inputRef = collection_desc_section_id | append: '-checkbox' %}
  <input
    hidden
    type="checkbox"
    class="collection-desc-checkbox"
    name="name-{{ inputRef }}"
    id="{{ inputRef }}"
  >

  <div
    style="--innerHeight:720px"
    id="{{collection_desc_section_id}}"
    class="index-section text-center"
  >
    <div class="page-width-overlay">
      <label style="text-transform: uppercase;display:var(--view-more)" for="{{ inputRef }}">
        {{ 'strings.others.view_more' | t }}
      </label>
      <label style="text-transform: uppercase;display:var(--view-less)" for="{{ inputRef }}">
        {{ 'strings.others.view_less' | t }}
      </label>
    </div>

    <div class="page-width-inner">
      <div class="page-width">
        <div class="rte">
          <div class="[&_ul]:list-disc [&_ul]:ml-[30px]">
            {{ collection.metafields.custom.highlight | metafield_tag }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      function onCollapse(e) {
        const containerE = document.querySelector('#{{collection_desc_section_id}}');
        if (e.target.checked) {
          containerE.style.setProperty(
            '--innerHeight',
            containerE.querySelector('.page-width-inner').clientHeight + 'px'
          );
        } else {
          containerE.style.setProperty('--innerHeight', '250px');
        }
      }
      document.querySelector('#{{ inputRef }}').addEventListener('change', onCollapse);
    })();
  </script>
{% endif %}
<script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "CollectionPage",
      {% if collection.description != blank %}
        "description": {{ collection.description | strip_html | json }},
      {% endif %}
      {% assign page_image = collection.image %}
      {% if page_image %}
        "image": {
          "@type": "ImageObject",
          "height": {{ page_image.height | json }},
          "url": {{ page_image | image_url:  width:400 | prepend: "https:" | json }},
          "width": {{ page_image.width | json }}
        },
      {% endif %}
      "name": {{ collection.title | json }}
    }
  {%- comment -%}Yoast SEO schema control block: end.{%- endcomment -%}
</script>
{% schema %}
{
  "name": "call out dot banner",
  "settings": [
    {
      "type": "header",
      "content": "Edit content",
      "info": "Subscribers added automatically to your “accepted marketing” customer list. [Go to Edit](https://admin.shopify.com/store/thankyou-485/apps/256-metafields-editor/collections)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show products?",
      "default": true
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Overlaid Hero Slide</p>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Sub-Heading"
    },
    {
      "type": "richtext",
      "id": "subheading_richtext",
      "label": "Rich Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "name": "product",
      "type": "product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "vertical",
          "label": "Vertical",
          "min": 0,
          "max": 100,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "horizontal",
          "label": "horizontal",
          "default": 0,
          "min": 0,
          "max": 100,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner with callout dots",
      "settings": {}
    }
  ]
}
{% endschema %}
