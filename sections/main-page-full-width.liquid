<div class="page-full page-content">
  <header class="section-header">
    <h1 class="section-header__title">
      {{ page.title | escape }}
    </h1>
  </header>

  <div class="rte rte--nomargin">
    {%- comment -%} SBS-78: the page title above is the single H1; downgrade any authored H1 in the body to H2. {%- endcomment -%}
    {{ page.content | replace: '<h1>', '<h2>' | replace: '</h1>', '</h2>' | replace: '<h1 ', '<h2 ' }}
  </div>
</div>

{% schema %}
{
  "name": "Page (full width)",
  "tag": "section"
}
{% endschema %}
