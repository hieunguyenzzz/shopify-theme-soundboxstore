{% if section.settings.sliderenable %}
  <style>
      .brand-details-slider .slide{
        display: none;
      }
    .brand-details-slider  .slick-slide .image-group  img{
      display: none;
    }

      .brand-details-slider   .slick-slide.slick-current  .image-group img{
      display: block;


    }
      .brand-details-slider .slide:first-child{
        display: block;
      }
      .slick-initialized.brand-details-slider .slide{
        display: block;
      }
  </style>
{% endif %}
<style>
  .brand-details-section{
    max-width:1440px;
    margin:auto
  }
   .image-group img{
          border-radius: 0.4em;
  border-top-right-radius: min(4em,12vw);

  }
  .brand-details-section .image-group{
    padding:0 10px;
    gap:10px
  }
</style>
<section class="brand-details-section">
  <div class="{% if section.settings.sectionwidth %}section-wrap{% else %}page-width{% endif %}">
    {% if section.settings.title != blank %}
      <div class="section-header text-center">
        <h2 class="title-font" style="margin-bottom:0;padding-bottom:5px">{{ section.settings.title }}</h2>
        <div>
          {% if section.settings.content != blank %}
            {{ section.settings.content }}
          {% else %}
            {{ 'strings.general.gallery_subheading' | t }}
          {% endif %}
        </div>
        {% if section.settings.btn_url %}
          <div class="section-btn" style="margin-top:1em">
            <a href="{{ section.settings.btn_url }}" class="btn">
              {{- section.settings.btn_text }}
            </a>
          </div>
        {% endif %}
        <div></div>
      </div>
    {% endif %}
    {%- for block in shop.metaobjects.customer_gallery.values -%}
      {% assign content = block.content | metafield_tag %}
      {% assign galleryid = section.id | append: '-' | append: forloop.index %}

      <div
        style="display:none"
      >
        {% for image in block.images.value %}
          <a
            style="display:none"
            href="{{ image | image_url }}"
            class="image-wrap"
            data-fancybox="{{ galleryid }}"
            data-caption="&lt;b&gt;{{ block.title }}&lt;/b&gt;&lt;br /&gt;{{ content | escape  }}"
          >
          </a>
        {% endfor %}
      </div>
    {% endfor %}
    <div class="brand-details-slider {% if section.blocks.size > 1 %}active{% endif %}">
      {%- for block in shop.metaobjects.customer_gallery.values -%}
        <div class="slide  slide-{{- block.id -}}">
          <div class="slide-wrap page-width">
            <div class="slide-top-section">
              <div class="flexbox">
                <div class="col left-col">
                  <div class="col-wrap">
                    {% if block.logo != blank %}
                      {{ block.logo | image_url: width: 200 | image_tag: loading: 'lazy' }}
                    {% endif %}
                  </div>
                </div>
                <div class="col right-col">
                  <div class="col-wrap">
                    {% assign galleryid = section.id | append: '-' | append: forloop.index %}
                    <div
                      id="slider-{{ galleryid }}"
                      class="image-group {% if block.images.size > 3 %}not-two-col-show{% endif %}"
                    >
                      {% for image in block.images.value %}
                        <div class="image-col">
                          <a
                            href="#{{ galleryid }}-{{ forloop.index }}"
                            class="image-wrap"
                          >
                            {{
                              image
                              | image_url: width: 400, crop: 'center'
                              | image_tag:
                                widths: '100, 160,200, 400',
                                sizes: '(min-width: 768px) 400px,(min-width: 425px) 150px, 30vw',
                                loading: 'lazy'
                            }}
                          </a>
                        </div>
                      {% endfor %}
                    </div>
                    {% if block.images.value.size > 3 %}
                      <style>
                                            #shopify-section-{{section.id}} #slider-{{ galleryid }}{
                                              overflow:hidden
                                            }
                                            #shopify-section-{{section.id}} #slider-{{ galleryid }} .image-col{
                                                  max-width: 33.33%;
                        width: 33%;
                        flex-shrink: 0;
                                            }
                                            #shopify-section-{{section.id}} #slider-{{ galleryid }} .slick-arrow{
                                                                    background:#000000b5 !important;
                                                                    bottom:50%;filter: invert(1);border-radius:100%;transform: translateY(50%)
                                            }
                                             #shopify-section-{{section.id}} #slider-{{ galleryid }} .slick-next{
                                               padding-left:8px
                                             }
                                            #shopify-section-{{section.id}} #slider-{{ galleryid }} .slick-arrow::after {
                                              background-size: contain;
                                            }
                         #shopify-section-{{section.id}} #slider-{{ galleryid }} .slick-arrow.slick-prev{
                           left:20px
                         }
                         #shopify-section-{{section.id}} #slider-{{ galleryid }} .slick-arrow.slick-next{
                           right:20px
                         }
                      </style>
                      <script>
                                               document.addEventListener(
                          "app:ready",
                          (e) => {
                                            $(document).ready(function(){
                                              $('#slider-{{ galleryid }}').slick({
                                                infinite: true,
                                                draggable:false,
                                                slidesToShow: 3,
                                                slidesToScroll: 1
                                              });
                                              $('[data-fancybox="gallery"]').fancybox({
                                                buttons: [
                                                  "slideShow",
                                                  "thumbs",
                                                  "zoom",
                                                  "fullScreen",
                                                  "share",
                                                  "close"
                                                ],
                                                loop: false,
                                                protect: true
                                              });
                                            })
                              },
                          false,
                        );
                      </script>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
            <div class="slide-bottm-section">
              <div class="flexbox">
                <div class="col left-col">
                  <div class="col-wrap">
                    <h4>{{ block.title }}</h4>
                    <h6>{{ block.subtitle }}</h6>
                  </div>
                </div>
                <div class="col right-col">
                  <div class="col-wrap">
                    {{ content }}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if section.settings.sliderenable %}
  <script>
        document.addEventListener(
      "app:ready",
      (e) => {
      $(document).ready(function(){
        $('.brand-details-section .brand-details-slider.active').slick({
          infinite: true,
          slidesToShow: 1,
          slidesToScroll: 1,
          adaptiveHeight: true,
          dots: {% if section.settings.slide_dots %}true{% else %}false{% endif %},
          arrows: {% if section.settings.slide_arrow %}true{% else %}false{% endif %},
          fade: true,
          cssEase: 'linear',
          responsive: [
            {
              breakpoint: 1024,
              settings: {
                arrows:false,
              }
            }
          ]
        });
      })
         },
      false,
    );
  </script>
{% endif %}
<link
  rel="stylesheet"
  type="text/css"
  defer
  async
  href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.css"
>
<script src="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.js" defer async></script>
{% schema %}
 {
   "name": "Customer gallery",
"class": "index-section",
   "settings": [
      {
           "type": "text",
           "id": "title",
           "label": "Title"
         },
       {
           "type": "richtext",
           "id": "content",
           "label": "Content"
         },
	{
         "type": "checkbox",
         "id": "sliderenable",
         "label": "Slide Enable",
	  "default": true
       },
	{
         "type": "checkbox",
         "id": "slide_dots",
         "label": "Slide Dots"
       },
       {
         "type": "checkbox",
         "id": "slide_arrow",
         "label": "Slide Arrow"
       },
       {
         "type": "checkbox",
         "id": "sectionwidth",
         "label": "Full Width",
         "default": false
       },
        {
           "type": "text",
           "id": "btn_text",
           "label": "Button text"
         },
      {
           "type": "url",
           "id": "btn_url",
           "label": "Button url"
         }
],
   "blocks": [

   ],
   "presets": [
     {
       "name": "Customer galelry",
       "blocks": []
     }
   ]
 }
{% endschema %}
