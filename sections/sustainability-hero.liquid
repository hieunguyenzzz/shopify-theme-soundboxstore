{% comment %}
  https://play.tailwindcss.com/qwvCADIYZy
{% endcomment %}
<!-- Preconnect to Calendly for faster widget loading -->
<link rel="preconnect" href="https://assets.calendly.com" crossorigin>
<link rel="preconnect" href="https://calendly.com" crossorigin>
<script src="https://cdn.tailwindcss.com?plugins=typography,forms"></script>
<style type="text/tailwindcss">
  @layer base {
    h2 {
      font-size: calc(var(--typeHeaderSize) * 0.85);
    }
  }
</style>
{%- assign form_id = 'consultation-form' -%}
<style>
  *{
      scroll-margin-top: 160px;
  }
  #consultation-form-wrap:target{
  box-shadow:  rgb(248, 250, 252) 0px 0px 0px 2px, rgb(147, 197, 253) 0px 0px 0px 6px, rgba(0, 0, 0, 0.05) 0px 1px 2px 0px
  }
  html{
    scroll-behavior: smooth;
  }
  #{{form_id}}{
    --color-error:red,
  }
  #{{form_id}} .input.blured:invalid{
    border-color: var(--color-error);
  }
  #{{form_id}} .input.blured:invalid+label{
    color: var(--color-error);
  }
  #{{form_id}} .input:not([required])+label::after{
    content: ' (Optional)';
  }
  #{{form_id}} .grid__item{
    display: flex;
    flex-direction: column-reverse;
  }
  #{{form_id}}  .grid__item input{
    padding: 0.8em;
  }
  #{{form_id}} .grid__item label{
    margin-bottom:0.2em;display:none
  }
  #Contact_us_form{
    scroll-margin-top: 140px;
    text-align:center
  }
</style>
<section class="relative isolate bg-[#e9f0f0]">
  <div class="page-width">
    <div
      class="w-full md:flex gap-12 md:min-h-[40vw] md:items-center py-6 md:py-12  "
    >
      {% if section.settings.gray %}
        {% if section.settings.image %}
          {{
            section.settings.image
            | image_url: width: 3440
            | image_tag:
              style: 'filter: grayscale(1);opacity:0.3',
              class: 'inset-0 h-full w-full object-cover md:absolute hidden md:block border-b border-solid border-black border-[2px_solid_black]'
          }}
          <div
            class="absolute hidden -z-10 lg:block max-w-[70%] right-0 top-0 h-full -z-5 bg-gradient-to-l w-full from-transparent via-white/10 to-[#e9f0f0]"
          ></div>
        {% else %}
          <div class="inset-0 -z-10 h-full w-full object-cover absolute bg-[#f7f7f7]"></div>
        {% endif %}
      {% else %}
        {% if section.settings.image %}
          {{
            section.settings.image
            | image_url: width: 3440
            | image_tag:
              class: 'top-0 right-0 max-w-[70%]  -z-10 h-full w-full object-cover md:absolute hidden md:block border-b border-solid border-black border-[2px_solid_black]'
          }}
          <div
            class="absolute hidden -z-10 lg:block max-w-[70%] right-0 top-0 h-full -z-5 bg-gradient-to-l w-full from-transparent via-white/10 to-[#e9f0f0]"
          ></div>
        {% else %}
          <div class="inset-0 -z-10 h-full w-full object-cover absolute bg-[#f7f7f7]"></div>
        {% endif %}
      {% endif %}

      <div
        style="
          background: #ffffffb8;
          backdrop-filter: blur(3px);
        "
        class="py-6  md:w-1/2 md:bg-white rounded-lg md:p-12 md:max-w-[52ch] lg:min-h-[70%] lg:flex flex flex-col justify-center "
      >
        <div class="flex gap-4 md:gap-8">
          {% if section.settings.avatar %}
            {{ section.settings.avatar | image_url: width: 500 | image_tag: class: 'max-w-[300px] w-1/3 rounded-lg' }}
          {% endif %}
          <div
            style="
              display: flex;
              flex-direction: column;
              justify-content: center;
            "
            class=" "
          >
            <p class="opacity-70">{{ section.settings['sub-heading-top'] }}</p>
            <h1 class="text-2xl md:text-4xl font-semibold h2 m-0">{{ section.settings.heading }}</h1>
            <p class="opacity-70">{{ section.settings['sub-heading-bottom'] }}</p>
          </div>
        </div>
        <div class="my-4 md:my-8 md:text-2xl prose prose-a:underline">
          {{ section.settings.content }}
        </div>
        {% if section.settings.btn_text != blank %}
          <p>
            <a
              class="btn  bg-[var(--colorBtnPrimary)]"
              href="{{ section.settings.calendly_url  }}"
              onclick="Calendly.initPopupWidget({url: '{{ section.settings.calendly_url | default :'https://calendly.com/james-low-wyy/consultancy' }}?hide_gdpr_banner=1'});return false;"
            >
              {{- section.settings.btn_text | default: 'Free Design Survey ' -}}
            </a>
          </p>
        {% endif %}
      </div>
      <div class="flex-1">
        <div
          id="consultation-form-wrap"
          class="form-vertical shadow-lg rounded-lg bg-white target:ring-3 rounded-lg "
          style="
            max-width: 480px;
            margin: auto;
            border: 2;
            border: 2px solid;
            padding: 2px;
          "
        >
          <div>
            <!-- Calendly inline widget begin -->
            <div
              class="calendly-inline-widget "
              data-url="{{  section.settings.calendly_url | default :'https://calendly.com/james-low-wyy/consultancy'  }}?hide_event_type_details=1&hide_gdpr_banner=1&locale={{ request.locale.iso_code }}"
              style="min-width:320px;height:600px;position:relative;"
            >
              <!-- Loading skeleton - hidden when Calendly iframe loads -->
              <div class="calendly-loading-skeleton" style="position:absolute;inset:0;background:#fff;padding:20px;display:flex;flex-direction:column;align-items:center;">
                <div style="width:100%;max-width:300px;text-align:center;">
                  <div style="font-weight:600;font-size:18px;margin-bottom:20px;color:#333;">Select a Day</div>
                  <div style="display:flex;justify-content:center;align-items:center;gap:10px;margin-bottom:15px;">
                    <div style="width:24px;height:24px;border-radius:50%;background:#e5e7eb;"></div>
                    <div style="width:120px;height:20px;background:#e5e7eb;border-radius:4px;"></div>
                    <div style="width:24px;height:24px;border-radius:50%;background:#e5e7eb;"></div>
                  </div>
                  <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-bottom:10px;">
                    {% for i in (1..7) %}<div style="height:16px;background:#f3f4f6;border-radius:2px;"></div>{% endfor %}
                  </div>
                  {% for row in (1..5) %}
                  <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-bottom:8px;">
                    {% for i in (1..7) %}<div style="height:32px;background:#f3f4f6;border-radius:50%;animation:pulse 1.5s ease-in-out infinite;animation-delay:{{ row | times: 100 | append: 'ms' }};"></div>{% endfor %}
                  </div>
                  {% endfor %}
                </div>
                <style>@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.5}}</style>
              </div>
            </div>
            <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async onload="window.calendlyLoaded=true"></script>
            <script>
              (function(){
                function hideSkeleton(){
                  var skeleton = document.querySelector('.calendly-loading-skeleton');
                  if(skeleton) skeleton.style.display = 'none';
                }
                var checkCalendly = setInterval(function(){
                  var widget = document.querySelector('.calendly-inline-widget iframe');
                  if(widget && widget.contentWindow){
                    hideSkeleton();
                    clearInterval(checkCalendly);
                  }
                }, 100);
                setTimeout(function(){ clearInterval(checkCalendly); hideSkeleton(); }, 10000);
              })();
            </script>
            <!-- Calendly inline widget end -->
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "sustainability-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Avatar"
    },
    {
      "type": "text",
      "id": "form-title",
      "label": "Form title",
      "default": "Find Out How Acoustic Booths Can Help Focus & Productivity"
    },
    {
      "type": "text",
      "id": "sub-heading-top",
      "label": "Sub Heading",
      "default": "Embracing Sustainability"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Embracing Sustainability"
    },
    {
      "type": "text",
      "id": "sub-heading-bottom",
      "label": "Sub Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>As a pioneer in crafting soundproof phone booths, office pods, and meeting rooms for businesses, we take pride in our unwavering commitment to eco-friendly manufacturing practices. Join us as we embark on a journey toward agreener future, one sustainable product at a time.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "gray",
      "label": "Gray BG"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Free Design Survey "
    },
    {
      "type": "url",
      "id": "calendly_url",
      "label": "calendly url"
    }
  ],
  "presets": [
    {
      "name": "sustainability-hero",
      "blocks": []
    }
  ]
}
{% endschema %}
