<style>
   #shopify-section-{{ section.id }} .rte{
     color: rgb(131, 129, 129);
     font-size: 14px;
     font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
     font-weight: 400;
   }
   #shopify-section-{{ section.id }} .rte h2{
     font-size: 30px;
     font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
     font-weight: bold;
     margin:0;
     padding:10px 0;color:black
   }
   #shopify-section-{{ section.id }} .newsletter__input{
     border:1px solid black;
     -webkit-appearance: none;
     appearance: none;
     background-color: #fff;
     border-color: #6b7280;
     border-width: 1px;
     border-radius: 0px;
     padding-top: 0.5rem;
     padding-right: 0.75rem;
     padding-bottom: 0.5rem;
     padding-left: 0.75rem;
     font-size: 1rem;
     line-height: 1.5rem;
     --tw-shadow: 0 0 #0000;
   }
    #shopify-section-{{section.id}} form[data-state="loading"] .btn {
      position:relative;
      color:transparent;
      pointer-events:none;

   }
  #shopify-section-{{section.id}} .form-success{
     display:none
   }
     #shopify-section-{{section.id}}  form[data-state="success"] .form-success{
     display:block
   }
   #shopify-section-{{section.id}}  form[data-state="success"] .form-main{
     display:none
   }
    #shopify-section-{{section.id}} form[data-state="loading"] .btn:before {
       content: "";
       display: block;
       width: 22px;
       height: 22px;
       position: absolute;
       left: 50%;
       top: 50%;
       margin-left: -11px;
       margin-top: -11px;
       border-radius: 50%;
       border: 3px solid;
       border-color: var(--colorBtnPrimaryText);
       border-color: transparent #fff #fff;
       animation: spin 1s linear infinite;
   }
</style>
{% assign section_id = section.id %}
{% assign snippet_context = 'get-specs-form' %}
{%- assign form_id = 'get-specs-form-' | append: section_id -%}
{%- if section.settings.mode != 'disabled' -%}
  <div
    id="get-specs-{{ section.id }}"
    class="modal modal--square "
    data-section-id="{{ section.id }}"
    data-section-type="get-specs-popup"
  >
    <div class="modal__inner{% if section.settings.popup_image %} modal__inner--bg-image{% endif %}">
      <div class="modal__centered">
        <div
          style="max-width:min(450px,95vw);padding:20px"
          class="modal__centered-content modal__centered-content--padded color-scheme-{{ section.settings.color_scheme }}"
        >
          {%- if section.settings.color_scheme != 'none' -%}
            {%- render 'color-scheme-texture', color_scheme: section.settings.color_scheme -%}
          {%- endif -%}

          <div class="newsletter-popup">
            <form id="{{ form_id }}">
              <div class="form-success">
                <div class="rte">
                  {{ section.settings.popup_text_success }}
                </div>
                <button
                  type="button"
                  class="btn js-modal-close"
                  name="commit"
                  aria-label="{{ 'general.newsletter_form.submit' | t }}"
                  style="
                    width:100%;
                    background: rgb(48, 59, 67);
                    border-radius: 0px;
                    border-style: none;
                    border-color: rgb(0, 0, 0);
                    border-width: 2px;
                    color: rgb(255, 255, 255);
                    font-size: 14px;
                    font-weight: 700;
                    letter-spacing: 0px;
                    line-height: 1;
                    white-space: normal;
                    padding-top: 0px;
                    padding-bottom: 0px;
                    text-align: center;
                    word-break: break-word;
                    align-self: flex-end;
                    cursor: pointer;
                    pointer-events: auto;
                    height: 50px;
                    width: 100%;
                  "
                >
                  <span>{{ 'general.accessibility.close' | t }}</span>
                </button>
              </div>
              <div class="form-main">
                {%- if form.errors and form.context == snippet_context -%}
                  {{ form.errors | default_errors }}
                {%- endif -%}

                {%- if section.settings.popup_title != blank -%}
                  <div class="h2">{{ section.settings.popup_title }}</div>
                {%- endif -%}

                {%- if section.settings.popup_text != blank -%}
                  <div class="rte">
                    {{ section.settings.popup_text }}
                  </div>
                {%- endif -%}
                <label for="Email-{{ section_id }}" class="hidden-label">
                  {{- 'general.newsletter_form.newsletter_email' | t -}}
                </label>
                <input type="hidden" name="contact[tags]" value="newsletter,getSpecs">
                <input type="hidden" name="contact[context]" value="{{ snippet_context }}">
                <div class="input-group newsletter__input-group">
                  <input
                    type="name"
                    value=""
                    required
                    placeholder="{{ 'blogs.comments.name' | t }}"
                    name="contact[name]"
                    id="Name-{{ section_id }}"
                    class="input-group-field newsletter__input"
                    autocorrect="off"
                    autocapitalize="off"
                  >
                </div>
                <div class="input-group newsletter__input-group">
                  <input
                    type="email"
                    required
                    value="{% if customer %}{{ customer.email }}{% endif %}"
                    placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}"
                    name="contact[email]"
                    id="Email-{{ section_id }}"
                    class="input-group-field newsletter__input"
                    autocorrect="off"
                    autocapitalize="off"
                  >
                </div>
                <div class="input-group newsletter__input-group">
                  <input
                    type="company"
                    value=""
                    placeholder="{{ 'customer.addresses.company' | t }}"
                    name="contact[company]"
                    id="Company-{{ section_id }}"
                    class="input-group-field newsletter__input"
                    autocorrect="off"
                    autocapitalize="off"
                  >
                </div>
                <div class="input-group newsletter__input-group">
                  <select
                    type="industry"
                    value=""
                    placeholder="{{ 'contact.form.industry.title' | t }}"
                    name="contact[industry]"
                    id="Industry-{{ section_id }}"
                    class="input-group-field newsletter__input"
                    autocorrect="off"
                    autocapitalize="off"
                  >
                    <option value="Architects">
                      {{ 'customer.application.details-company-industry-options.architects' | t }}
                    </option>
                    <option value="Design & Build">
                      {{ 'customer.application.details-company-industry-options.design_and_build' | t }}
                    </option>
                    <option value="Commercial Out Fitter">
                      {{ 'customer.application.details-company-industry-options.commercial_out_fitter' | t }}
                    </option>
                    <option value="Furniture Dealer">
                      {{ 'customer.application.details-company-industry-options.furniture_dealer' | t }}
                    </option>
                    <option value="Other">
                      {{ 'customer.application.details-company-industry-options.other' | t }}
                    </option>
                  </select>
                </div>
                <div
                  class="input-group newsletter__input-group"
                  style="width: 100%; justify-content: flex-start; display: flex;"
                >
                  <label
                    style="display: flex;align-items: flex-start;flex: 1 0 100%;word-break: break-word;max-width: 100%;cursor: pointer;"
                  >
                    <input
                      tabindex="0"
                      type="checkbox"
                      id="Accepts-Marketing"
                      name="contact[Accepts-Marketing]"
                      style="
                        margin-top: 0.3em;
                        -webkit-appearance: checkbox;
                      "
                    >
                    <div style="font-size:13px;cursor: pointer;color: rgb(0, 0, 0);font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif;font-weight: 400;letter-spacing: 0px;margin-right: 24px;display: flex;position: relative;top: 1px;text-align: left;">
                      {{ section.settings.accepts_marketing_text }}
                    </div>
                  </label>
                </div>
                <div class="input-group newsletter__input-group">
                  <div class="input-group-btn" style="padding:10px 0;width:100%">
                    <button
                      type="submit"
                      class="btn"
                      name="commit"
                      aria-label="{{ 'general.newsletter_form.submit' | t }}"
                      style="
                        width:100%;
                        background: rgb(48, 59, 67);
                        border-radius: 0px;
                        border-style: none;
                        border-color: rgb(0, 0, 0);
                        border-width: 2px;
                        color: rgb(255, 255, 255);
                        font-size: 14px;
                        font-weight: 700;
                        letter-spacing: 0px;
                        line-height: 1;
                        white-space: normal;
                        padding-top: 0px;
                        padding-bottom: 0px;
                        text-align: center;
                        word-break: break-word;
                        align-self: flex-end;
                        cursor: pointer;
                        pointer-events: auto;
                        height: 50px;
                        width: 100%;
                      "
                    >
                      <span>{{ 'contact.form.send' | t }}</span>
                    </button>
                  </div>
                </div>
              </div>
            </form>
            {%- if section.settings.enable_button -%}
              <hr class="hr--clear">
              <a href="{{ section.settings.button_link }}" class="btn js-modal-close">
                {{ section.settings.button_label }}
              </a>
            {%- endif -%}
          </div>
        </div>
        <button style="padding:10px" type="button" class="btn btn--circle btn--icon modal__close js-modal-close">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64">
            <defs><style>.cls-1{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path class="cls-1" d="M19 17.61l27.12 27.13m0-27.13L19 44.74"/>
          </svg>
          <span class="icon__fallback-text">{{ 'general.accessibility.close_modal' | t | json }}</span>
        </button>
      </div>
    </div>
  </div>
{%- endif -%}
<script>

    (() => {
      
        const form = document.getElementById('{{- form_id -}}');
      function openSpecFormPopup(event) {
    event.preventDefault()
    event.stopPropagation()
    window.modals=window.modals||[]
    let modal = window.modals.find(m => m.id === "get-specs-{{- section.id -}}");
    if(!modal) {
      modal = new theme.Modals(
                "get-specs-{{- section.id -}}",
                "get-specs-popup"
              )
           theme.sections.register("get-specs-popup", modal)
    }
        form.dataset.state="input"

  }
          modal.open();
      window.openSpecFormPopup=openSpecFormPopup
        function handleSubmit(event) {
          event.preventDefault();
          try {
            console.log(`Form Submitted! Timestamp: ${event.timeStamp}`, event);
            let data = {
              create_at: new Date().toISOString(),
              type:event.target.dataset.type
            };
            new FormData(event.target).forEach((value, key) => {
                data[key] = value;
            });
            
            form.dataset.state="loading"
            fetch('{{- section.settings.api_url -}}', {
              headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json',
              },
              method: 'POST',
              mode: 'no-cors',
              body: JSON.stringify(data),
            })
              .then(function (res) {
                console.log(res, data);
                 form.dataset.state="success";
          

              })
              .catch(function (res) {
                console.log(res, data);
              });
          } catch (err) {
            console.error(err);
          }
        }
        form.addEventListener('submit', handleSubmit);
       $(".specBtn").on("click", openSpecFormPopup);
      })();
</script>
{% schema %}
{
  "name": "GET SPECS POPUP",
  "class": "index-section--hidden",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Display mode",
      "default": "disabled",
      "options": [
        {
          "value": "enabled",
          "label": "Enabled"
        },
        {
          "value": "disabled",
          "label": "Disabled"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
     {
      "type": "text",
      "id": "api_url",
      "label": "Api Url",
      "default": "https://n8n.hieunguyen.dev/webhook/quell-specification-download"
    },
    {
      "type": "text",
      "id": "popup_title",
      "label": "Heading",
      "default": "Sign up and save"
    },
    {
      "type": "richtext",
      "id": "popup_text",
      "label": "Text",
      "default": "<p>Entice customers to sign up for your mailing list with discounts or exclusive offers. Include an image for extra impact.</p>"
    },
     {
      "type": "richtext",
      "id": "popup_text_success",
      "label": "Success Text",
      "default": "<h2>Thanks for your interest!</h2><p>We’ve sent our Product Guide directly to your inbox. You can expect to receive an email from us in the next couple of minutes. Feel free to take a look around while you wait.</p>"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "paragraph",
      "content": "Every sign up will create a Customer on your store. [View customers](/admin/customers?query=&accepts_marketing=1)."
    },
    {
      "type": "checkbox",
      "id": "enable_newsletter",
      "label": "Enable newsletter",
      "default": true
    },
    {
      "type": "text",
       "label": "Accepts-Marketing text",
       "id": "accepts_marketing_text",
      "default":"Yes, I would like to receive marketing communications."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Optional button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "enable_button",
      "label": "Enable button",
      "default": false
    }
  ],
  "blocks" : []
}
{% endschema %}
