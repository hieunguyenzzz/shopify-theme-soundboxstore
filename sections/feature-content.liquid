<div style="display:none" id="feature-debug" data-blocks="{{ section.blocks.size }}" data-metafield="{{ product.metafields.custom.feature_content.value | size }}"></div>
{%- if section.blocks.size > 0 -%}
  {%- for block in section.blocks -%}
    {% render 'feature-content', block: block, index: forloop.index %}
  {%- endfor -%}
{%- endif -%}

{% schema %}
{
  "name": "Feature content",
  "settings": [],
  "blocks": [
    {
      "type": "feature-content",
      "name": "Feature content",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_from_feature",
          "label": "Or use image from feature metaobject # (1-based)",
          "info": "Falls back to the Nth entry of custom.omni_features when no image is picked"
        },
        {
          "type": "url",
          "id": "youtube_url",
          "label": "Youtube URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature content"
    }
  ]
}
{% endschema %}
