{% comment %}
  https://play.tailwindcss.com/qwvCADIYZy
{% endcomment %}
<script src="https://cdn.tailwindcss.com?plugins=typography,forms"></script>
<style type="text/tailwindcss">
  @layer base {
    h2 {
      font-size: calc(var(--typeHeaderSize) * 0.85);
    }
  }
</style>
{%- assign form_id = 'consultation-form' -%}
<style>
  *{
      scroll-margin-top: 160px;
  }
  #consultation-form-wrap:target{
  box-shadow:  rgb(248, 250, 252) 0px 0px 0px 2px, rgb(147, 197, 253) 0px 0px 0px 6px, rgba(0, 0, 0, 0.05) 0px 1px 2px 0px
  }
  html{
    scroll-behavior: smooth;
  }
  #{{form_id}}{
    --color-error:red,

  }
  #{{form_id}} .input.blured:invalid{
    border-color: var(--color-error);
  }
  #{{form_id}} .input.blured:invalid+label{
    color: var(--color-error);
  }
  #{{form_id}} .input:not([required])+label::after{
    content: ' (Optional)';
  }
  #{{form_id}} .grid__item{
    display: flex;
    flex-direction: column-reverse;
  }
  #{{form_id}}  .grid__item input{
    padding: 0.8em;
  }
  #{{form_id}} .grid__item label{
    margin-bottom:0.2em;display:none
  }
  #Contact_us_form{
    scroll-margin-top: 140px;
    text-align:center
  }
</style>
<section class="relative isolate">
  <div class="page-width">
    <div class="w-full md:flex gap-12 md:min-h-[40vw] md:items-center py-6 md:py-12 ">
      {% if section.settings.image %}
        {{
          section.settings.image
          | image_url: width: 1440
          | image_tag: class: 'inset-0 -z-10 h-full w-full object-cover md:absolute hidden md:block'
        }}
      {% else %}
        <div class="inset-0 -z-10 h-full w-full object-cover absolute bg-[#f7f7f7]"></div>
      {% endif %}
      <div class="p-y md:w-1/2 md:bg-white rounded-lg md:p-12 md:max-w-[52ch] lg:min-h-[70%] lg:flex flex flex-col justify-center ">
        <div class="flex gap-4 md:gap-8">
          {{ section.settings.avatar | image_url: width: 500 | image_tag: class: 'max-w-[300px] w-1/3 rounded-lg' }}
          <div
            style="
              display: flex;
              flex-direction: column;
              justify-content: center;
            "
            class=" "
          >
            <p class="opacity-70">{{ section.settings['sub-heading-top'] }}</p>
            <h1 class="text-2xl md:text-4xl font-semibold h2 m-0">{{ section.settings.heading }}</h1>
            <p class="opacity-70">{{ section.settings['sub-heading-bottom'] }}</p>
          </div>
        </div>
        <div class="my-4 md:my-8 md:text-2xl prose prose-a:underline">
          {{ section.settings.content }}
        </div>
        {% if section.settings.btn_text != blank %}
          <p>
            <a
              class="btn  bg-[var(--colorBtnPrimary)]"
              href=""
              onclick="Calendly.initPopupWidget({url: '{{ section.settings.calendly_url | default :'https://calendly.com/james-low-wyy/consultancy' }}?hide_gdpr_banner=1'});return false;"
            >
              {{- section.settings.btn_text | default: 'Free Design Survey ' -}}
            </a>
          </p>
        {% endif %}
      </div>
      <div class="flex-1">
        <div
          id="consultation-form-wrap"
          class="form-vertical p-6 md:p-12 shadow-lg rounded-lg bg-white target:ring-3"
          style="max-width:480px;margin:auto"
        >
          <h2 class=" text-2xl md:text-3xl font-semibold h2 mb-6 ">
            {{ section.settings['form-title'] }}
          </h2>
          {%- form 'contact', id: form_id, class: 'target:ring-3', data-shopify-captcha: 'true' -%}
            {%- if form.posted_successfully? -%}
              <p class="note note--success">
                {{ 'contact.form.post_success' | t }}
              </p>
            {%- endif -%}

            {{ form.errors | default_errors }}
            {% render 'gclid-field', form_id: form_id %}

            <div class="grid grid--small">
              <div class="grid__item">
                <input
                  type="text"
                  required
                  placeholder="Educational Facility"
                  class="input-full input"
                  name="contact[Educational_Facility]"
                  autocapitalize="words"
                  value=""
                >
                <label for="ContactFormName-{{ section.id }}">Educational Facility</label>
              </div>
              <div class="grid__item">
                <input
                  type="text"
                  required
                  placeholder="Full name"
                  class="input-full input"
                  name="contact[full_name]"
                  autocapitalize="words"
                  value=""
                >
                <label for="ContactFormName-{{ section.id }}">Full name</label>
              </div>
              <div class="grid__item">
                <input
                  class="input-full input"
                  autocomplete="email"
                  type="email"
                  required
                  id="ContactForm-email"
                  class="field__input"
                  name="contact[email]"
                  spellcheck="false"
                  autocapitalize="off"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"aria-describedby="ContactForm-email-error"
                  {% endif -%}
                  placeholder="{{ 'contact.form.email' | t }}"
                >
                <label for="ContactFormEmail-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
              </div>
              <div class="grid__item">
                <input
                  type="tel"
                  required
                  id="ContactFormPhone-{{ section.id }}"
                  class="input-full input"
                  name="contact[phone]"
                  placeholder="{{ 'contact.form.phone' | t }}"
                  pattern="[0-9\-]*"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                >
                <label for="ContactFormPhone-{{ section.id }}">{{ 'contact.form.phone' | t }}</label>
              </div>

              <div class="grid__item">
                <textarea
                  rows="5"
                  required
                  id="ContactFormMessage-{{ section.id }}"
                  class="input-full input"
                  placeholder="Potential Booths Interest In?"
                  name="contact[body]"
                  value="{%- if form.body -%}{{ form.body }}{%- endif -%}"
                ></textarea>
                <label for="ContactFormMessage-{{ section.id }}">{{ 'contact.form.message' | t }}</label>
              </div>
              <div class="submit-btn-wrap grid__item">
                <button
                  type="submit"
                  class="btn btn--full"
                  style="
                    width: 100%;
                    max-width: 40%;
                  "
                >
                  Send
                </button>
              </div>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  (() => {
    // SBS-335: this education consultation form now uses the same canonical
    // intake as every other migrated lead form (assets/sbs-lead-forms.js).
    //
    // Replaced in this migration:
    //   - the CORS opt-out on the old fetch, which silently downgraded the
    //     Content-Type to text/plain, made the response opaque and hid every
    //     intake failure from the theme;
    //   - the missing form_source, which forced the n8n normaliser to guess the
    //     origin from the payload shape and filed these leads as header-quote;
    //   - the ad-hoc gclid/consent assembly, now the shared canonical reader:
    //     one canonical gclid/gbraid/wbraid with no cross-population, the
    //     submit-time consent snapshot, UTM fields, landing page, referrer and
    //     page URL, plus a UUIDv4 transaction_id reused across retries;
    //   - console logging of the whole FormData, which printed the customer's
    //     name, email, phone number and message into the browser console;
    //   - the fixed 300 ms timer before the native Shopify submission, which
    //     raced the request and regularly aborted it. The native submission is
    //     what renders the Shopify success notice and delivers the enquiry, so
    //     it now runs once the canonical intake call has resolved, behind a
    //     watchdog so a stalled transport can never trap the customer.
    const sbsForm = document.getElementById('{{- form_id -}}');
    if (!sbsForm) return;

    const SBS_SCOPE = 'for-edu';
    let sbsNavigated = false;

    function sbsNativeSubmit() {
      if (sbsNavigated) return;
      sbsNavigated = true;
      sbsForm.submit();
    }

    // The form is captcha protected, so Shopify has to stamp it before the
    // native POST. The canonical intake therefore runs inside protect(), and
    // the flow still completes if the captcha helper is unavailable.
    function sbsWithCaptcha(next) {
      const captcha = window.Shopify && window.Shopify.captcha;
      if (captcha && typeof captcha.protect === 'function') {
        try {
          captcha.protect(sbsForm, next);
          return;
        } catch (err) {
          console.warn('[ForEduTop] captcha protect unavailable');
        }
      }
      next();
    }

    function sbsHandleSubmit(event) {
      event.preventDefault();

      // Watchdog: never trap the customer behind a disabled button if the
      // transport or the captcha stalls. n8n dedups on transaction_id, so a
      // late POST is safe.
      setTimeout(sbsNativeSubmit, 12000);

      // Pending state only. The label is left untouched so no untranslated
      // string can reach a localised storefront.
      const submitBtn = sbsForm.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-busy', 'true');
      }

      const sbsFormData = new FormData(event.target);

      sbsWithCaptcha(function () {
        try {
          if (!window.SBSLeadForms) {
            console.warn('[ForEduTop] SBSLeadForms unavailable - native submit only');
            sbsNativeSubmit();
            return;
          }
          // The educational facility is the enquiring organisation, so it is
          // sent as the canonical company field rather than left as an unmapped
          // passthrough. The hidden legacy click-id inputs rendered by
          // snippets/gclid-field.liquid stay in the DOM for the native Shopify
          // submission but never reach the JSON payload.
          const sbsFacility = sbsFormData.get('contact[Educational_Facility]') || '';
          const sbsBuilt = window.SBSLeadForms.buildPayload({
            formData: sbsFormData,
            formSource: 'for-edu',
            scope: SBS_SCOPE,
            extra: sbsFacility ? { 'contact[company]': sbsFacility } : {}
          });
          if (!sbsBuilt.ok) {
            console.warn('[ForEduTop] canonical payload rejected:', sbsBuilt.errors.join('; '));
            sbsNativeSubmit();
            return;
          }
          window.SBSLeadForms.submit(sbsBuilt.payload, { scope: SBS_SCOPE }).then(function (result) {
            if (result.status === 'success' || result.status === 'duplicate') {
              window.SBSLeadForms.resetTransaction(SBS_SCOPE);
            } else {
              console.warn('[ForEduTop] intake not confirmed:', result.status);
            }
            sbsNativeSubmit();
          });
        } catch (err) {
          console.error(err);
          sbsNativeSubmit();
        }
      });
    }

    sbsForm.addEventListener('submit', sbsHandleSubmit);
  })();
</script>
{% schema %}
{
  "name": "For Edu top",
  "settings": [
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Avatar"
    },
    {
      "type": "text",
      "id": "form-title",
      "label": "Form title",
      "default": "Find Out How Acoustic Booths Can Help Focus & Productivity"
    },
    {
      "type": "text",
      "id": "sub-heading-top",
      "label": "Sub Heading",
      "default": "Embracing Sustainability"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Embracing Sustainability"
    },
    {
      "type": "text",
      "id": "sub-heading-bottom",
      "label": "Sub Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>As a pioneer in crafting soundproof phone booths, office pods, and meeting rooms for businesses, we take pride in our unwavering commitment to eco-friendly manufacturing practices. Join us as we embark on a journey toward agreener future, one sustainable product at a time.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Free Design Survey "
    },
    {
      "type": "url",
      "id": "calendly_url",
      "label": "calendly url"
    }
  ],
  "presets": [
    {
      "name": "For Edu top",
      "blocks": []
    }
  ]
}
{% endschema %}
