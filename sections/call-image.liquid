<style>
      .{{ section.id }}-wrap{
    position:relative;
        z-index:5;
      }
    .template-index .{{ section.id }}-wrap a{
  width:min(500px,40vw);
  height: min(500px,40vw);

  }
    .template-index .{{ section.id }}-wrap img{
      opacity:1;
  width:min(500px,40vw);

  }
   .{{ section.id }}-wrap:hover img{
      opacity:1;

  }
       .{{ section.id }}-wrap a{
    position:absolute;z-index:2;right:0;width:min(300px,40vw);
         height:min(200px,40vw);

  clip-path: polygon(10% 0, 100% 0, 100% 90%);

      }

   .{{ section.id }}-wrap img{
          opacity:0.8;
    position: absolute;
       width:min(200px,40vw);
     pointer-events: none;
                transition: transform 0.2s ease-in-out;
    transform-origin: right top;
    right: 0;
     top:0
      }
           .{{ section.id }}-wrap:has(a:hover) img{

           transform :scale(1.1)
      }
</style>
{% if section.settings.call_banner %}
  <div class="{{ section.id }}-wrap">
    {{ section.settings.call_banner | image_url: width: 700 | image_tag }}
    <a
      target="_blank"
      href="{{ section.settings.url }}"
    >
    </a>
  </div>
{% endif %}

{% schema %}
{
  "name": "call image",
  "settings": [
    {
      "type": "image_picker",
       "id": "call_banner",
      "label": "Call Image",
    },
     {
      "type": "url",
       "id": "url",
      "label": "Url",
       "default":"/"
    }
  ],

}
{% endschema %}
