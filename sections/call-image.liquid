<style>
    .{{ section.id }}-wrap{
  position:relative;
      z-index:5;
    }
     .{{ section.id }}-wrap a{
  position:absolute;z-index:2;right:0;width:min(500px,25vw)
    }
</style>
{% if section.settings.call_banner %}
  <div class="{{ section.id }}-wrap" style="display:none;">
    <a
      target="_blank"
      href="{{ section.settings.url }}"
    >
      {{ section.settings.call_banner | image_url: width: 500 | image_tag }}
    </a>
  </div>
{% endif %}
{% schema %}
{
  "name": "call image",
  "class": "hidden",
  "settings": [
    {
      "type": "image_picker",
       "id": "call_banner",
      "label": "Call Image",
    },
     {
      "type": "text",
       "id": "url",
      "label": "Url",
       "default":"https://uk.bettshow.com/exhibitors/soundbox-store"
    }
  ],

}
{% endschema %}
