<style>
      .{{ section.id }}-wrap{
    position:relative;
        z-index:5;
      }
    .template-index .{{ section.id }}-wrap a,.template-collection .{{ section.id }}-wrap a{
  width:min(350px,40vw);
  height: min(350px,40vw);

  }

    .template-collection .{{ section.id }}-wrap img, .template-index .{{ section.id }}-wrap img{
  width:min(350px,40vw);

  }
  .template-product .{{ section.id }}-wrap , .template-collection .{{ section.id }}-wrap{
  display:none

  }
       .{{ section.id }}-wrap a{
    position:absolute;z-index:2;right:0;width:min(300px,40vw);
         height:min(300px,40vw);

  clip-path: polygon(10% 0, 100% 0, 100% 90%);

      }

   .{{ section.id }}-wrap img{
    position: absolute;
       width:min(300px,40vw);
     pointer-events: none;
                transition: transform 0.2s ease-in-out;
    transform-origin: right top;
    right: 0;
     top:0
      }
           .{{ section.id }}-wrap:has(a:hover) img{

           transform :scale(1.1)
      }
</style>
{% case localization.language.iso_code %}
  {% when 'de' %}
    {% assign image = section.settings.call_banner_de %}
  {% when 'fi' %}
    {% assign image = section.settings.call_banner_fi %}
  {% when 'sv' %}
    {% assign image = section.settings.call_banner_sv %}
  {% when 'no' %}
    {% assign image = section.settings.call_banner_no %}
  {% when 'fr' %}
    {% assign image = section.settings.call_banner_fr %}
  {% when 'es' %}
    {% assign image = section.settings.call_banner_es %}
  {% when 'da' %}
    {% assign image = section.settings.call_banner_da %}
  {% when 'nl' %}
    {% assign image = section.settings.call_banner_nl %}
  {% when 'it' %}
    {% assign image = section.settings.call_banner_it %}
  {% when 'pl' %}
    {% assign image = section.settings.call_banner_po %}
  {% else %}
    {% assign image = section.settings.call_banner_en %}
{% endcase %}
{% if localization.country.iso_code == 'GB' %}
  {% assign page = settings.page_showroom %}
{% else %}
  {% assign page = settings.page_remote_tour %}
{% endif %}
<script>
  console.log({{ image | json }},"===", {{ localization.language.iso_code | json }});
</script>
{% if image %}
  <div class="{{ section.id }}-wrap">
    {{ image | image_url: width: 400 | image_tag: sizes: '(min-width:1024px) 400px, 30vw' }}
    <a
      target="_blank"
      href="{{ page.url }}"
    >
    </a>
  </div>
{% endif %}

