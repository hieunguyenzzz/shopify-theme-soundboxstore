<style>
      .{{ section.id }}-wrap{
    position:relative;
        z-index:5;
      }
    .template-index .{{ section.id }}-wrap a{
  width:min(500px,40vw);
      }
       .{{ section.id }}-wrap a{
    position:absolute;z-index:2;right:0;width:min(300px,40vw);
           transition: transform 0.2s ease-in-out;
    transform-origin: right top;
      }
         .{{ section.id }}-wrap a:hover{

           transform :scale(1.1)
      }
</style>
{% if section.settings.call_banner %}
  <div class="{{ section.id }}-wrap">
    <a
      target="_blank"
      href="{{ section.settings.url }}"
    >
      {{ section.settings.call_banner | image_url: width: 500 | image_tag }}
    </a>
  </div>
{% endif %}
{% schema %}
{
  "name": "call image",
  "settings": [
    {
      "type": "image_picker",
       "id": "call_banner",
      "label": "Call Image",
    },
     {
      "type": "text",
       "id": "url",
      "label": "Url",
       "default":"https://uk.bettshow.com/exhibitors/soundbox-store"
    }
  ],

}
{% endschema %}
