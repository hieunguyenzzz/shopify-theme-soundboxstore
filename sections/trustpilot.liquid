{% schema %}
{
  "name": "trustpilot",
  "class": "custome-blocks",
  "settings": [
    {
      "type": "text",
      "id": "rate",
      "label": "Rate",
      "default": "4.6"
    },
    {
      "type": "text",
      "id": "reviews_number",
      "label": "Reviews number",
      "default": "62"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "review",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Purchased 2 Meeting Booths"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Eva in the Showroom was fantastic and explained all about the Booths I was looking for.After only 1 visit, I placed an order for two 4-person meeting booths, complete with seating, table and monitor....one green, one orange !They looked great after installation.....and now getting used daily.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "author",
          "default": "Andy Skeet"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "trustpilot",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author": "Andy Skeet",
            "heading": "Purchased 2 Meeting Booths",
            "content": "<p>Eva in the Showroom was fantastic and explained all about the Booths I was looking for.After only 1 visit, I placed an order for two 4-person meeting booths, complete with seating, table and monitor....one green, one orange !They looked great after installation.....and now getting used daily.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
