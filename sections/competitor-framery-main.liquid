<style>
  html { scroll-behavior: smooth; }
  .comp-page { font-family: inherit; }

  /* ---- Hero ---- */
  .comp-hero { background: #f7f8f6; }
  .comp-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 340px;
  }
  .comp-hero-text {
    padding: 3rem 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .comp-hero-heading {
    font-size: clamp(1.6rem, 2.8vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1rem;
    color: #1a1a1a;
  }
  .comp-hero-sub { color: #555; line-height: 1.6; margin: 0 0 1.5rem; font-size: 0.95rem; }
  .comp-hero-btns { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem; }
  .comp-btn-dark {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    background: #2d2d2d;
    color: #fff !important;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: background 0.2s;
  }
  .comp-btn-dark:hover { background: #111; color: #fff !important; }
  .comp-btn-outline {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border: 2px solid #2d2d2d;
    color: #2d2d2d !important;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    background: transparent;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: background 0.2s, color 0.2s;
  }
  .comp-btn-outline:hover { background: #2d2d2d; color: #fff !important; }
  .comp-delivery-row {
    display: flex; align-items: center; gap: 0.4rem;
    font-size: 0.85rem; color: #555; margin: 0 0 0.75rem;
  }
  .comp-delivery-row svg { flex-shrink: 0; color: #5c6b3a; }
  .comp-cert-logos { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.5rem; }
  .comp-cert-logo {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border: 2px solid #aaa; border-radius: 50%;
    font-size: 0.6rem; font-weight: 700; color: #555; text-align: center; line-height: 1.1;
  }
  .comp-hero-image { overflow: hidden; background: #e8ede0; }
  .comp-hero-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ---- Why Choose ---- */
  .comp-why { background: #fff; padding: 4rem 0; }
  .comp-why-heading {
    font-size: clamp(1.5rem, 2.8vw, 2.2rem); font-weight: 800;
    text-align: center; margin: 0 0 0.75rem; color: #1a1a1a;
  }
  .comp-why-sub {
    text-align: center; color: #555; max-width: 640px;
    margin: 0 auto 3rem; font-size: 0.95rem; line-height: 1.65;
  }
  .comp-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .comp-why-card { background: #f7f8f5; border-radius: 8px; padding: 1.75rem 1.5rem; }
  .comp-why-title { font-weight: 700; font-size: 1rem; margin: 0 0 0.6rem; color: #1a1a1a; }
  .comp-why-body { color: #555; font-size: 0.9rem; line-height: 1.65; margin: 0; }
  .comp-why-body strong { color: #5c6b3a; font-weight: 600; }

  /* ---- Comparison table ---- */
  .comp-table-section { background: #f4f4f2; padding: 4rem 0; }
  .comp-table-heading {
    font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800;
    text-align: center; margin: 0 0 2rem; color: #1a1a1a;
  }
  .comp-table-wrap { overflow-x: auto; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
  .comp-table { border-collapse: collapse; width: 100%; font-size: clamp(13px, 1.6vw, 14px); background: #fff; }
  .comp-table th, .comp-table td { padding: 0.8em 1.2em; text-align: left; border-bottom: 1px solid #e8e8e8; }
  .comp-table thead th { background: #e2e2e2; font-weight: 700; font-size: 1em; }
  .comp-table thead th:nth-child(2) { background: #5c6b3a; color: #fff; }
  .comp-table tbody tr:nth-child(even) td { background: #f9f9f9; }
  .comp-table .feat-col { font-weight: 600; color: #222; min-width: 11em; }
  .comp-table .hl { background: #5c6b3a !important; color: #fff !important; font-weight: 600; }
  .comp-table tbody td:last-child { color: #555; }
  .comp-table-footnote { font-size: 0.82rem; color: #888; margin-top: 1rem; font-style: italic; }

  /* ---- Mid CTA ---- */
  .comp-mid-cta { background: #fff; padding: 3rem 0 2.5rem; text-align: center; }
  .comp-mid-cta h2 { font-size: clamp(1.2rem, 2.2vw, 1.6rem); font-weight: 800; margin: 0 0 0.6rem; color: #1a1a1a; }
  .comp-mid-cta p { color: #555; font-size: 0.95rem; max-width: 560px; margin: 0 auto; line-height: 1.6; }
  .comp-mid-cta a { color: #5c6b3a; font-weight: 600; text-decoration: underline; }

  /* ---- Testimonials ---- */
  .comp-test-section { background: #f0f4f0; padding: 4rem 0; }
  .comp-test-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: start; }
  .comp-test-left-heading { font-size: clamp(1.3rem, 2.5vw, 1.9rem); font-weight: 800; margin: 0 0 0.6rem; line-height: 1.25; color: #1a1a1a; }
  .comp-test-left-sub { color: #555; margin: 0 0 2rem; font-size: 0.95rem; }
  .comp-test-nav { display: flex; align-items: center; gap: 0.75rem; }
  .comp-test-nav-btn {
    width: 36px; height: 36px;
    border: 2px solid #5c6b3a; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; background: white; color: #5c6b3a;
    transition: background 0.2s, color 0.2s; flex-shrink: 0;
  }
  .comp-test-nav-btn:hover { background: #5c6b3a; color: #fff; }
  .comp-test-dots { display: flex; gap: 6px; align-items: center; }
  .comp-test-dot { width: 8px; height: 8px; border-radius: 50%; background: #ccc; cursor: pointer; }
  .comp-test-dot.active { background: #5c6b3a; }
  .comp-test-card { display: none; }
  .comp-test-card.active { display: block; }
  .comp-test-card-inner { background: #fff; border-radius: 8px; padding: 2rem; box-shadow: 0 1px 8px rgba(0,0,0,0.07); }
  .comp-test-stars { color: #f5a623; font-size: 1.2em; letter-spacing: 1px; margin-bottom: 0.75rem; }
  .comp-test-text { color: #333; font-size: 0.95rem; line-height: 1.7; margin: 0 0 1rem; }
  .comp-test-author { font-weight: 700; color: #1a1a1a; margin: 0; font-size: 0.9rem; }

  /* ---- Layout ---- */
  .comp-pw { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

  @media (max-width: 900px) {
    .comp-hero-inner { grid-template-columns: 1fr; }
    .comp-hero-image { min-height: 260px; }
    .comp-why-grid { grid-template-columns: 1fr 1fr; }
    .comp-test-layout { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .comp-hero-text { padding: 2rem 1.25rem; }
    .comp-why-grid { grid-template-columns: 1fr; }
    .comp-table thead th:nth-child(3) { display: none; }
    .comp-table tbody td:last-child { display: none; }
  }
</style>

<div class="comp-page">

  <!-- Hero -->
  <section class="comp-hero">
    <div class="comp-hero-inner">
      <div class="comp-hero-text">
        <h1 class="comp-hero-heading">The Premium Alternative to Framery Office Pods</h1>
        <p class="comp-hero-sub">Why wait months for privacy? Get elite 30dB+ sound isolation and ISO-certified quality with a smaller carbon footprint and immediate stock availability.</p>
        <div class="comp-hero-btns">
          <a href="/pages/remote-tour" class="comp-btn-dark">Remote Tour</a>
          <a href="/pages/free-design-survey" class="comp-btn-outline">Free Design Survey</a>
        </div>
        <p class="comp-delivery-row">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          Delivered in as little as 2 weeks
        </p>
        <div class="comp-cert-logos">
          <span class="comp-cert-logo" title="UL Certified">UL</span>
          <span class="comp-cert-logo" title="CE Marked">CE</span>
          <span class="comp-cert-logo" title="ISO Certified">ISO</span>
        </div>
      </div>
      <div class="comp-hero-image">
        <img src="https://cdn.shopify.com/s/files/1/0642/6572/1633/files/quell-flex-pod-office.jpg" alt="Quell Flex acoustic office pod" loading="eager" onerror="this.style.display='none'">
      </div>
    </div>
  </section>

  <!-- Why Professionals Choose -->
  <section class="comp-why">
    <div class="comp-pw">
      <h2 class="comp-why-heading">Why Professionals Choose<br>Soundbox Store over Framery</h2>
      <p class="comp-why-sub">Soundbox Store supplies high-performance acoustic office solutions across the UK, helping businesses create quieter, more productive workspaces with transparent pricing, fast delivery and dependable support.</p>
      <div class="comp-why-grid">
        <div class="comp-why-card">
          <h3 class="comp-why-title">Practical Acoustic Expertise</h3>
          <p class="comp-why-body">We specialise in soundproof office pods and acoustic workspaces built for real-world office environments, delivering <strong>proven performance for focused work, private calls and confidential conversations.</strong></p>
        </div>
        <div class="comp-why-card">
          <h3 class="comp-why-title">Transparent, Upfront Pricing</h3>
          <p class="comp-why-body">Clear starting prices are shown online, with no hidden subscription platforms required. What you see is what you budget for, simplifying procurement and financial planning.</p>
        </div>
        <div class="comp-why-card">
          <h3 class="comp-why-title">Fast UK Delivery</h3>
          <p class="comp-why-body">We prioritise efficient UK logistics and reliable lead times, helping businesses install acoustic solutions quickly and keep workplace projects on schedule.</p>
        </div>
        <div class="comp-why-card">
          <h3 class="comp-why-title">Designed for Modern Work</h3>
          <p class="comp-why-body">Our solutions support hybrid teams, video calls and open-plan offices, creating dedicated spaces for focus and productivity within evolving workplaces.</p>
        </div>
        <div class="comp-why-card">
          <h3 class="comp-why-title">Durable, Responsible Materials</h3>
          <p class="comp-why-body">We select robust construction materials and recycled acoustic components, ensuring long-lasting performance while supporting more responsible workplace design choices.</p>
        </div>
        <div class="comp-why-card">
          <h3 class="comp-why-title">Knowledgeable UK Support</h3>
          <p class="comp-why-body">Our experienced team offers clear guidance from enquiry to installation, providing dependable advice and responsive customer support throughout your project.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="comp-table-section">
    <div class="comp-pw">
      <h2 class="comp-table-heading">Soundbox Store vs Framery Pods</h2>
      <div class="comp-table-wrap">
        <table class="comp-table">
          <thead>
            <tr>
              <th class="feat-col"></th>
              <th>Quell Flex</th>
              <th>Framery One</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="feat-col">Starting Price</td><td class="hl">From £6,270</td><td>From £8,090</td></tr>
            <tr><td class="feat-col">Typical Delivery Time*</td><td class="hl">From 2–4 weeks</td><td>From 6–8 weeks</td></tr>
            <tr><td class="feat-col">Soundproofing Standard</td><td>ISO 23351-1</td><td>ISO 23351-1</td></tr>
            <tr><td class="feat-col">Speech Reduction</td><td class="hl">30 dB (STC ±5 dB)</td><td>30 dB (DS,A Class A)</td></tr>
            <tr><td class="feat-col">Dimensions</td><td class="hl">230 × 100 × 93.6 cm</td><td>225.5 × 122 × 100 cm</td></tr>
            <tr><td class="feat-col">Pod Weight</td><td class="hl">275 kg</td><td>357 kg</td></tr>
            <tr><td class="feat-col">Adjustable Desk</td><td>Yes</td><td>Yes</td></tr>
            <tr><td class="feat-col">Airflow</td><td class="hl">184 m³/h (max)</td><td>94 m³/h (default)</td></tr>
            <tr><td class="feat-col">Air Refresh Rate</td><td>Every minute</td><td>Every minute</td></tr>
            <tr><td class="feat-col">Power Outlets</td><td class="hl">Multiple outlets</td><td>1 x Power outlet</td></tr>
            <tr><td class="feat-col">USB Charging</td><td class="hl">USB + USB-C</td><td>1 × USB-C (15W)</td></tr>
            <tr><td class="feat-col">Connectivity</td><td class="hl">Built-in internal + external ethernet</td><td>Optional LAN port, built-in 4G Smart System</td></tr>
            <tr><td class="feat-col">Sustainability</td><td class="hl">Embodied carbon model available</td><td>EPDs and sustainability reports published</td></tr>
          </tbody>
        </table>
      </div>
      <p class="comp-table-footnote">*Delivery times based on publicly available guidance and may vary by configuration and region.</p>
    </div>
  </section>

  <!-- Mid CTA -->
  <section class="comp-mid-cta">
    <div class="comp-pw">
      <h2>We could make this list much longer!</h2>
      <p>Go to our <a href="/products/quell-flex-office-pod">Quell Flex Office Pod page</a> to see even more features available, for our own personal comparison with Framery soundproof pods</p>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="comp-test-section">
    <div class="comp-pw">
      <div class="comp-test-layout">
        <div>
          <h2 class="comp-test-left-heading">Consider Soundbox Store over Framery Pods and see the difference</h2>
          <p class="comp-test-left-sub">Lower price, quicker delivery, happy customers!</p>
          <div class="comp-test-nav">
            <button class="comp-test-nav-btn" id="cf-prev" aria-label="Previous">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <div class="comp-test-dots" id="cf-dots">
              <div class="comp-test-dot active" data-idx="0"></div>
              <div class="comp-test-dot" data-idx="1"></div>
            </div>
            <button class="comp-test-nav-btn" id="cf-next" aria-label="Next">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
        <div id="cf-cards">
          <div class="comp-test-card active" data-idx="0">
            <div class="comp-test-card-inner">
              <div class="comp-test-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <p class="comp-test-text">Ordered some PODs as a first time customer - kept up to date every step of the way, will defo use again - Very quick turn around.</p>
              <p class="comp-test-author">Tom Rae</p>
            </div>
          </div>
          <div class="comp-test-card" data-idx="1">
            <div class="comp-test-card-inner">
              <div class="comp-test-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <p class="comp-test-text">Simple and straightforward, quick turnaround of queries, delivery</p>
              <p class="comp-test-author">Andrew Garwood Watkin</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>

<script>
(function() {
  var cards = document.querySelectorAll('#cf-cards .comp-test-card');
  var dots = document.querySelectorAll('#cf-dots .comp-test-dot');
  var prevBtn = document.getElementById('cf-prev');
  var nextBtn = document.getElementById('cf-next');
  var current = 0;
  function goTo(idx) {
    cards[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = (idx + cards.length) % cards.length;
    cards[current].classList.add('active');
    dots[current].classList.add('active');
  }
  if (prevBtn) prevBtn.addEventListener('click', function() { goTo(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function() { goTo(current + 1); });
  dots.forEach(function(d) { d.addEventListener('click', function() { goTo(parseInt(d.dataset.idx)); }); });
})();
</script>


