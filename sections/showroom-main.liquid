<script src="https://cdn.tailwindcss.com?plugins=typography,forms"></script>
<style type="text/tailwindcss">
  @layer base {
    h2 {
      font-size: calc(var(--typeHeaderSize) * 0.85);
    }
  }
</style>
<style>
  #google_embed_url iframe{
    transform: translateX(-35%)!important;border: 0px;
    width:100%;
    height:100%;
  }
</style>
<div class="relative min-h-[600px] bg-[#e9f0f0]">
  <div class="absolute hidden md:block right-0 top-0 h-full  max-w-[60%] overflow-hidden">
    <div id="google_embed_url" class="h-full w-[200vw] transform -translate-x-3/5 min-w-[200vw] ">
      {{ section.settings.google_embed_url }}
    </div>
  </div>
  <div
    class="absolute hidden md:block max-w-[60%] right-0 top-0 h-full -z-5 bg-gradient-to-l w-full from-transparent via-white/10 to-[#e9f0f0]"
  ></div>
  <div class="relative flex min-h-[600px] items-center justify-start page-width">
    <div class="md:mr-8 w-full md:max-w-[50%] ">
      <div class="p-6 lg:p-12 mb-6  rounded-lg md:p-12 md:max-w-[52ch] lg:min-h-[70%] lg:flex flex flex-col justify-center relative ">
        <div class="x-col e1952-e3 m1i8-17">
          <a
            href="{{pages['showrooms'].url}}#shopify-section-template--20062847107297__showrooms_map_36cTG3"
            class="flex gap-2 mb-4 items-center text-[0.9em]"
          >
            <svg
              class="text-[1.2em]"
              stroke="currentColor"
              fill="currentColor"
              stroke-width="0"
              viewBox="0 0 512 512"
              height="1em"
              width="1em"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="48" d="M244 400 100 256l144-144M120 256h292"></path>
            </svg>
            <span>All Showrooms</span>
          </a>
        </div>

        <div class="p-3 md:p-6 bg-white space-y-6">
          <div class="flex gap-4 md:gap-8 ">
            {% if section.settings.avatar != blank %}
              {{ section.settings.avatar | image_url: width: 500 | image_tag: class: 'max-w-[300px] w-1/3 rounded-lg' }}
            {% endif %}
            <div
              style="
                display: flex;
                flex-direction: column;
                justify-content: center;
              "
              class=" "
            >
              <p class="opacity-70">{{ section.settings['sub-heading-top'] }}</p>
              <div class="text-2xl md:text-4xl font-semibold h2 m-0">{{ section.settings.heading }}</div>
              <p class="opacity-70">{{ section.settings['sub-heading-bottom'] }}</p>
            </div>
          </div>
          <h1 class="text-2xl font-semibold">
            {{ section.settings.title | default: page.title }}
          </h1>
          <div class=" prose prose-a:underline text-sm">
            {{ section.settings.content }}
          </div>
          <label
            for="consultation-form-wrap-check"
            class="btn mt-6  bg-[var(--colorBtnPrimary)]"
            style="width: 100%;"
            {% comment %} href="#consultation-form-wrap" {% endcomment %}
          >
            {{- section.settings.btn_text | default: 'Book a visit ' -}}
          </label>
        </div>
      </div>
    </div>
  </div>
</div>
<input type="checkbox" class="peer hidden" hidden id="consultation-form-wrap-check">
<div class="min-h-screen flex justify-center items-center fixed inset-0 w-full h-full -z-10 peer-checked:z-10 bg-grey/30">
  <div
    style="
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background: #ffffff8a;
      backdrop-filter: blur(10px);
    "
  ></div>
  <label
    for="consultation-form-wrap-check"
    class=" btn btn--secondary text-label z-20"
    style="white-space: nowrap;display: flex;gap: 1em;align-items: center;padding: 11px 1em;padding-right: 1em;border-width:2px;min-width: unset;position: absolute;right: 20px;top: 20px;"
  >
    <svg
      stroke="currentColor"
      fill="currentColor"
      stroke-width="0"
      viewBox="0 0 24 24"
      height="1em"
      width="1em"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path fill="none" stroke="#000" stroke-width="2" d="M3,3 L21,21 M3,21 L21,3"></path>
    </svg>
  </label>
  <div
    id="consultation-form-wrap"
    class="form-vertical  relative "
    style="
      max-width: 100%;width:100%;
      margin: auto;
      border: 2px solid
      padding: 2px;
    "
  >
    <!-- Calendly inline widget begin -->
    <div
      class="calendly-inline-widget "
      data-url="{{  section.settings.calendly_url | default :'https://calendly.com/james-low-wyy/consultancy'  }}?hide_gdpr_banner=1"
      style="min-width:320px;height:100vh;"
    ></div>
    <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
    <!-- Calendly inline widget end -->
  </div>
</div>

<style>
  .collection-products {
      list-style: none;
      margin: 0;
      display: grid;
      gap: 1em;
          --image-bg: #e9f0f0;
  }

  @media screen and (min-width: 979px) {
   .collection-products {
            grid-template-columns: 1fr 1fr;
    }

  }
  .collection-products li {
      position: relative;
  }

  .collection-products li:before {
      content: ''
  }

  .collection-product-item {
      gap: 0;
      /* flex-direction: column; */
      align-items: center;
      /* padding: 1em 0; */
      font-size: 0.9em;
      display: flex;
      background: var(--image-bg);
      border-radius: 1em;
  }

  .collection-product-item .image {
      /* background:var(--image-bg); */
      aspect-ratio: 1 / 1;
      position: relative;
      /* padding-bottom: 100%; */
      display: block;
  }

  .collection-product-item .image img {
      position: absolute;
      padding: 1px;
      top: 0;
      left: 0;
      width: 100%;
      border-radius: 1em;
      height: 100%;
  }

  .collection-product-item .image {
      border-radius: 1em;
      min-width: 50%;
      width: 50%;
      max-width: min(500px, 50%);
      flex-shrink: 0;
  }

  .collection-product-item .collection-btn-group {
      justify-content: center;
      margin-top: 1em;
  }

  .collection-products .image img:not(:first-child) {
      opacity: 0
  }

  .collection-products .collection-product-item h3 {
      margin: 0;
      font-size: min(1.4em, 4vw);
      text-transform: uppercase;
      font-weight: 500
  }

  .collection-products .collection-product-item:hover .image img {
      filter: drop-shadow(0px 4px 16px rgba(0, 0, 0, 0.00)) drop-shadow(0px 3.28515px 5.84026px rgba(0, 0, 0, 0.0827978)) drop-shadow(0px 1.59488px 2.83534px rgba(0, 0, 0, 0.0667549))
  }

  .collection-products .collection-product-item .subtitle {
      opacity: 0.4
  }

  .collection-products .collection-product-item .image.had_image_2 img:not(:first-child) {
      opacity: 0
  }

  .collection-products .collection-product-item:hover .image.had_image_2 img:not(:first-child) {
      opacity: 1
  }

  .collection-products .collection-product-item:hover .image.had_image_2 img:first-child {
      opacity: 0
  }

  .collection-products .collection-product-item .itemprice {
      font-size: 1.2em;
      text-transform: capitalize;
  }

  .collection-products .collection-product-item .compare_at_price {
      opacity: 0.4;
      font-size: 0.8em;
      text-decoration: line-through;
  }

  .collection-products .collection-product-item .seats img {
      height: 1.4em;
      width: auto;
  }
</style>
{% assign products = section.settings.products %}

<section style="margin:1em auto" class=" page-width ">
  <h1 class="text-2xl font-semibold  md:text-2xl 2xl:text-4xl my-6 mt-12">Products Available at the Showroom</h1>
  <ul class="collection-products">
    {% for product in products %}
      <li>
        {% render '[product-item]', product: product %}
      </li>
    {% endfor %}
  </ul>
</section>
{% schema %}
{
  "name": "Show Room main",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Find Out How Acoustic Booths Can Help Focus & Productivity"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products"
    },
    {
      "type": "url",
      "id": "calendly_url",
      "label": "calendly url"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Avatar"
    },
    {
      "type": "text",
      "id": "form-title",
      "label": "Form title",
      "default": "Find Out How Acoustic Booths Can Help Focus & Productivity"
    },
    {
      "type": "text",
      "id": "sub-heading-top",
      "label": "Sub Heading",
      "default": "Embracing Sustainability"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Embracing Sustainability"
    },
    {
      "type": "text",
      "id": "google_embed_url",
      "label": "Google embed url"
    },
    {
      "type": "text",
      "id": "sub-heading-bottom",
      "label": "Sub Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>As a pioneer in crafting soundproof phone booths, office pods, and meeting rooms for businesses, we take pride in our unwavering commitment to eco-friendly manufacturing practices. Join us as we embark on a journey toward agreener future, one sustainable product at a time.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],

  "presets": [
    {
      "name": "Show room main"
    }
  ]
}
{% endschema %}
