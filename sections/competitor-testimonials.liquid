<script src="https://cdn.tailwindcss.com?plugins=typography,forms"></script>
<style>
  .competitor-testimonials-section { background: #f0f4f0; }
  .testimonial-stars { color: #f5a623; letter-spacing: 2px; font-size: 1.25em; }
  .testimonial-card { display: none; }
  .testimonial-card.active { display: block; }
  .testimonial-nav-btn {
    width: 40px; height: 40px;
    border: 2px solid #5c6b3a;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    background: white;
    color: #5c6b3a;
    transition: background 0.2s, color 0.2s;
    flex-shrink: 0;
  }
  .testimonial-nav-btn:hover { background: #5c6b3a; color: white; }
  .testimonial-dots { display: flex; gap: 6px; align-items: center; }
  .testimonial-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #ccc; cursor: pointer; transition: background 0.2s;
  }
  .testimonial-dot.active { background: #5c6b3a; }
</style>

<section class="competitor-testimonials-section py-12 md:py-16" id="competitor-testimonials-{{ section.id }}">
  <div class="page-width">
    <div class="md:flex gap-12 items-start">

      {%- comment -%} Left panel — heading + navigation {%- endcomment -%}
      <div class="md:w-2/5 mb-10 md:mb-0 flex flex-col justify-between md:sticky md:top-24">
        {%- if section.settings.left_heading != blank -%}
          <h2 class="text-2xl md:text-4xl font-bold mb-4 leading-tight">
            {{ section.settings.left_heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.left_subtext != blank -%}
          <p class="text-gray-600 mb-8">{{ section.settings.left_subtext }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 1 -%}
          <div class="flex items-center gap-4 mt-auto">
            <button class="testimonial-nav-btn" id="testimonial-prev-{{ section.id }}" aria-label="Previous">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <div class="testimonial-dots" id="testimonial-dots-{{ section.id }}">
              {%- for block in section.blocks -%}
                <div
                  class="testimonial-dot{% if forloop.first %} active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                ></div>
              {%- endfor -%}
            </div>
            <button class="testimonial-nav-btn" id="testimonial-next-{{ section.id }}" aria-label="Next">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right panel — testimonial cards {%- endcomment -%}
      <div class="md:w-3/5 relative" id="testimonial-cards-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- assign star_count = block.settings.stars | default: 5 -%}
          <div
            class="testimonial-card bg-white rounded-xl p-8 shadow-sm{% if forloop.first %} active{% endif %}"
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <div class="testimonial-stars mb-4">
              {%- for i in (1..star_count) -%}★{%- endfor -%}
            </div>
            {%- if block.settings.text != blank -%}
              <div class="prose text-gray-800 text-lg mb-6">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.author != blank -%}
              <p class="font-semibold text-gray-900 m-0">— {{ block.settings.author }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var cards = document.querySelectorAll('#testimonial-cards-' + sectionId + ' .testimonial-card');
  var dots = document.querySelectorAll('#testimonial-dots-' + sectionId + ' .testimonial-dot');
  var prevBtn = document.getElementById('testimonial-prev-' + sectionId);
  var nextBtn = document.getElementById('testimonial-next-' + sectionId);
  if (!cards.length) return;

  var current = 0;

  function goTo(idx) {
    cards[current].classList.remove('active');
    if (dots[current]) dots[current].classList.remove('active');
    current = (idx + cards.length) % cards.length;
    cards[current].classList.add('active');
    if (dots[current]) dots[current].classList.add('active');
  }

  if (prevBtn) prevBtn.addEventListener('click', function() { goTo(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function() { goTo(current + 1); });
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() { goTo(parseInt(dot.getAttribute('data-index'))); });
  });
})();
</script>

{% schema %}
{
  "name": "Competitor Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "left_heading",
      "label": "Left Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "left_subtext",
      "label": "Left Subtext",
      "default": "Real reviews from real customers who switched to Soundbox Store."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Review Text",
          "default": "<p>An excellent product that has transformed our office. The acoustic performance is outstanding and delivery was incredibly fast.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Happy Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Competitor Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "text": "<p>We compared Soundbox Store directly with Framery and the difference in value was staggering. Same acoustic performance, delivered in 3 weeks, at nearly half the price. Couldn't recommend more highly.</p>",
            "author": "Tom Rae, Facilities Manager"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "text": "<p>After a long search for acoustic pods that didn't break the budget, we found Soundbox Store. The pods look stunning, the team was incredibly helpful, and they arrived faster than any competitor could promise.</p>",
            "author": "Andrew Garwood Watkin, Office Manager"
          }
        }
      ]
    }
  ]
}
{% endschema %}
